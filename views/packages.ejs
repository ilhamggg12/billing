<%- include('partials/header', { title: 'Paket Internet', activePage: 'packages' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Paket Internet</h4>
        <p class="text-muted mb-0">Kelola paket layanan internet</p>
    </div>
    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#packageModal" onclick="openCreateModal()">
        <i class="fas fa-plus me-2"></i>Tambah Paket
    </button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-3 p-md-4">
        <table class="table table-hover align-middle datatable w-100" id="packagesTable" style="width: 100%;">
            <thead class="table-light">
                <tr>
                    <th width="40" class="text-center">No</th>
                    <th>Nama Paket</th>
                    <th width="140">Download</th>
                    <th width="140">Upload</th>
                    <th width="140">Harga</th>
                    <th width="100" class="text-center">Status</th>
                    <th width="120" class="text-center">Aksi</th>
                </tr>
            </thead>
                <tbody>
                    <% if (packages && packages.length > 0) { %>
                        <% packages.forEach(function(pkg, index) { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-primary bg-opacity-10 rounded-circle me-2 d-flex align-items-center justify-content-center">
                                        <i class="fas fa-box text-primary"></i>
                                    </div>
                                    <div>
                                        <span class="fw-semibold"><%= pkg.name %></span>
                                        <% if (pkg.is_bypass === 1) { %>
                                            <span class="badge bg-dark text-warning border border-warning ms-1" style="font-size: 0.72rem;">
                                                <i class="fas fa-shield-halved me-1"></i>Bypass / Bebas Tagihan
                                            </span>
                                        <% } %>
                                        <% if (pkg.no_wa_billing === 1 || /exiting|existing|pararel|paralel/i.test(pkg.name || '')) { %>
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info ms-1" style="font-size: 0.72rem;" title="Bisa Terisolir, Tanpa Informasi Tagihan WhatsApp" data-bs-toggle="tooltip">
                                                <i class="fas fa-bell-slash me-1"></i>Paralel (Bebas WA Tagihan)
                                            </span>
                                        <% } %>
                                        <% if (pkg.description) { %>
                                        <br><small class="text-muted"><%= pkg.description %></small>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info">
                                    <i class="fas fa-arrow-down me-1"></i><%= pkg.speed_down %> Mbps
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success">
                                    <i class="fas fa-arrow-up me-1"></i><%= pkg.speed_up %> Mbps
                                </span>
                            </td>
                            <td>
                                <% if (pkg.is_bypass === 1) { %>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1">
                                        <i class="fas fa-gift me-1"></i>GRATIS (Rp 0)
                                    </span>
                                <% } else { %>
                                    <span class="fw-semibold">Rp <%= Number(pkg.price).toLocaleString('id-ID') %></span>
                                <% } %>
                            </td>
                            <td>
                                <% if (pkg.is_active !== 0) { %>
                                    <span class="badge bg-success">Aktif</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Nonaktif</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-primary btn-edit-package"
                                            data-id="<%= pkg.id %>"
                                            data-name="<%= pkg.name %>"
                                            data-speed_down="<%= pkg.speed_down %>"
                                            data-speed_up="<%= pkg.speed_up %>"
                                            data-price="<%= pkg.price %>"
                                            data-is_bypass="<%= pkg.is_bypass || 0 %>"
                                            data-no_wa_billing="<%= pkg.no_wa_billing || 0 %>"
                                            data-description="<%= pkg.description || '' %>"
                                            title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form action="/packages/<%= pkg.id %>/delete" method="POST" class="d-inline">
                                        <button type="button" class="btn btn-outline-danger btn-delete" title="Hapus">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
    </div>
</div>

<!-- Package Modal -->
<div class="modal fade" id="packageModal" tabindex="-1" aria-labelledby="packageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="packageModalLabel">
                    <i class="fas fa-box text-primary me-2"></i>Tambah Paket
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <form id="packageForm" action="/packages" method="POST">
                <div class="modal-body">
                    <input type="hidden" id="packageId" name="id">
                    <div class="mb-3">
                        <label for="packageName" class="form-label">Nama Paket <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="packageName" name="name" required placeholder="Contoh: Paket 10 Mbps">
                    </div>

                    <!-- Toggle Paket Bypass / Gratis -->
                    <div class="mb-3 p-3 bg-light rounded border">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" role="switch" id="packageIsBypass" name="is_bypass" value="1">
                            <label class="form-check-label fw-bold text-dark" for="packageIsBypass">
                                <i class="fas fa-shield-halved text-warning me-1"></i>Paket Khusus Bypass / Gratis
                            </label>
                        </div>
                        <small class="text-muted d-block">
                            Pelanggan paket ini <strong>tidak menerima tagihan</strong> bulanan, <strong>tidak menerima notifikasi WA tagihan</strong>, dan <strong>kebal dari isolir otomatis</strong>.
                        </small>
                    </div>

                    <!-- Toggle Paket Paralel / Tanpa Notifikasi WA Tagihan -->
                    <div class="mb-3 p-3 bg-light rounded border">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" role="switch" id="packageNoWaBilling" name="no_wa_billing" value="1">
                            <label class="form-check-label fw-bold text-dark" for="packageNoWaBilling">
                                <i class="fas fa-bell-slash text-info me-1"></i>Tanpa Informasi Tagihan WhatsApp (Paralel / Existing)
                            </label>
                        </div>
                        <small class="text-muted d-block">
                            Pelanggan paket ini <strong>tidak akan menerima pesan tagihan WhatsApp</strong>, namun <strong>tetap bisa terisolir secara normal</strong> jika disuspend atau jatuh tempo.
                        </small>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label for="speedDown" class="form-label">Download (Mbps) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="speedDown" name="speed_down" required min="1" placeholder="10">
                                <span class="input-group-text">Mbps</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <label for="speedUp" class="form-label">Upload (Mbps) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="speedUp" name="speed_up" required min="1" placeholder="5">
                                <span class="input-group-text">Mbps</span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="packagePrice" class="form-label">Harga (Rp) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">Rp</span>
                            <input type="number" class="form-control" id="packagePrice" name="price" required min="0" placeholder="100000">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="packageDescription" class="form-label">Deskripsi</label>
                        <textarea class="form-control" id="packageDescription" name="description" rows="2" placeholder="Deskripsi paket (opsional)"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary" id="packageSubmitBtn">
                        <i class="fas fa-save me-2"></i>Simpan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openCreateModal() {
    document.getElementById('packageModalLabel').innerHTML = '<i class="fas fa-box text-primary me-2"></i>Tambah Paket';
    document.getElementById('packageForm').action = '/packages';
    document.getElementById('packageId').value = '';
    document.getElementById('packageName').value = '';
    document.getElementById('packageIsBypass').checked = false;
    document.getElementById('packageNoWaBilling').checked = false;
    document.getElementById('speedDown').value = '';
    document.getElementById('speedUp').value = '';
    document.getElementById('packagePrice').value = '';
    document.getElementById('packageDescription').value = '';
}

document.getElementById('packageIsBypass').addEventListener('change', function() {
    if (this.checked) {
        document.getElementById('packagePrice').value = '0';
    }
});

document.querySelectorAll('.btn-edit-package').forEach(function(btn) {
    btn.addEventListener('click', function() {
        const id = this.dataset.id;
        const name = this.dataset.name;
        const speedDown = this.dataset.speed_down;
        const speedUp = this.dataset.speed_up;
        const price = this.dataset.price;
        const isBypass = this.dataset.is_bypass === '1';
        const noWaBilling = this.dataset.no_wa_billing === '1';
        const description = this.dataset.description;

        document.getElementById('packageModalLabel').innerHTML = '<i class="fas fa-edit text-primary me-2"></i>Edit Paket';
        document.getElementById('packageForm').action = '/packages/' + id;
        document.getElementById('packageId').value = id;
        document.getElementById('packageName').value = name;
        document.getElementById('packageIsBypass').checked = isBypass;
        document.getElementById('packageNoWaBilling').checked = noWaBilling;
        document.getElementById('speedDown').value = speedDown;
        document.getElementById('speedUp').value = speedUp;
        document.getElementById('packagePrice').value = price;
        document.getElementById('packageDescription').value = description;

        new bootstrap.Modal(document.getElementById('packageModal')).show();
    });
});
</script>

<%- include('partials/footer') %>
