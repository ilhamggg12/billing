<%
    const recap = (typeof techRecap !== 'undefined' && techRecap) ? techRecap : null;
    const recapPageUrl = (typeof recapBaseUrl !== 'undefined' && recapBaseUrl) ? recapBaseUrl : '/rekap-teknisi';
    const isStandaloneRecap = (typeof standaloneRecapPage !== 'undefined' && standaloneRecapPage);
%>
<% if (recap && recap.summary) { 
    const rSum = recap.summary;
    const rTechs = recap.perTechnician || [];
    const rItems = recap.completedItems || [];
    const activeRange = (recap.filters && recap.filters.range) ? recap.filters.range : 'today';
%>

<!-- Filter Bar & Rentang Periode (Gaya Laporan ISP Manager) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-3 border-bottom">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="text-muted small fw-bold me-1">
                    <i class="fas fa-bolt text-warning me-1"></i>Rentang Periode:
                </span>
                <button type="button"
                        class="btn btn-sm <%= activeRange === 'today' ? 'btn-primary fw-semibold shadow-sm' : 'btn-outline-secondary' %> recap-range-btn"
                        data-range="today"
                        onclick="switchTechRecapRange('today')">
                    <i class="fas fa-calendar-day me-1"></i>Hari Ini
                    <span class="badge <%= activeRange === 'today' ? 'bg-white text-primary' : 'bg-secondary bg-opacity-10 text-dark' %> ms-1"><%= rSum.today.total %></span>
                </button>
                <button type="button"
                        class="btn btn-sm <%= activeRange === 'week' ? 'btn-primary fw-semibold shadow-sm' : 'btn-outline-secondary' %> recap-range-btn"
                        data-range="week"
                        onclick="switchTechRecapRange('week')">
                    <i class="fas fa-calendar-week me-1"></i>Minggu Ini
                    <span class="badge <%= activeRange === 'week' ? 'bg-white text-primary' : 'bg-secondary bg-opacity-10 text-dark' %> ms-1"><%= rSum.week.total %></span>
                </button>
                <button type="button"
                        class="btn btn-sm <%= activeRange === 'month' ? 'btn-primary fw-semibold shadow-sm' : 'btn-outline-secondary' %> recap-range-btn"
                        data-range="month"
                        onclick="switchTechRecapRange('month')">
                    <i class="fas fa-calendar-alt me-1"></i>Bulan Ini
                    <span class="badge <%= activeRange === 'month' ? 'bg-white text-primary' : 'bg-secondary bg-opacity-10 text-dark' %> ms-1"><%= rSum.month.total %></span>
                </button>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-secondary border px-3 py-2 fw-normal">
                    <i class="far fa-clock text-primary me-1"></i>Periode Aktif:
                    <strong class="text-dark ms-1" id="recapHeaderPeriodText"><%= rSum.selected.label %> (<%= rSum.selected.subLabel %>)</strong>
                </span>
            </div>
        </div>

        <!-- Form Filter Rentang Tanggal Kustom & Teknisi -->
        <form method="GET" action="<%= recapPageUrl %>" class="row g-3 align-items-end">
            <input type="hidden" name="recap_range" value="custom">
            <input type="hidden" name="tab" value="recap">
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">
                    <i class="far fa-calendar-alt text-primary me-1"></i>Dari Tanggal
                </label>
                <input type="date" name="recap_start" class="form-control form-control-sm" value="<%= recap.filters.startDate %>" required>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">
                    <i class="far fa-calendar-alt text-danger me-1"></i>Sampai Tanggal
                </label>
                <input type="date" name="recap_end" class="form-control form-control-sm" value="<%= recap.filters.endDate %>" required>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">
                    <i class="fas fa-user-cog text-success me-1"></i>Filter Teknisi
                </label>
                <select id="recapTechSelectFilter" class="form-select form-select-sm" onchange="filterRecapByTechAndType()">
                    <option value="all">-- Semua Teknisi (<%= rTechs.length %>) --</option>
                    <% rTechs.forEach(t => { %>
                        <option value="<%= t.name %>"><%= t.name %> (<%= t.allTime.total %> Selesai)</option>
                    <% }) %>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1 fw-semibold">
                    <i class="fas fa-filter me-1"></i>Terapkan Tanggal
                </button>
                <a href="<%= recapPageUrl %><%= isStandaloneRecap ? '' : '?tab=recap' %>" class="btn btn-sm btn-outline-secondary" title="Reset Filter">
                    <i class="fas fa-undo"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- 4 Stat Cards Ringkasan (Desain Bersih Konsisten dengan Dashboard & Laporan) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Beres Hari Ini -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-success recap-stat-box"
             id="recapCard-today"
             style="cursor: pointer;"
             onclick="switchTechRecapRange('today')">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            Selesai Hari Ini
                        </span>
                        <h4 class="fw-bold mb-0 text-success">
                            <%= rSum.today.total %> <span class="fs-6 fw-normal text-muted">Tiket</span>
                        </h4>
                    </div>
                    <div class="rounded-3 p-3 text-white bg-success bg-opacity-75">
                        <i class="fas fa-calendar-day fa-lg"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-tools text-danger me-1"></i><%= rSum.today.gangguan %> Gangguan</span>
                    <span><i class="fas fa-user-plus text-primary me-1"></i><%= rSum.today.psb %> PSB</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Beres Minggu Ini -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-primary recap-stat-box"
             id="recapCard-week"
             style="cursor: pointer;"
             onclick="switchTechRecapRange('week')">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            Selesai Minggu Ini
                        </span>
                        <h4 class="fw-bold mb-0 text-primary">
                            <%= rSum.week.total %> <span class="fs-6 fw-normal text-muted">Tiket</span>
                        </h4>
                    </div>
                    <div class="rounded-3 p-3 text-white bg-primary bg-opacity-75">
                        <i class="fas fa-calendar-week fa-lg"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-tools text-danger me-1"></i><%= rSum.week.gangguan %> Gangguan</span>
                    <span><i class="fas fa-user-plus text-primary me-1"></i><%= rSum.week.psb %> PSB</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Beres Bulan Ini -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-info recap-stat-box"
             id="recapCard-month"
             style="cursor: pointer;"
             onclick="switchTechRecapRange('month')">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            Selesai Bulan Ini
                        </span>
                        <h4 class="fw-bold mb-0 text-dark">
                            <%= rSum.month.total %> <span class="fs-6 fw-normal text-muted">Tiket</span>
                        </h4>
                    </div>
                    <div class="rounded-3 p-3 text-white bg-info bg-opacity-75">
                        <i class="fas fa-calendar-alt fa-lg"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-tools text-danger me-1"></i><%= rSum.month.gangguan %> Gangguan</span>
                    <span><i class="fas fa-user-plus text-primary me-1"></i><%= rSum.month.psb %> PSB</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Sedang Dikerjakan / Antrean Aktif -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-warning">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            Sedang Dikerjakan
                        </span>
                        <h4 class="fw-bold mb-0 text-warning">
                            <%= rSum.activeWork.total %> <span class="fs-6 fw-normal text-muted">Aktif</span>
                        </h4>
                    </div>
                    <div class="rounded-3 p-3 text-white bg-warning bg-opacity-75">
                        <i class="fas fa-hard-hat fa-lg"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-tools text-danger me-1"></i><%= rSum.activeWork.gangguan %> Gangguan</span>
                    <span><i class="fas fa-user-plus text-primary me-1"></i><%= rSum.activeWork.psb %> PSB</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabel Rekap Per Teknisi -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h6 class="card-title fw-bold mb-0">
                <i class="fas fa-user-check text-primary me-2"></i>Tabel Rekapitulasi Pengerjaan Per Teknisi
            </h6>
        </div>
        <span class="text-muted small">
            Klik nama teknisi untuk memfilter rincian tiket di bawah
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="techRecapTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 55px;">No</th>
                        <th>Nama Teknisi</th>
                        <th class="text-center">Hari Ini (<%= rSum.today.subLabel %>)</th>
                        <th class="text-center">Minggu Ini (<%= rSum.week.subLabel %>)</th>
                        <th class="text-center">Bulan Ini (<%= rSum.month.subLabel %>)</th>
                        <% if (activeRange === 'custom') { %>
                        <th class="text-center">Periode Pilihan</th>
                        <% } %>
                        <th class="text-center">Sedang Dikerjakan</th>
                        <th class="text-center pe-3">Total Akumulasi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (rTechs.length === 0) { %>
                    <tr>
                        <td colspan="<%= activeRange === 'custom' ? 8 : 7 %>" class="text-center text-muted py-4">
                            Belum ada data teknisi terdaftar.
                        </td>
                    </tr>
                    <% } else { %>
                        <% rTechs.forEach((tech, idx) => { %>
                        <tr class="recap-tech-row" data-tech-name="<%= tech.name %>" style="cursor: pointer;" onclick="selectTechInRecap('<%= tech.name %>')">
                            <td class="ps-3">
                                <span class="badge <%= idx === 0 && tech.month.total > 0 ? 'bg-warning text-dark' : 'bg-light text-secondary border' %> rounded-pill px-2 py-1">
                                    #<%= idx + 1 %>
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark"><%= tech.name %></div>
                                <small class="text-muted">
                                    <% if (tech.phone && tech.phone !== '-') { %>
                                        <i class="fab fa-whatsapp text-success me-1"></i><%= tech.phone %>
                                    <% } else { %>
                                        <%= tech.role %>
                                    <% } %>
                                </small>
                            </td>

                            <!-- Hari Ini -->
                            <td class="text-center">
                                <span class="badge <%= tech.today.total > 0 ? 'bg-success' : 'bg-light text-muted border' %> rounded-pill px-3 py-1 fs-6">
                                    <%= tech.today.total %> Beres
                                </span>
                                <div class="text-muted mt-1" style="font-size: 0.72rem;">
                                    <span class="text-danger fw-semibold"><%= tech.today.gangguan %></span> Gangguan •
                                    <span class="text-primary fw-semibold"><%= tech.today.psb %></span> PSB
                                </div>
                            </td>

                            <!-- Minggu Ini -->
                            <td class="text-center">
                                <span class="badge <%= tech.week.total > 0 ? 'bg-primary' : 'bg-light text-muted border' %> rounded-pill px-3 py-1 fs-6">
                                    <%= tech.week.total %> Beres
                                </span>
                                <div class="text-muted mt-1" style="font-size: 0.72rem;">
                                    <span class="text-danger fw-semibold"><%= tech.week.gangguan %></span> Gangguan •
                                    <span class="text-primary fw-semibold"><%= tech.week.psb %></span> PSB
                                </div>
                            </td>

                            <!-- Bulan Ini -->
                            <td class="text-center">
                                <span class="badge <%= tech.month.total > 0 ? 'bg-info text-dark' : 'bg-light text-muted border' %> rounded-pill px-3 py-1 fs-6">
                                    <%= tech.month.total %> Beres
                                </span>
                                <div class="text-muted mt-1" style="font-size: 0.72rem;">
                                    <span class="text-danger fw-semibold"><%= tech.month.gangguan %></span> Gangguan •
                                    <span class="text-primary fw-semibold"><%= tech.month.psb %></span> PSB
                                </div>
                            </td>

                            <% if (activeRange === 'custom') { %>
                            <td class="text-center">
                                <span class="badge bg-dark rounded-pill px-3 py-1 fs-6">
                                    <%= tech.selected.total %> Beres
                                </span>
                                <div class="text-muted mt-1" style="font-size: 0.72rem;">
                                    <%= tech.selected.gangguan %> Gangguan • <%= tech.selected.psb %> PSB
                                </div>
                            </td>
                            <% } %>

                            <!-- Sedang Dikerjakan -->
                            <td class="text-center">
                                <% if (tech.active.total > 0) { %>
                                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1">
                                        <%= tech.active.total %> Aktif
                                    </span>
                                    <div class="text-muted mt-1" style="font-size: 0.7rem;">
                                        <%= tech.active.gangguan %> Gangguan • <%= tech.active.psb %> PSB
                                    </div>
                                <% } else { %>
                                    <span class="text-muted small">0 Antrean</span>
                                <% } %>
                            </td>

                            <!-- Total Akumulasi -->
                            <td class="text-center pe-3">
                                <div class="fw-bold text-dark"><%= tech.allTime.total %> Selesai</div>
                                <small class="text-muted" style="font-size: 0.7rem;">
                                    <%= tech.allTime.gangguan %> Gangguan / <%= tech.allTime.psb %> PSB
                                </small>
                            </td>
                        </tr>
                        <% }) %>
                    <% } %>
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="2" class="ps-3">TOTAL KESELURUHAN TIM</td>
                        <td class="text-center text-success">
                            <%= rSum.today.total %> Beres
                            <div class="fw-normal text-muted" style="font-size: 0.7rem;">
                                (<%= rSum.today.gangguan %> Gangguan + <%= rSum.today.psb %> PSB)
                            </div>
                        </td>
                        <td class="text-center text-primary">
                            <%= rSum.week.total %> Beres
                            <div class="fw-normal text-muted" style="font-size: 0.7rem;">
                                (<%= rSum.week.gangguan %> Gangguan + <%= rSum.week.psb %> PSB)
                            </div>
                        </td>
                        <td class="text-center text-dark">
                            <%= rSum.month.total %> Beres
                            <div class="fw-normal text-muted" style="font-size: 0.7rem;">
                                (<%= rSum.month.gangguan %> Gangguan + <%= rSum.month.psb %> PSB)
                            </div>
                        </td>
                        <% if (activeRange === 'custom') { %>
                        <td class="text-center">
                            <%= rSum.selected.total %> Beres
                        </td>
                        <% } %>
                        <td class="text-center text-warning">
                            <%= rSum.activeWork.total %> Aktif
                        </td>
                        <td class="text-center pe-3">
                            <%= rSum.allTime.total %> Selesai
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Tabel Rincian Riwayat Tiket Selesai -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h6 class="card-title fw-bold mb-0">
                <i class="fas fa-list-check text-success me-2"></i>Daftar Tiket Selesai —
                <span class="text-primary" id="recapActiveRangeLabel"><%= rSum.selected.label %> (<%= rSum.selected.subLabel %>)</span>
            </h6>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <select id="recapTypeSelectFilter" class="form-select form-select-sm" style="width: auto;" onchange="filterRecapByTechAndType()">
                <option value="all">Semua Jenis Tiket</option>
                <option value="gangguan">Tiket Gangguan Saja</option>
                <option value="psb">Tiket PSB (Pasang Baru) Saja</option>
            </select>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Waktu Selesai</th>
                        <th>No. Tiket & Jenis</th>
                        <th>Pelanggan</th>
                        <th>Kategori / Paket</th>
                        <th>Teknisi Pelaksana</th>
                        <th>Catatan / Solusi</th>
                        <th class="text-end pe-3">Detail</th>
                    </tr>
                </thead>
                <tbody id="recapCompletedTbody">
                    <% if (rItems.length === 0) { %>
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Belum ada data tiket yang diselesaikan.</td>
                    </tr>
                    <% } else { %>
                        <% rItems.forEach(item => { 
                            const showInitially = (activeRange === 'today' && item.inToday)
                                || (activeRange === 'week' && item.inWeek)
                                || (activeRange === 'month' && item.inMonth)
                                || (activeRange === 'custom' && item.inSelected);
                        %>
                        <tr class="recap-completed-row <%= showInitially ? '' : 'd-none' %>"
                            data-in-today="<%= item.inToday ? '1' : '0' %>"
                            data-in-week="<%= item.inWeek ? '1' : '0' %>"
                            data-in-month="<%= item.inMonth ? '1' : '0' %>"
                            data-in-custom="<%= item.inSelected ? '1' : '0' %>"
                            data-tech="<%= item.technicianName %>"
                            data-type="<%= item.type %>">
                            <td class="ps-3 small text-nowrap">
                                <span class="fw-semibold text-dark">
                                    <i class="far fa-calendar-check text-success me-1"></i><%= item.completedAt ? moment(item.completedAt).format('DD/MM/YYYY HH:mm') : '-' %>
                                </span>
                            </td>
                            <td>
                                <a href="<%= item.detailUrl %>" class="fw-bold text-decoration-none"><%= item.number %></a>
                                <div>
                                    <span class="badge <%= item.badgeClass %>" style="font-size: 0.65rem;"><%= item.typeLabel %></span>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small"><%= item.customerName %></div>
                                <% if (item.customerPhone && item.customerPhone !== '-') { %>
                                    <small class="text-muted" style="font-size: 0.7rem;"><i class="fab fa-whatsapp text-success me-1"></i><%= item.customerPhone %></small>
                                <% } %>
                            </td>
                            <td class="small text-secondary fw-semibold">
                                <%= item.categoryOrPackage %>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                    <i class="fas fa-user-check me-1"></i><%= item.technicianName %>
                                </span>
                            </td>
                            <td class="small text-muted" style="max-width: 260px;">
                                <div class="text-truncate" title="<%= item.notes %>"><%= item.notes %></div>
                            </td>
                            <td class="text-end pe-3">
                                <a href="<%= item.detailUrl %>" class="btn btn-sm btn-outline-primary py-1 px-2">
                                    <i class="fas fa-eye me-1"></i>Detail
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                        <tr id="recapEmptyPeriodRow" class="<%= rSum.selected.total === 0 ? '' : 'd-none' %>">
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fas fa-info-circle me-1"></i>Belum ada tiket yang diselesaikan pada filter periode ini.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    window.__currentRecapRange = '<%= activeRange %>';

    function switchTechRecapRange(range) {
        window.__currentRecapRange = range;
        const rangeLabels = {
            today: 'Hari Ini (<%= rSum.today.subLabel %>)',
            week: 'Minggu Ini (<%= rSum.week.subLabel %>)',
            month: 'Bulan Ini (<%= rSum.month.subLabel %>)'
        };

        // Update tombol periode
        document.querySelectorAll('.recap-range-btn').forEach(btn => {
            const r = btn.getAttribute('data-range');
            const badge = btn.querySelector('.badge');
            btn.classList.remove('btn-primary', 'btn-outline-secondary', 'fw-semibold', 'shadow-sm');
            if (r === range) {
                btn.classList.add('btn-primary', 'fw-semibold', 'shadow-sm');
                if (badge) {
                    badge.className = 'badge bg-white text-primary ms-1';
                }
            } else {
                btn.classList.add('btn-outline-secondary');
                if (badge) {
                    badge.className = 'badge bg-secondary bg-opacity-10 text-dark ms-1';
                }
            }
        });

        const labelEl = document.getElementById('recapActiveRangeLabel');
        if (labelEl && rangeLabels[range]) {
            labelEl.textContent = rangeLabels[range];
        }
        const headerPeriodEl = document.getElementById('recapHeaderPeriodText');
        if (headerPeriodEl && rangeLabels[range]) {
            headerPeriodEl.textContent = rangeLabels[range];
        }

        filterRecapByTechAndType();
    }

    function selectTechInRecap(techName) {
        const selectEl = document.getElementById('recapTechSelectFilter');
        if (!selectEl) return;
        if (selectEl.value === techName) {
            selectEl.value = 'all';
        } else {
            selectEl.value = techName;
        }
        filterRecapByTechAndType();
    }

    function filterRecapByTechAndType() {
        const range = window.__currentRecapRange || 'today';
        const techSelect = document.getElementById('recapTechSelectFilter');
        const typeSelect = document.getElementById('recapTypeSelectFilter');
        const selectedTech = techSelect ? techSelect.value : 'all';
        const selectedType = typeSelect ? typeSelect.value : 'all';

        // Highlight baris teknisi yang sedang difilter
        document.querySelectorAll('.recap-tech-row').forEach(row => {
            if (selectedTech !== 'all' && row.getAttribute('data-tech-name') === selectedTech) {
                row.classList.add('table-active');
            } else {
                row.classList.remove('table-active');
            }
        });

        let visibleCount = 0;
        document.querySelectorAll('.recap-completed-row').forEach(row => {
            const matchPeriod = (range === 'today' && row.getAttribute('data-in-today') === '1')
                || (range === 'week' && row.getAttribute('data-in-week') === '1')
                || (range === 'month' && row.getAttribute('data-in-month') === '1')
                || (range === 'custom' && row.getAttribute('data-in-custom') === '1');
            const matchTech = (selectedTech === 'all' || row.getAttribute('data-tech') === selectedTech);
            const matchType = (selectedType === 'all' || row.getAttribute('data-type') === selectedType);

            if (matchPeriod && matchTech && matchType) {
                row.classList.remove('d-none');
                visibleCount++;
            } else {
                row.classList.add('d-none');
            }
        });

        const emptyRow = document.getElementById('recapEmptyPeriodRow');
        if (emptyRow) {
            if (visibleCount === 0) {
                emptyRow.classList.remove('d-none');
            } else {
                emptyRow.classList.add('d-none');
            }
        }
    }
</script>
<% } %>
