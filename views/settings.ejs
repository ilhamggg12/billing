        window.openChangePortModal = function() {
            const cur = $('#web_port').val() || '<%= settings.web_port || process.env.PORT || "3000" %>';
            $('#inputNewWebPort').val(cur);
            $('#previewPortTxt').text(cur);
            const m = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalChangeWebPort'));
            m.show();
        };

        $(document).on('input', '#inputNewWebPort', function() {
            $('#previewPortTxt').text($(this).val() || '3000');
        });

        $(document).on('submit', '#formChangeWebPort', function(e) {
            e.preventDefault();
            const portVal = parseInt($('#inputNewWebPort').val(), 10);
            if (!portVal || portVal < 1 || portVal > 65535) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Port Tidak Valid',
                        text: 'Nomor port harus berupa angka antara 1 sampai 65535.'
                    });
                } else {
                    alert('Nomor port harus berupa angka antara 1 sampai 65535.');
                }
                return;
            }

            const btn = $('#btnSubmitPort');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Menyimpan...');

            fetch('/settings/web-port', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ port: portVal })
            })
            .then(r => r.json())
            .then(data => {
                btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i>Simpan Perubahan Port');
                if (data.success) {
                    const m = bootstrap.Modal.getInstance(document.getElementById('modalChangeWebPort'));
                    if (m) m.hide();
                    $('#web_port').val(data.port);
                    $('#currentPortBadge').text(data.port);
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'success',
                            title: 'Port Berhasil Disimpan!',
                            html: `${data.message}<br><br><div class="p-2 rounded bg-light border font-monospace">Port Baru: <strong class="text-primary">${data.port}</strong></div>`,
                            confirmButtonText: 'OK'
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        alert(data.message);
                        window.location.reload();
                    }
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Gagal Mengubah Port',
                            text: data.message || 'Terjadi kesalahan sistem'
                        });
                    } else {
                        alert(data.message || 'Gagal mengubah port');
                    }
                }
            })
            .catch(err => {
                btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i>Simpan Perubahan Port');
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Kesalahan Jaringan',
                        text: err.message
                    });
                } else {
                    alert('Kesalahan jaringan: ' + err.message);
                }
            });
        });
    });
}
</script>

