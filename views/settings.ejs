<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Simpan dan Pulihkan Tab Aktif (Persist Active Tab via localStorage & URL Hash)
    const tabTriggers = document.querySelectorAll('#settingsTab button[data-bs-toggle="pill"]');
    tabTriggers.forEach(function(trigger) {
        trigger.addEventListener('shown.bs.tab', function(e) {
            const targetId = e.target.getAttribute('data-bs-target');
            if (targetId) {
                localStorage.setItem('active_settings_tab', targetId);
            }
        });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const queryTab = urlParams.get('tab') ? `#tab-${urlParams.get('tab')}` : null;
    const hashTab = window.location.hash;
    const tabToActivate = (queryTab && document.querySelector(`#settingsTab button[data-bs-target="${queryTab}"]`))
        ? queryTab
        : ((hashTab && document.querySelector(`#settingsTab button[data-bs-target="${hashTab}"]`))
            ? hashTab
            : localStorage.getItem('active_settings_tab'));

    if (tabToActivate) {
        const activeBtn = document.querySelector(`#settingsTab button[data-bs-target="${tabToActivate}"]`);
        if (activeBtn) {
            const tabInstance = bootstrap.Tab.getOrCreateInstance(activeBtn);
            tabInstance.show();
        }
    }

    // 2. Toggle password visibility
    document.querySelectorAll('.toggle-password').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const targetId = this.dataset.target;
            const input = document.getElementById(targetId);
            const icon = this.querySelector('i');
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        });
    });

    // 3. WhatsApp Status & QR Code Logic
    let waPollInterval = null;

    function setWaStatusUI(status, qr, error) {
        const badge = document.getElementById('waStatusBadge');
        const loadingArea = document.getElementById('waLoadingArea');
        const qrArea = document.getElementById('waQrArea');
        const qrImage = document.getElementById('waQrImage');
        const connectedArea = document.getElementById('waConnectedArea');
        const errorAlert = document.getElementById('waErrorAlert');
        const connectBtn = document.getElementById('waConnectBtn');
        const disconnectBtn = document.getElementById('waDisconnectBtn');

        if (error) {
            errorAlert.textContent = error;
            errorAlert.style.display = 'block';
        } else {
            errorAlert.style.display = 'none';
        }

        if (status === 'connected') {
            badge.className = 'badge bg-success px-3 py-2';
            badge.innerHTML = '<i class="fas fa-check-circle me-1"></i>Terhubung';
            if (loadingArea) loadingArea.style.display = 'none';
            if (qrArea) qrArea.style.display = 'none';
            if (connectedArea) connectedArea.style.display = 'block';
            if (connectBtn) connectBtn.style.display = 'none';
            if (disconnectBtn) {
                disconnectBtn.style.display = 'block';
                disconnectBtn.disabled = false;
                disconnectBtn.innerHTML = '<i class="fas fa-unlink me-2"></i>Putuskan Koneksi WhatsApp';
            }
        } else if (status === 'connecting') {
            if (connectBtn) connectBtn.style.display = 'none';
            if (disconnectBtn) {
                disconnectBtn.style.display = 'block';
                disconnectBtn.disabled = false;
                disconnectBtn.innerHTML = '<i class="fas fa-unlink me-2"></i>Batalkan Inisialisasi';
            }
            if (connectedArea) connectedArea.style.display = 'none';

            if (qr) {
                badge.className = 'badge bg-warning text-dark px-3 py-2';
                badge.innerHTML = '<i class="fas fa-qrcode me-1"></i>Scan QR Code';
                if (qrImage) qrImage.src = qr;
                if (qrArea) qrArea.style.display = 'block';
                if (loadingArea) loadingArea.style.display = 'none';
            } else {
                badge.className = 'badge bg-info text-white px-3 py-2';
                badge.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Menyiapkan...';
                if (loadingArea) loadingArea.style.display = 'block';
                if (qrArea) qrArea.style.display = 'none';
            }
        } else {
            badge.className = 'badge bg-secondary px-3 py-2';
            badge.innerHTML = '<i class="fas fa-times-circle me-1"></i>Tidak Terhubung';
            if (loadingArea) loadingArea.style.display = 'none';
            if (qrArea) qrArea.style.display = 'none';
            if (connectedArea) connectedArea.style.display = 'none';
            if (connectBtn) {
                connectBtn.style.display = 'block';
                connectBtn.disabled = false;
                connectBtn.innerHTML = '<i class="fab fa-whatsapp me-2"></i>Hubungkan WhatsApp (Munculkan QR)';
            }
            if (disconnectBtn) disconnectBtn.style.display = 'none';
        }
    }

    function checkWaStatus() {
        fetch('/api/whatsapp/status')
            .then(function(res) { return res.json(); })
            .then(function(data) {
                setWaStatusUI(data.status, data.qr, data.error);
                if (data.status === 'connected') {
                    if (waPollInterval) {
                        clearInterval(waPollInterval);
                        waPollInterval = null;
                    }
                    startPolling(10000);
                }
            })
            .catch(function(err) {
                console.error('Error polling WA status:', err);
            });
    }

    function startPolling(intervalMs) {
        if (waPollInterval) clearInterval(waPollInterval);
        waPollInterval = setInterval(checkWaStatus, intervalMs || 2000);
    }

    // Connect Button
    const connectBtn = document.getElementById('waConnectBtn');
    if (connectBtn) {
        connectBtn.addEventListener('click', function() {
            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Menyiapkan Browser...';
            setWaStatusUI('connecting', null, null);
            startPolling(2000);

            fetch('/api/whatsapp/initialize', { method: 'POST' })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    console.log('WA init response:', data);
                })
                .catch(function(err) {
                    console.error('WA init request failed:', err);
                    setWaStatusUI('disconnected', null, 'Gagal inisialisasi: ' + err.message);
                });
        });
    }

    // Disconnect Button
    const disconnectBtn = document.getElementById('waDisconnectBtn');
    if (disconnectBtn) {
        disconnectBtn.addEventListener('click', function() {
            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Memutuskan...';

            if (waPollInterval) {
                clearInterval(waPollInterval);
                waPollInterval = null;
            }

            fetch('/api/whatsapp/disconnect', { method: 'POST' })
                .then(function(res) { return res.json(); })
                .then(function() {
                    setWaStatusUI('disconnected', null, null);
                })
                .catch(function(err) {
                    console.error('WA disconnect failed:', err);
                    setWaStatusUI('disconnected', null, err.message);
                });
        });
    }

    // Auto-poll if already connecting
    <% if (waStatusVal === 'connecting' || waQRVal) { %>
    startPolling(2000);
    <% } %>

    // 4. Copy reference code button handler
    document.querySelectorAll('.copy-ref-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const tag = this.dataset.tag;
            if (!tag) return;

            navigator.clipboard.writeText(tag).then(() => {
                const originalHtml = this.innerHTML;
                this.classList.replace('btn-outline-secondary', 'btn-success');
                this.classList.replace('btn-outline-success', 'btn-success');
                this.innerHTML = '<i class="fas fa-check me-1"></i>Tersalin';

                setTimeout(() => {
                    this.innerHTML = originalHtml;
                    this.classList.replace('btn-success', this.dataset.tag === '{paket_internet}' ? 'btn-outline-success' : 'btn-outline-secondary');
                }, 1500);
            }).catch(() => {
                prompt('Salin kode referensi:', tag);
            });
        });
    });

    // 5. QRIS Image Upload Handler (FileReader + Auto Resize / Canvas Optimization)
    const qrisInput = document.getElementById('qris_file_input');
    const qrisHidden = document.getElementById('payment_qris_image');
    const qrisPreview = document.getElementById('qrisPreviewContainer');

    function bindRemoveQrisBtn() {
        const removeBtn = document.getElementById('btnRemoveQris');
        if (removeBtn) {
            removeBtn.addEventListener('click', function() {
                qrisHidden.value = '';
                if (qrisInput) qrisInput.value = '';
                qrisPreview.innerHTML = `
                    <i class="fas fa-qrcode fa-3x text-muted mb-2 opacity-50"></i>
                    <small class="text-muted d-block">Belum ada barcode QRIS</small>
                `;
            });
        }
    }
    bindRemoveQrisBtn();

    if (qrisInput) {
        qrisInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;

            if (!file.type.startsWith('image/')) {
                alert('Silakan pilih file gambar yang valid (PNG/JPG/WEBP)');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    const maxDim = 600;
                    let width = img.width;
                    let height = img.height;

                    if (width > maxDim || height > maxDim) {
                        if (width > height) {
                            height = Math.round((height * maxDim) / width);
                            width = maxDim;
                        } else {
                            width = Math.round((width * maxDim) / height);
                            height = maxDim;
                        }
                    }

                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    const dataUrl = canvas.toDataURL('image/png', 0.9);
                    qrisHidden.value = dataUrl;

                    qrisPreview.innerHTML = `
                        <img src="${dataUrl}" class="img-fluid rounded border bg-white p-1 mb-2 shadow-sm" style="max-height: 125px; max-width: 125px; object-fit: contain;">
                        <button type="button" class="btn btn-sm btn-outline-danger d-block w-100" id="btnRemoveQris">
                            <i class="fas fa-trash me-1"></i>Hapus QRIS
                        </button>
                    `;
                    bindRemoveQrisBtn();
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        });
    }
});

