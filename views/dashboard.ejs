<%- include('partials/header', { title: 'Dashboard', activePage: 'dashboard' }) %>
<%
    const formatRupiah = (num) => 'Rp ' + Number(num || 0).toLocaleString('id-ID');
%>

<!-- System Monitoring Bar (Cron/Scheduler, WhatsApp, MikroTik, GenieACS) -->
<%
    const sys = typeof systemStatus !== 'undefined' && systemStatus ? systemStatus : {
        scheduler: { active: true, statusText: 'Aktif' },
        whatsapp: { connected: false, statusText: 'Terputus' },
        mikrotik: { connected: false, statusText: 'Terputus' },
        genieacs: { connected: false, statusText: 'Terputus' }
    };
%>
<div class="row g-3 mb-4" id="systemMonitoringRow">
    <!-- Cron / Scheduler Monitor -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100" id="cardMonitorScheduler" style="<%= sys.scheduler.active ? 'border: 1px solid rgba(16, 185, 129, 0.3) !important;' : 'border: 1px solid rgba(220, 53, 69, 0.5) !important;' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 text-white" id="iconMonitorScheduler" style="background-color: <%= sys.scheduler.active ? '#6366f1' : '#ef4444' %>;">
                        <i class="fas fa-clock fa-lg"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">Cron / Scheduler</span>
                        <h6 class="fw-bold mb-0 <%= sys.scheduler.active ? 'text-success' : 'text-danger' %>" id="labelMonitorScheduler">
                            <%= sys.scheduler.active ? 'Aktif Berjalan' : 'Nonaktif / Berhenti' %>
                        </h6>
                    </div>
                </div>
                <span class="badge <%= sys.scheduler.active ? 'bg-success' : 'badge-blinking-danger' %>" id="badgeMonitorScheduler">
                    <i class="fas <%= sys.scheduler.active ? 'fa-check-circle' : 'fa-exclamation-triangle' %> me-1"></i><%= sys.scheduler.active ? 'Aktif' : 'Nonaktif' %>
                </span>
            </div>
        </div>
    </div>

    <!-- WhatsApp Monitor -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100" id="cardMonitorWhatsApp" style="<%= sys.whatsapp.connected ? 'border: 1px solid rgba(16, 185, 129, 0.3) !important;' : 'border: 1px solid rgba(220, 53, 69, 0.5) !important;' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 text-white" id="iconMonitorWhatsApp" style="background-color: <%= sys.whatsapp.connected ? '#25d366' : '#ef4444' %>;">
                        <i class="fab fa-whatsapp fa-lg"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">WhatsApp Gateway</span>
                        <h6 class="fw-bold mb-0 <%= sys.whatsapp.connected ? 'text-success' : 'text-danger' %>" id="labelMonitorWhatsApp">
                            <%= sys.whatsapp.connected ? 'Terhubung' : sys.whatsapp.statusText %>
                        </h6>
                    </div>
                </div>
                <span class="badge <%= sys.whatsapp.connected ? 'bg-success' : 'badge-blinking-danger' %>" id="badgeMonitorWhatsApp">
                    <i class="fas <%= sys.whatsapp.connected ? 'fa-check-circle' : 'fa-exclamation-triangle' %> me-1"></i><%= sys.whatsapp.connected ? 'Terhubung' : 'Terputus' %>
                </span>
            </div>
        </div>
    </div>

    <!-- MikroTik Monitor -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100" id="cardMonitorMikrotik" style="<%= sys.mikrotik.connected ? 'border: 1px solid rgba(16, 185, 129, 0.3) !important;' : 'border: 1px solid rgba(220, 53, 69, 0.5) !important;' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 text-white" id="iconMonitorMikrotik" style="background-color: <%= sys.mikrotik.connected ? '#0284c7' : '#ef4444' %>;">
                        <i class="fas fa-network-wired fa-lg"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">Router MikroTik</span>
                        <h6 class="fw-bold mb-0 <%= sys.mikrotik.connected ? 'text-success' : 'text-danger' %>" id="labelMonitorMikrotik">
                            <%= sys.mikrotik.connected ? 'Terhubung' : 'Tidak Terhubung' %>
                        </h6>
                    </div>
                </div>
                <span class="badge <%= sys.mikrotik.connected ? 'bg-success' : 'badge-blinking-danger' %>" id="badgeMonitorMikrotik">
                    <i class="fas <%= sys.mikrotik.connected ? 'fa-check-circle' : 'fa-exclamation-triangle' %> me-1"></i><%= sys.mikrotik.connected ? 'Terhubung' : 'Terputus' %>
                </span>
            </div>
        </div>
    </div>

    <!-- GenieACS Monitor -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100" id="cardMonitorGenieACS" style="<%= sys.genieacs.connected ? 'border: 1px solid rgba(16, 185, 129, 0.3) !important;' : 'border: 1px solid rgba(220, 53, 69, 0.5) !important;' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 text-white" id="iconMonitorGenieACS" style="background-color: <%= sys.genieacs.connected ? '#8b5cf6' : '#ef4444' %>;">
                        <i class="fas fa-microchip fa-lg"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">GenieACS (CPE/ONT)</span>
                        <h6 class="fw-bold mb-0 <%= sys.genieacs.connected ? 'text-success' : 'text-danger' %>" id="labelMonitorGenieACS">
                            <%= sys.genieacs.connected ? 'Terhubung' : 'Tidak Terhubung' %>
                        </h6>
                    </div>
                </div>
                <span class="badge <%= sys.genieacs.connected ? 'bg-success' : 'badge-blinking-danger' %>" id="badgeMonitorGenieACS">
                    <i class="fas <%= sys.genieacs.connected ? 'fa-check-circle' : 'fa-exclamation-triangle' %> me-1"></i><%= sys.genieacs.connected ? 'Terhubung' : 'Terputus' %>
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Stat Cards (5 Cards) -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
    <div class="col">
        <div class="card stat-card primary h-100 shadow-sm border-0">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold small text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Pelanggan</span>
                        <h3 class="fw-bold mb-0 text-dark"><%= stats.totalCustomers %></h3>
                    </div>
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary rounded-3 p-3">
                        <i class="fas fa-users fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card success h-100 shadow-sm border-0">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold small text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Pelanggan Aktif</span>
                        <h3 class="fw-bold mb-0 text-dark"><%= stats.activeCustomers %></h3>
                    </div>
                    <div class="stat-icon-wrapper bg-success-subtle text-success rounded-3 p-3">
                        <i class="fas fa-user-check fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card secondary h-100 shadow-sm border-0">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold small text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Tidak Aktif / Suspend</span>
                        <h3 class="fw-bold mb-0 text-dark"><%= stats.inactiveCustomers || 0 %></h3>
                    </div>
                    <div class="stat-icon-wrapper bg-secondary-subtle text-secondary rounded-3 p-3">
                        <i class="fas fa-user-slash fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card warning h-100 shadow-sm border-0">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold small text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Pendapatan Bulan Ini</span>
                        <h4 class="fw-bold mb-0 text-dark" style="font-size: 1.25rem;"><%= formatRupiah(stats.monthlyRevenue) %></h4>
                    </div>
                    <div class="stat-icon-wrapper bg-warning-subtle text-warning rounded-3 p-3">
                        <i class="fas fa-wallet fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card danger h-100 shadow-sm border-0">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold small text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Tagihan Belum Bayar</span>
                        <h3 class="fw-bold mb-0 text-dark"><%= stats.unpaidInvoices %></h3>
                    </div>
                    <div class="stat-icon-wrapper bg-danger-subtle text-danger rounded-3 p-3">
                        <i class="fas fa-file-invoice-dollar fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <!-- Grafik Pendapatan (Bar Chart dengan Range Per Bulan) -->
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h6 class="card-title fw-bold mb-0">
                        <i class="fas fa-chart-bar text-primary me-2"></i>Grafik Pendapatan
                    </h6>
                    <small class="text-muted">Pilih range bulan untuk melihat akumulasi pembayaran tagihan</small>
                </div>
                <!-- Range Filter Form -->
                <form method="GET" action="/dashboard" class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted small"><i class="fas fa-calendar-alt"></i></span>
                        <input type="month" class="form-control form-control-sm" name="start_month" value="<%= startMonth %>" title="Dari Bulan" required>
                        <span class="input-group-text bg-light text-muted small">s/d</span>
                        <input type="month" class="form-control form-control-sm" name="end_month" value="<%= endMonth %>" title="Sampai Bulan" required>
                        <button type="submit" class="btn btn-primary btn-sm px-3" title="Terapkan Range">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="280"></canvas>
            </div>
        </div>
    </div>

    <!-- Grafik Pelanggan Baru Terinstalasi Tiap Bulan -->
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title fw-bold mb-0">
                        <i class="fas fa-user-plus text-success me-2"></i>Pemasangan Baru
                    </h6>
                    <small class="text-muted">Jumlah pelanggan baru terinstalasi</small>
                </div>
                <span class="badge bg-success-subtle text-success fw-bold px-2 py-1">
                    Bulan Ini: +<%= newCustomersThisMonth %>
                </span>
            </div>
            <div class="card-body">
                <canvas id="installationChart" height="280"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ====================================================================== -->
<!-- URUTAN RANKING & SCORING PEMBAYARAN PELANGGAN (TERBAIK -> BERMASALAH) -->
<!-- ====================================================================== -->
<%
    const rSum = typeof rankingSummary !== 'undefined' && rankingSummary ? rankingSummary : { total: 0, loyal: 0, disiplin: 0, tepat_waktu: 0, macet: 0 };
    const rList = typeof customerRankings !== 'undefined' && customerRankings ? customerRankings : [];
%>
<style>
    @keyframes adminGoldShimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
    }
    .badge-rank-loyal {
        background: linear-gradient(90deg, #fde047, #f59e0b, #fef08a, #d97706);
        background-size: 200% auto;
        color: #451a03 !important;
        font-weight: 800;
        border: 1.5px solid #fef08a;
        box-shadow: 0 0 12px rgba(245, 158, 11, 0.75);
        animation: adminGoldShimmer 3s linear infinite;
    }
    .row-rank-loyal {
        background: linear-gradient(90deg, rgba(254, 249, 195, 0.45) 0%, rgba(255, 255, 255, 0) 100%);
    }
    .badge-rank-disiplin {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #fff !important;
        font-weight: 700;
    }
    .badge-rank-tepat_waktu {
        background: linear-gradient(135deg, #059669, #10b981);
        color: #fff !important;
        font-weight: 700;
    }
    .badge-rank-macet {
        background: linear-gradient(135deg, #dc2626, #991b1b);
        color: #fff !important;
        font-weight: 700;
    }
    .rank-filter-btn.active {
        font-weight: 800;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
    }
</style>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-bottom pt-3 pb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h6 class="card-title fw-bold mb-1">
                    <i class="fas fa-trophy text-warning me-2"></i>Urutan & Scoring Kedisiplinan Pembayaran Pelanggan
                </h6>
                <small class="text-muted">
                    Diurutkan mulai dari pelanggan yang paling rajin membayar tepat waktu (<strong>≤ Tanggal 1</strong>) hingga yang paling terlambat / bermasalah (<strong>&gt; Tanggal 8</strong>)
                </small>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-dark fw-semibold" id="btnToggleRankOrder" onclick="toggleCustomerRankOrder()">
                    <i class="fas fa-sort-amount-down-alt me-1"></i><span id="rankOrderLabel">Urutan: Tepat Waktu → Paling Telat</span>
                </button>
            </div>
        </div>

        <!-- 4 Ringkasan Kategori Scoring (Klik untuk Filter) -->
        <div class="row g-2">
            <div class="col-6 col-md-3">
                <div class="p-2 px-3 rounded-3 border d-flex align-items-center justify-content-between"
                     style="background: linear-gradient(135deg, #fffbeb, #fef3c7); border-color: #fcd34d !important; cursor: pointer;"
                     onclick="filterCustomerRanking('loyal')">
                    <div>
                        <div class="fw-extrabold text-dark small"><i class="fas fa-crown text-warning me-1"></i>Pelanggan Loyal ✨</div>
                        <small class="text-muted" style="font-size: 0.7rem;">Bayar ≤ Tanggal 1</small>
                    </div>
                    <span class="badge badge-rank-loyal rounded-pill fs-6 px-3"><%= rSum.loyal %></span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 px-3 rounded-3 border d-flex align-items-center justify-content-between"
                     style="background: #f0f9ff; border-color: #bae6fd !important; cursor: pointer;"
                     onclick="filterCustomerRanking('disiplin')">
                    <div>
                        <div class="fw-bold text-primary small"><i class="fas fa-medal me-1"></i>Pelanggan Disiplin</div>
                        <small class="text-muted" style="font-size: 0.7rem;">Bayar Tanggal 2 - 5</small>
                    </div>
                    <span class="badge badge-rank-disiplin rounded-pill fs-6 px-3"><%= rSum.disiplin %></span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 px-3 rounded-3 border d-flex align-items-center justify-content-between"
                     style="background: #ecfdf5; border-color: #a7f3d0 !important; cursor: pointer;"
                     onclick="filterCustomerRanking('tepat_waktu')">
                    <div>
                        <div class="fw-bold text-success small"><i class="fas fa-check-circle me-1"></i>Tepat Waktu</div>
                        <small class="text-muted" style="font-size: 0.7rem;">Bayar Tanggal 6 - 8</small>
                    </div>
                    <span class="badge badge-rank-tepat_waktu rounded-pill fs-6 px-3"><%= rSum.tepat_waktu %></span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 px-3 rounded-3 border d-flex align-items-center justify-content-between"
                     style="background: #fef2f2; border-color: #fecaca !important; cursor: pointer;"
                     onclick="filterCustomerRanking('macet')">
                    <div>
                        <div class="fw-bold text-danger small"><i class="fas fa-exclamation-triangle me-1"></i>Pelanggan Macet</div>
                        <small class="text-muted" style="font-size: 0.7rem;">Lewat Tgl 8 / Menunggak</small>
                    </div>
                    <span class="badge badge-rank-macet rounded-pill fs-6 px-3"><%= rSum.macet %></span>
                </div>
            </div>
        </div>

        <!-- Filter Pills -->
        <div class="d-flex flex-wrap gap-1 mt-3">
            <button type="button" class="btn btn-sm btn-primary rank-filter-btn active" data-tier="all" onclick="filterCustomerRanking('all')">
                Semua Pelanggan (<%= rSum.total %>)
            </button>
            <button type="button" class="btn btn-sm btn-outline-warning text-dark rank-filter-btn" data-tier="loyal" onclick="filterCustomerRanking('loyal')">
                👑 Loyal ≤ Tgl 1 (<%= rSum.loyal %>)
            </button>
            <button type="button" class="btn btn-sm btn-outline-info text-dark rank-filter-btn" data-tier="disiplin" onclick="filterCustomerRanking('disiplin')">
                💎 Disiplin Tgl 2-5 (<%= rSum.disiplin %>)
            </button>
            <button type="button" class="btn btn-sm btn-outline-success rank-filter-btn" data-tier="tepat_waktu" onclick="filterCustomerRanking('tepat_waktu')">
                ✅ Tepat Waktu Tgl 6-8 (<%= rSum.tepat_waktu %>)
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger rank-filter-btn" data-tier="macet" onclick="filterCustomerRanking('macet')">
                ⚠️ Macet &gt; Tgl 8 (<%= rSum.macet %>)
            </button>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="customerRankingTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 75px;">Urutan</th>
                        <th>Pelanggan</th>
                        <th>Paket Layanan</th>
                        <th>Predikat / Scoring</th>
                        <th>Skor</th>
                        <th>Kebiasaan / Waktu Pembayaran</th>
                        <th>Rekap Tagihan</th>
                        <th class="text-end pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody id="customerRankingTbody">
                    <% if (rList.length === 0) { %>
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Belum ada data pelanggan</td>
                        </tr>
                    <% } else { %>
                        <% rList.forEach(item => { %>
                        <tr class="ranking-row <%= item.tierKey === 'loyal' ? 'row-rank-loyal' : '' %>"
                            data-tier="<%= item.tierKey %>"
                            data-rank="<%= item.rank %>">
                            <td class="ps-3">
                                <% if (item.rank === 1 && item.tierKey === 'loyal') { %>
                                    <span class="badge badge-rank-loyal rounded-pill px-2 py-1">
                                        <i class="fas fa-trophy me-1"></i>#<%= item.rank %>
                                    </span>
                                <% } else if (item.tierKey === 'macet') { %>
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger fw-bold rounded-pill px-2 py-1">
                                        #<%= item.rank %>
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-light text-dark border fw-bold rounded-pill px-2 py-1">
                                        #<%= item.rank %>
                                    </span>
                                <% } %>
                            </td>
                            <td>
                                <div class="fw-bold text-dark d-flex align-items-center gap-1">
                                    <%= item.customerName %>
                                    <% if (item.customerStatus !== 'active') { %>
                                        <span class="badge bg-danger" style="font-size: 0.65rem;">Terisolir</span>
                                    <% } %>
                                </div>
                                <small class="text-muted">
                                    <code><%= item.customerCode || '-' %></code>
                                    <% if (item.customerPhone) { %> • <i class="fab fa-whatsapp text-success"></i> <%= item.customerPhone %><% } %>
                                </small>
                            </td>
                            <td class="small fw-semibold text-secondary"><%= item.packageName %></td>
                            <td>
                                <% if (item.tierKey === 'loyal') { %>
                                    <span class="badge badge-rank-loyal rounded-pill px-3 py-1">
                                        <i class="fas fa-crown me-1"></i>✨ Pelanggan Loyal ✨
                                    </span>
                                <% } else if (item.tierKey === 'disiplin') { %>
                                    <span class="badge badge-rank-disiplin rounded-pill px-3 py-1">
                                        <i class="fas fa-medal me-1"></i>Pelanggan Disiplin
                                    </span>
                                <% } else if (item.tierKey === 'tepat_waktu') { %>
                                    <span class="badge badge-rank-tepat_waktu rounded-pill px-3 py-1">
                                        <i class="fas fa-check-circle me-1"></i>Pelanggan Tepat Waktu
                                    </span>
                                <% } else { %>
                                    <span class="badge badge-rank-macet rounded-pill px-3 py-1">
                                        <i class="fas fa-exclamation-triangle me-1"></i>Pelanggan Macet
                                    </span>
                                <% } %>
                            </td>
                            <td>
                                <div class="fw-extrabold <%= item.tierKey === 'loyal' ? 'text-warning' : (item.tierKey === 'macet' ? 'text-danger' : 'text-dark') %>">
                                    <%= item.scorePoints %> <small class="text-muted fw-normal">/100</small>
                                </div>
                                <div style="font-size: 0.68rem;">
                                    <% for (let s = 1; s <= 5; s++) { %>
                                        <i class="<%= s <= item.tier.stars ? 'fas text-warning' : 'far text-muted opacity-25' %> fa-star"></i>
                                    <% } %>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-semibold <%= item.overdueUnpaidCount > 0 ? 'text-danger' : 'text-dark' %>">
                                    <%= item.habitSummary %>
                                </div>
                                <small class="text-muted" style="font-size: 0.72rem;"><%= item.tier.ruleText %></small>
                            </td>
                            <td class="small">
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 me-1">
                                    <%= item.paidCount %> Lunas
                                </span>
                                <% if (item.unpaidCount > 0) { %>
                                    <span class="badge bg-danger">
                                        <%= item.unpaidCount %> Belum Bayar
                                    </span>
                                <% } %>
                            </td>
                            <td class="text-end pe-3">
                                <a href="<%= item.targetInvoiceId ? `/billing/${item.targetInvoiceId}` : `/billing/customer/${item.customerId}` %>"
                                   class="btn btn-sm btn-outline-primary fw-semibold"
                                   title="Lihat Detail Tagihan <%= item.targetInvoiceNumber || item.customerName %>">
                                    <i class="fas fa-file-invoice-dollar me-1"></i>Lihat Tagihan
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Card Footer: Navigasi Paging 10 Pelanggan -->
    <div class="card-footer bg-white border-top py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2" id="rankPaginationContainer">
        <div class="small text-muted" id="rankPaginationInfo">
            Menampilkan <strong id="rankStartIdx">1</strong> - <strong id="rankEndIdx">10</strong> dari <strong id="rankTotalCount"><%= rList.length %></strong> pelanggan
        </div>
        <nav aria-label="Navigasi Halaman Ranking Kedisiplinan">
            <ul class="pagination pagination-sm mb-0 gap-1" id="rankPaginationUl">
                <li class="page-item" id="rankPagePrev">
                    <button class="page-link rounded-2 px-2" type="button" onclick="changeRankPage(-1)" aria-label="Sebelumnya">
                        <i class="fas fa-chevron-left me-1"></i>Sebelumnya
                    </button>
                </li>
                <!-- Nomor-nomor halaman akan di-generate via JavaScript -->
                <li class="page-item" id="rankPageNext">
                    <button class="page-link rounded-2 px-2" type="button" onclick="changeRankPage(1)" aria-label="Selanjutnya">
                        Selanjutnya<i class="fas fa-chevron-right ms-1"></i>
                    </button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- Recent Activity -->
<div class="card shadow-sm">
    <div class="card-header bg-white border-0 pt-3">
        <h6 class="card-title fw-bold mb-0">
            <i class="fas fa-history text-info me-2"></i>Aktivitas Terbaru
        </h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Waktu</th>
                        <th>Aksi</th>
                        <th>Keterangan</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (activities && activities.length > 0) { %>
                        <% activities.forEach(function(activity) { %>
                        <tr>
                            <td class="text-muted small text-nowrap">
                                <i class="fas fa-clock me-1"></i>
                                <%= new Date(activity.created_at).toLocaleString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark"><%= activity.action %></span>
                            </td>
                            <td><%= activity.description %></td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                Belum ada aktivitas
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Grafik Pendapatan (Bar Chart)
    const revenueData = <%- JSON.stringify(revenueData || []) %>;
    const revenueCanvas = document.getElementById('revenueChart');
    if (revenueCanvas) {
        const revenueCtx = revenueCanvas.getContext('2d');
        new Chart(revenueCtx, {
            type: 'bar',
            data: {
                labels: revenueData.map(d => d.month || d.label),
                datasets: [{
                    label: 'Pendapatan (Rp)',
                    data: revenueData.map(d => d.total !== undefined ? d.total : d.value),
                    backgroundColor: 'rgba(79, 70, 229, 0.85)',
                    hoverBackgroundColor: '#4338ca',
                    borderRadius: 6,
                    barPercentage: 0.65,
                    categoryPercentage: 0.7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ' Pendapatan: Rp ' + Number(ctx.parsed.y).toLocaleString('id-ID');
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                if (value >= 1000000) return 'Rp ' + (value / 1000000).toFixed(1) + ' Jt';
                                if (value >= 1000) return 'Rp ' + (value / 1000).toFixed(0) + ' Rb';
                                return 'Rp ' + value;
                            }
                        },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    }

    // 2. Grafik Pelanggan Baru Terinstalasi Tiap Bulan (Bar Chart)
    const installationData = <%- JSON.stringify(installationData || []) %>;
    const installCanvas = document.getElementById('installationChart');
    if (installCanvas) {
        const installCtx = installCanvas.getContext('2d');
        new Chart(installCtx, {
            type: 'bar',
            data: {
                labels: installationData.map(d => d.month || d.label),
                datasets: [{
                    label: 'Pelanggan Baru',
                    data: installationData.map(d => d.count),
                    backgroundColor: 'rgba(16, 185, 129, 0.85)',
                    hoverBackgroundColor: '#059669',
                    borderRadius: 6,
                    barPercentage: 0.6,
                    categoryPercentage: 0.7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ' Terpasang: ' + ctx.parsed.y + ' Pelanggan';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1,
                            precision: 0,
                            callback: function(value) {
                                return value + ' Cust';
                            }
                        },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    }

    // ============================================
    // Real-Time System Monitoring Polling
    // ============================================
    function updateMonitorCard(config) {
        const { cardId, badgeId, labelId, isOk, okText, badText, iconId, okColor, badColor } = config;
        const card = document.getElementById(cardId);
        const badge = document.getElementById(badgeId);
        const label = document.getElementById(labelId);
        const iconBox = document.getElementById(iconId);

        if (!card || !badge || !label) return;

        if (isOk) {
            // State: NORMAL / TERHUBUNG (Hijau/Aktif)
            card.style.border = '1px solid rgba(16, 185, 129, 0.3)';
            badge.className = 'badge bg-success';
            badge.innerHTML = '<i class="fas fa-check-circle me-1"></i>' + okText;
            label.textContent = okText;
            label.className = 'fw-bold mb-0 text-success';
            if (iconBox) iconBox.style.backgroundColor = okColor || '#10b981';
        } else {
            // State: TIDAK TERHUBUNG / BERKEDIP MERAH
            card.style.border = '1px solid rgba(220, 53, 69, 0.5)';
            badge.className = 'badge badge-blinking-danger';
            badge.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>' + badText;
            label.textContent = badText;
            label.className = 'fw-bold mb-0 text-danger';
            if (iconBox) iconBox.style.backgroundColor = badColor || '#ef4444';
        }
    }

    function checkSystemHealth() {
        fetch('/api/system/status')
            .then(res => res.json())
            .then(data => {
                // 1. Cron / Scheduler
                updateMonitorCard({
                    cardId: 'cardMonitorScheduler',
                    badgeId: 'badgeMonitorScheduler',
                    labelId: 'labelMonitorScheduler',
                    iconId: 'iconMonitorScheduler',
                    isOk: data.scheduler && data.scheduler.active,
                    okText: 'Aktif Berjalan',
                    badText: 'Nonaktif / Berhenti',
                    okColor: '#6366f1'
                });

                // 2. WhatsApp Gateway
                updateMonitorCard({
                    cardId: 'cardMonitorWhatsApp',
                    badgeId: 'badgeMonitorWhatsApp',
                    labelId: 'labelMonitorWhatsApp',
                    iconId: 'iconMonitorWhatsApp',
                    isOk: data.whatsapp && data.whatsapp.connected,
                    okText: 'Terhubung',
                    badText: data.whatsapp ? (data.whatsapp.status === 'connecting' ? 'Menghubungkan...' : 'Terputus') : 'Terputus',
                    okColor: '#25d366'
                });

                // 3. MikroTik Router
                updateMonitorCard({
                    cardId: 'cardMonitorMikrotik',
                    badgeId: 'badgeMonitorMikrotik',
                    labelId: 'labelMonitorMikrotik',
                    iconId: 'iconMonitorMikrotik',
                    isOk: data.mikrotik && data.mikrotik.connected,
                    okText: 'Terhubung',
                    badText: 'Tidak Terhubung',
                    okColor: '#0284c7'
                });

                // 4. GenieACS
                updateMonitorCard({
                    cardId: 'cardMonitorGenieACS',
                    badgeId: 'badgeMonitorGenieACS',
                    labelId: 'labelMonitorGenieACS',
                    iconId: 'iconMonitorGenieACS',
                    isOk: data.genieacs && data.genieacs.connected,
                    okText: 'Terhubung',
                    badText: 'Tidak Terhubung',
                    okColor: '#8b5cf6'
                });
            })
            .catch(err => {
                console.warn('Gagal cek status sistem:', err);
            });
    }

    // Jalankan segera dan ulangi setiap 15 detik (menghemat resource & bandwidth)
    checkSystemHealth();
    setInterval(checkSystemHealth, 15000);

    // Inisialisasi Paging Urutan & Scoring Pelanggan (10 per halaman)
    updateRankPagination();
});

function formatRupiah(num) {
    return 'Rp ' + Number(num).toLocaleString('id-ID');
}

// -------------------------------------------------------------------------
// Paging & Filter Urutan & Scoring Kedisiplinan Pembayaran Pelanggan
// -------------------------------------------------------------------------
let currentRankTier = 'all';
let currentRankPage = 1;
const rankPageSize = 10;
let rankAscending = true; // true = Terbaik (Loyal) -> Paling Telat (Macet)

function getFilteredRankRows() {
    const tbody = document.getElementById('customerRankingTbody');
    if (!tbody) return [];
    const allRows = Array.from(tbody.querySelectorAll('.ranking-row'));
    if (currentRankTier === 'all') {
        return allRows;
    }
    return allRows.filter(r => r.getAttribute('data-tier') === currentRankTier);
}

function updateRankPagination() {
    const tbody = document.getElementById('customerRankingTbody');
    if (!tbody) return;

    const allRows = Array.from(tbody.querySelectorAll('.ranking-row'));
    const filteredRows = getFilteredRankRows();
    const totalRows = filteredRows.length;
    const totalPages = Math.max(1, Math.ceil(totalRows / rankPageSize));

    if (currentRankPage > totalPages) {
        currentRankPage = totalPages;
    }
    if (currentRankPage < 1) {
        currentRankPage = 1;
    }

    const startIdx = (currentRankPage - 1) * rankPageSize;
    const endIdx = Math.min(startIdx + rankPageSize, totalRows);

    // Set visibilitas baris tabel
    const visibleSet = new Set(filteredRows.slice(startIdx, endIdx));
    allRows.forEach(row => {
        if (visibleSet.has(row)) {
            row.classList.remove('d-none');
        } else {
            row.classList.add('d-none');
        }
    });

    // Perbarui teks info pagination
    const startTxt = totalRows > 0 ? (startIdx + 1) : 0;
    const elStart = document.getElementById('rankStartIdx');
    const elEnd = document.getElementById('rankEndIdx');
    const elTotal = document.getElementById('rankTotalCount');
    if (elStart) elStart.textContent = startTxt;
    if (elEnd) elEnd.textContent = endIdx;
    if (elTotal) elTotal.textContent = totalRows;

    // Perbarui status tombol Sebelumnya & Selanjutnya
    const prevLi = document.getElementById('rankPagePrev');
    const nextLi = document.getElementById('rankPageNext');
    if (prevLi) {
        prevLi.classList.toggle('disabled', currentRankPage <= 1);
        const prevBtn = prevLi.querySelector('button');
        if (prevBtn) prevBtn.disabled = (currentRankPage <= 1);
    }
    if (nextLi) {
        nextLi.classList.toggle('disabled', currentRankPage >= totalPages);
        const nextBtn = nextLi.querySelector('button');
        if (nextBtn) nextBtn.disabled = (currentRankPage >= totalPages);
    }

    // Render tombol-tombol nomor halaman
    renderRankPageNumbers(totalPages);
}

function renderRankPageNumbers(totalPages) {
    const ul = document.getElementById('rankPaginationUl');
    const nextLi = document.getElementById('rankPageNext');
    if (!ul || !nextLi) return;

    // Hapus nomor halaman lama (selain tombol Prev dan Next)
    ul.querySelectorAll('.rank-dynamic-page').forEach(el => el.remove());

    if (totalPages <= 1) return;

    // Tentukan range halaman yang ditampilkan (maks 5 halaman)
    let startPage = Math.max(1, currentRankPage - 2);
    let endPage = Math.min(totalPages, startPage + 4);
    if (endPage - startPage < 4) {
        startPage = Math.max(1, endPage - 4);
    }

    // Tombol halaman 1 jika startPage > 1
    if (startPage > 1) {
        const li1 = createPageLi(1);
        ul.insertBefore(li1, nextLi);
        if (startPage > 2) {
            const liDots = document.createElement('li');
            liDots.className = 'page-item disabled rank-dynamic-page';
            liDots.innerHTML = '<span class="page-link border-0 px-1">...</span>';
            ul.insertBefore(liDots, nextLi);
        }
    }

    for (let p = startPage; p <= endPage; p++) {
        const li = createPageLi(p);
        ul.insertBefore(li, nextLi);
    }

    // Tombol halaman terakhir jika endPage < totalPages
    if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
            const liDots = document.createElement('li');
            liDots.className = 'page-item disabled rank-dynamic-page';
            liDots.innerHTML = '<span class="page-link border-0 px-1">...</span>';
            ul.insertBefore(liDots, nextLi);
        }
        const liLast = createPageLi(totalPages);
        ul.insertBefore(liLast, nextLi);
    }
}

function createPageLi(pageNum) {
    const li = document.createElement('li');
    li.className = `page-item rank-dynamic-page ${pageNum === currentRankPage ? 'active' : ''}`;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'page-link rounded-2 px-2';
    btn.textContent = pageNum;
    btn.onclick = () => goToRankPage(pageNum);
    li.appendChild(btn);
    return li;
}

function goToRankPage(pageNum) {
    currentRankPage = pageNum;
    updateRankPagination();
    // Scroll halus ke kartu tabel jika di layar ponsel/tabel di bawah
    const tableEl = document.getElementById('customerRankingTable');
    if (tableEl) {
        tableEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
}

function changeRankPage(delta) {
    const filteredRows = getFilteredRankRows();
    const totalPages = Math.max(1, Math.ceil(filteredRows.length / rankPageSize));
    const newPage = currentRankPage + delta;
    if (newPage >= 1 && newPage <= totalPages) {
        goToRankPage(newPage);
    }
}

function filterCustomerRanking(tier) {
    currentRankTier = tier;
    currentRankPage = 1;

    document.querySelectorAll('.rank-filter-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-tier') === tier);
    });

    updateRankPagination();
}

function toggleCustomerRankOrder() {
    rankAscending = !rankAscending;
    const tbody = document.getElementById('customerRankingTbody');
    const label = document.getElementById('rankOrderLabel');
    if (!tbody) return;

    const rows = Array.from(tbody.querySelectorAll('.ranking-row'));
    rows.sort((a, b) => {
        const rA = parseInt(a.getAttribute('data-rank'), 10) || 0;
        const rB = parseInt(b.getAttribute('data-rank'), 10) || 0;
        return rankAscending ? (rA - rB) : (rB - rA);
    });
    rows.forEach(r => tbody.appendChild(r));

    if (label) {
        label.textContent = rankAscending
            ? 'Urutan: Tepat Waktu → Paling Telat'
            : 'Urutan: Paling Telat / Bermasalah → Tepat Waktu';
    }

    currentRankPage = 1;
    updateRankPagination();
}
</script>

<%- include('partials/footer') %>
