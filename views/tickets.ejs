                <small class="text-dark">Teknisi dapat login menggunakan <strong>Username</strong> atau <strong>Nomor WhatsApp</strong> di halaman login tab <strong>Portal Teknisi</strong> (<code>/teknisi</code>). Teknisi hanya dapat mengakses menu <strong>Tiket Gangguan</strong>.</small>
            </div>
            <a href="/teknisi" target="_blank" class="btn btn-sm btn-dark fw-semibold">
                <i class="fas fa-external-link-alt me-1"></i>Lihat Halaman Portal Teknisi
            </a>
        </div>

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-user-plus text-primary me-2"></i>Tambah Teknisi & Akun Login</h6>
                    </div>
                    <div class="card-body">
                        <form action="/tickets/technicians/add" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Nama Teknisi <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control" placeholder="Contoh: Kang Asep (Teknisi)" required>
                            </div>
                            <div class="mb-3">
