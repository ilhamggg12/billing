                                <div class="form-text">Menerima pesan WA otomatis saat ada laporan gangguan baru.</div>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold small">Username Login <span class="text-danger">*</span></label>
                                    <input type="text" name="username" class="form-control form-control-sm" placeholder="Contoh: asep" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold small">Password Login <span class="text-danger">*</span></label>
                                    <input type="text" name="password" class="form-control form-control-sm" value="teknisi123" placeholder="Password" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Jabatan / Area Tugas</label>
                                <input type="text" name="role" class="form-control" value="Teknisi Lapangan" placeholder="Teknisi Lapangan / Splicer / NOC">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Catatan</label>
                                <textarea name="notes" class="form-control" rows="2" placeholder="Keterangan tambahan (opsional)"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-save me-1"></i>Simpan Teknisi & Buat Akun
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-users-cog text-primary me-2"></i>Daftar Teknisi Lapangan & Akun Portal</h6>
                    </div>
                    <div class="card-body">
                        <% if (technicians.length === 0) { %>
                            <div class="alert alert-warning mb-0">
                                <i class="fas fa-info-circle me-2"></i>Belum ada data teknisi terdaftar. Silakan tambahkan nama dan nomor WhatsApp teknisi di formulir sebelah kiri.
                            </div>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Nama Teknisi</th>
                                            <th>Username Login</th>
                                            <th>Nomor WhatsApp</th>
                                            <th>Jabatan / Area</th>
                                            <th>Status</th>
                                            <th class="text-end">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% technicians.forEach(tech => { %>
                                        <tr>
                                            <td class="fw-bold"><%= tech.name %></td>
                                            <td>
                                                <span class="badge bg-dark font-monospace">
                                                    <i class="fas fa-user-lock me-1"></i><%= tech.username || tech.phone %>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                                    <i class="fab fa-whatsapp me-1"></i><%= tech.phone %>
                                                </span>
                                            </td>
                                            <td>
                                                <div><%= tech.role || 'Teknisi Lapangan' %></div>
                                                <% if (tech.notes) { %>
                                                    <small class="text-muted"><%= tech.notes %></small>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (tech.is_active) { %>
                                                    <span class="badge bg-success">Aktif</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Nonaktif</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        onclick="openEditTechModal('<%= tech.id %>', '<%= (tech.username || '').replace(/'/g, '') %>', '<%= tech.name.replace(/'/g, '') %>', '<%= tech.phone %>', '<%= (tech.role || '').replace(/'/g, '') %>', '<%= tech.is_active %>', '<%= (tech.notes || '').replace(/'/g, '') %>')">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <form action="/tickets/technicians/<%= tech.id %>/delete" method="POST" class="d-inline">
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================== -->
    <!-- TAB 4: TEMPLATE NOTIFIKASI WHATSAPP TIKET -->
    <!-- ================================================================== -->
    <div class="tab-pane fade" id="tab-templates" role="tabpanel">
        <form action="/tickets/templates/save" method="POST">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="fab fa-whatsapp text-success me-2"></i>Pengaturan Template Pesan WhatsApp Tiket Gangguan</h6>
                        <small class="text-muted">Kustomisasi isi pesan otomatis untuk setiap tahapan penanganan tiket gangguan</small>
