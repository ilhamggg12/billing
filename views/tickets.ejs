<!-- ====================================================================== -->
<!-- MODAL 1: BUAT TIKET GANGGUAN BARU (+ WA TEKNISI + FOTO LAPORAN) -->
<!-- ====================================================================== -->
<div class="modal fade" id="modalCreateTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form action="/tickets" method="POST" enctype="multipart/form-data">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-plus-circle me-2"></i>Buat Tiket Laporan Gangguan Baru
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Pilih Pelanggan -->
                        <div class="col-12">
                            <label class="form-label fw-bold">Pilih Pelanggan yang Mengalami Gangguan <span class="text-danger">*</span></label>
                            <select name="customer_id" id="createTicketCustomerSelect" class="form-select" onchange="onSelectTicketCustomer(this)">
                                <option value="">-- Pilih dari Daftar Pelanggan --</option>
                                <% customers.forEach(c => { %>
                                    <option value="<%= c.id %>"
                                            data-name="<%= c.name %>"
                                            data-phone="<%= c.phone || '' %>"
                                            data-address="<%= c.address || '' %>"
                                            data-pppoe="<%= c.pppoe_username || '' %>">
                                        <%= c.name %> (<%= c.customer_id || '-' %>) - <%= c.address || 'Tanpa alamat' %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Nama Pelanggan <span class="text-danger">*</span></label>
                            <input type="text" name="manual_customer_name" id="createCustName" class="form-control" placeholder="Nama Pelanggan" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Nomor WhatsApp Pelanggan <span class="text-danger">*</span></label>
                            <input type="text" name="manual_customer_phone" id="createCustPhone" class="form-control" placeholder="08xxxxxxxxxx">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Alamat Lokasi Pelanggan</label>
                            <input type="text" name="manual_customer_address" id="createCustAddress" class="form-control" placeholder="Alamat lengkap pemasangan pelanggan">
                        </div>

                        <!-- Kategori & Prioritas -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Kategori Gangguan</label>
                            <select name="category" class="form-select">
                                <option value="Koneksi Terputus (LOS Merah)">Koneksi Terputus (LOS Merah)</option>
                                <option value="Internet Lambat / Putus-Nyambung">Internet Lambat / Putus-Nyambung</option>
                                <option value="Kabel Dropcore Putus">Kabel Dropcore Putus</option>
                                <option value="Modem / ONT Bermasalah / Restart">Modem / ONT Bermasalah / Restart</option>
                                <option value="Ganti Password / Setting WiFi">Ganti Password / Setting WiFi</option>
                                <option value="Gangguan ODP / Jalur Distribusi">Gangguan ODP / Jalur Distribusi</option>
                                <option value="Lainnya">Lainnya</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Prioritas Penanganan</label>
                            <select name="priority" class="form-select">
                                <option value="critical">Darurat (Critical / LOS Mati Total)</option>
                                <option value="high">Tinggi (Urgent)</option>
                                <option value="medium" selected>Sedang (Normal)</option>
                                <option value="low">Rendah (Low)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Detail Keluhan / Laporan Gangguan <span class="text-danger">*</span></label>
                            <textarea name="description" class="form-control" rows="3" placeholder="Jelaskan keluhan pelanggan, misal: Lampu indikator LOS pada modem berkedip merah sejak pagi..." required></textarea>
                        </div>

                        <!-- Pilih Teknisi Tujuan WhatsApp -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded border">
                                <label class="form-label fw-bold text-primary mb-2">
                                    <i class="fas fa-user-cog me-1"></i>Tugaskan & Kirim WhatsApp ke Teknisi
                                </label>
                                <select name="technician_select" id="createTechSelect" class="form-select mb-2" onchange="toggleCustomTechInput(this, 'createCustomTechBox')">
                                    <% if (technicians.length > 0) { %>
                                        <option value="all">Kirim ke Semua Teknisi Aktif (<%= technicians.filter(t => t.is_active).length %> Teknisi)</option>
                                        <% technicians.filter(t => t.is_active).forEach(tech => { %>
                                            <option value="<%= tech.id %>"><%= tech.name %> (<%= tech.phone %> - <%= tech.role %>)</option>
                                        <% }) %>
                                    <% } %>
                                    <option value="custom" <%= technicians.length === 0 ? 'selected' : '' %>>Input Nomor WA Teknisi Manual...</option>
                                </select>

                                <div id="createCustomTechBox" class="row g-2 mt-1 <%= technicians.length === 0 ? '' : 'd-none' %>">
                                    <div class="col-md-6">
                                        <input type="text" name="custom_tech_name" class="form-control form-control-sm" placeholder="Nama Teknisi (misal: Kang Asep)">
                                    </div>
                                    <div class="col-md-6">
                                        <input type="text" name="custom_tech_phone" class="form-control form-control-sm" placeholder="Nomor WA Teknisi (08xxxx)">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Lampiran Foto Laporan Awal -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded border">
                                <label class="form-label fw-bold mb-1">
                                    <i class="fas fa-camera text-danger me-1"></i>Lampirkan Foto Laporan Gangguan (Arsip)
                                </label>
                                <input type="file" name="photos" class="form-control mb-2" accept="image/*" multiple onchange="previewUploadImages(this, 'previewCreatePhotos')">
                                <input type="text" name="photo_caption" class="form-control form-control-sm" placeholder="Keterangan foto (misal: Foto lampu modem LOS merah dari pelanggan)">
                                <div id="previewCreatePhotos" class="d-flex flex-wrap gap-2 mt-2"></div>
                            </div>
                        </div>

                        <!-- Opsi Kirim WA -->
                        <div class="col-12">
                            <div class="d-flex flex-wrap gap-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="send_wa_tech" id="sendWaTechNew" value="true" checked>
                                    <label class="form-check-label fw-semibold" for="sendWaTechNew">
                                        <i class="fab fa-whatsapp text-success me-1"></i>Kirim Notifikasi WA ke Teknisi
                                    </label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="send_photo_wa" id="sendPhotoWaNew" value="true" checked>
                                    <label class="form-check-label fw-semibold" for="sendPhotoWaNew">
                                        Sertakan Foto ke WA Teknisi
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-paper-plane me-1"></i>Buat Tiket & Kirim WA Teknisi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ====================================================================== -->
<!-- MODAL 2: TEKNISI TERIMA TIKET (-> WA KE PELANGGAN) -->
<!-- ====================================================================== -->
<div class="modal fade" id="modalAcceptTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="formAcceptTicket" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="redirect_to" value="/tickets">
                <div class="modal-header bg-info text-dark">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-user-check me-2"></i>Terima Tiket Gangguan (<span id="acceptTicketNum"></span>)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="fab fa-whatsapp me-1"></i>Pelanggan (<strong id="acceptCustName"></strong>) akan menerima notifikasi WhatsApp bahwa tiket gangguan telah diterima oleh teknisi.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Teknisi yang Menerima & Menangani</label>
                        <select name="technician_select" id="acceptTechSelect" class="form-select mb-2" onchange="toggleCustomTechInput(this, 'acceptCustomTechBox')">
                            <% technicians.forEach(tech => { %>
                                <option value="<%= tech.id %>"><%= tech.name %> (<%= tech.phone %>)</option>
                            <% }) %>
                            <option value="custom">Input Nama & Nomor Teknisi Manual...</option>
                        </select>
                        <div id="acceptCustomTechBox" class="row g-2 <%= technicians.length === 0 ? '' : 'd-none' %>">
                            <div class="col-6">
                                <input type="text" name="custom_tech_name" id="acceptCustomTechName" class="form-control form-control-sm" placeholder="Nama Teknisi">
                            </div>
                            <div class="col-6">
                                <input type="text" name="custom_tech_phone" id="acceptCustomTechPhone" class="form-control form-control-sm" placeholder="No. HP Teknisi">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Catatan / Estimasi Penanganan</label>
                        <textarea name="note" class="form-control" rows="3">Tiket gangguan Anda telah kami terima. Tim teknisi sedang bersiap menuju lokasi / melakukan pengecekan jalur jaringan.</textarea>
                    </div>

                    <div class="mb-3 p-2 bg-light rounded border">
                        <label class="form-label fw-semibold small mb-1"><i class="fas fa-camera text-primary me-1"></i>Lampirkan Foto (Opsional)</label>
                        <input type="file" name="photos" class="form-control form-control-sm mb-1" accept="image/*" multiple onchange="previewUploadImages(this, 'previewAcceptPhotos')">
