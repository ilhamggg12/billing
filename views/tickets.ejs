<script>
    // Buka tab otomatis berdasarkan URL hash (#tab-technicians, #tab-archive, #tab-templates)
    document.addEventListener('DOMContentLoaded', function() {
        const hash = window.location.hash;
        if (hash === '#tab-technicians') switchTicketTab('tab-technicians-btn');
        else if (hash === '#tab-archive') switchTicketTab('tab-archive-btn');
        else if (hash === '#tab-templates') switchTicketTab('tab-templates-btn');
    });

    function switchTicketTab(btnId) {
        const btn = document.getElementById(btnId);
        if (btn && window.bootstrap) {
            const tab = new bootstrap.Tab(btn);
            tab.show();
        }
    }

    function onSelectTicketCustomer(selectEl) {
        const opt = selectEl.options[selectEl.selectedIndex];
        if (!opt || !opt.value) return;
        document.getElementById('createCustName').value = opt.getAttribute('data-name') || '';
        document.getElementById('createCustPhone').value = opt.getAttribute('data-phone') || '';
        document.getElementById('createCustAddress').value = opt.getAttribute('data-address') || '';
    }

    function toggleCustomTechInput(selectEl, boxId) {
        const box = document.getElementById(boxId);
        if (!box) return;
        if (selectEl.value === 'custom') {
            box.classList.remove('d-none');
        } else {
            box.classList.add('d-none');
        }
    }

    function previewUploadImages(input, containerId) {
        const container = document.getElementById(containerId);
        if (!container) return;
        container.innerHTML = '';
        if (!input.files || input.files.length === 0) return;

        Array.from(input.files).forEach(file => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.className = 'rounded border shadow-xs';
                img.style.width = '68px';
                img.style.height = '68px';
                img.style.objectFit = 'cover';
                container.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    }

    const loggedInTechId = '<%= (isTechUser && user.technician_id) ? user.technician_id : "" %>';
    const loggedInTechName = '<%= (isTechUser && user.name) ? user.name.replace(/'/g, "") : "" %>';

    function openAcceptModal(id, ticketNum, custName, techId, techName, techPhone) {
        document.getElementById('formAcceptTicket').action = '/tickets/' + id + '/accept';
        document.getElementById('acceptTicketNum').textContent = ticketNum;
        document.getElementById('acceptCustName').textContent = custName;

        const targetTechId = loggedInTechId || techId;
        const targetTechName = loggedInTechName || techName;

        const techSelect = document.getElementById('acceptTechSelect');
        if (targetTechId && techSelect.querySelector('option[value="' + targetTechId + '"]')) {
            techSelect.value = targetTechId;
            toggleCustomTechInput(techSelect, 'acceptCustomTechBox');
        } else if (targetTechName) {
            techSelect.value = 'custom';
            toggleCustomTechInput(techSelect, 'acceptCustomTechBox');
            document.getElementById('acceptCustomTechName').value = targetTechName;
            document.getElementById('acceptCustomTechPhone').value = techPhone || '';
        }

        new bootstrap.Modal(document.getElementById('modalAcceptTicket')).show();
    }

    function openProgressModal(id, ticketNum, custName, techName) {
        document.getElementById('formProgressTicket').action = '/tickets/' + id + '/progress';
        document.getElementById('progressTicketNum').textContent = ticketNum;
        document.getElementById('progressCustName').textContent = custName;
        document.getElementById('progressTechName').value = loggedInTechName || techName || 'Tim Teknisi';
        new bootstrap.Modal(document.getElementById('modalProgressTicket')).show();
    }

    function setProgressTemplate(title, note) {
        document.getElementById('progressTitleInput').value = title;
        document.getElementById('progressNoteInput').value = note;
    }

    function openResolveModal(id, ticketNum, custName, techName) {
        document.getElementById('formResolveTicket').action = '/tickets/' + id + '/resolve';
        document.getElementById('resolveTicketNum').textContent = ticketNum;
        document.getElementById('resolveCustName').textContent = custName;
        document.getElementById('resolveTechName').value = loggedInTechName || techName || 'Tim Teknisi';
        new bootstrap.Modal(document.getElementById('modalResolveTicket')).show();
    }

    function setResolveNote(note) {
        document.getElementById('resolveNoteInput').value = note;
    }

    function openEditTechModal(id, username, name, phone, role, isActive, notes) {
        document.getElementById('formEditTech').action = '/tickets/technicians/' + id + '/edit';
        document.getElementById('editTechUsername').value = username || phone;
        document.getElementById('editTechName').value = name;
        document.getElementById('editTechPhone').value = phone;
        document.getElementById('editTechRole').value = role;
        document.getElementById('editTechActive').value = String(isActive) === '1' ? '1' : '0';
        document.getElementById('editTechNotes').value = notes || '';
        new bootstrap.Modal(document.getElementById('modalEditTech')).show();
    }

    function previewTicketPhoto(filePath, title) {
        document.getElementById('photoPreviewImg').src = filePath;
        document.getElementById('photoPreviewTitle').textContent = title || 'Foto Arsip Tiket Gangguan';
        document.getElementById('photoPreviewDownload').href = filePath;
        new bootstrap.Modal(document.getElementById('modalPhotoPreview')).show();
    }

    function filterArchivePhotos() {
        const stage = document.getElementById('archiveStageFilter').value;
        document.querySelectorAll('.archive-photo-item').forEach(item => {
            if (stage === 'all' || item.getAttribute('data-stage') === stage) {
                item.classList.remove('d-none');
            } else {
                item.classList.add('d-none');
            }
        });
    }
</script>

