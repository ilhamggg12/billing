<%- include('partials/header', { title: 'Tiket Gangguan', activePage: 'tickets' }) %>
<% const isTechUser = (typeof user !== 'undefined' && user && (user.role === 'technician' || user.role === 'teknisi')); %>

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="fas fa-headset text-primary me-2"></i><%= isTechUser ? 'Portal Penanganan Tiket Gangguan' : 'Tiket Gangguan & Helpdesk' %>
        </h4>
        <p class="text-muted small mb-0">
            <%= isTechUser ? `Selamat bertugas, ${user.name || user.username}! Pilih tiket di bawah untuk menerima tugas, update progress lapangan, dan upload foto dokumentasi.` : 'Kelola laporan gangguan pelanggan, notifikasi WhatsApp otomatis ke teknisi & pelanggan, serta arsip foto pengerjaan' %>
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <% if (!isTechUser) { %>
        <button type="button" class="btn btn-outline-primary" onclick="switchTicketTab('tab-technicians-btn')">
            <i class="fas fa-user-cog me-1"></i>Data & Akun Teknisi (<%= technicians.length %>)
        </button>
        <% } %>
        <button type="button" class="btn btn-outline-secondary" onclick="switchTicketTab('tab-archive-btn')">
            <i class="fas fa-images me-1"></i>Arsip Foto (<%= stats.totalPhotos %>)
        </button>
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateTicket">
            <i class="fas fa-plus-circle me-1"></i>Buat Tiket Gangguan
        </button>
    </div>
</div>

<!-- Alur Kerja Otomatis Banner -->
<div class="card border-0 shadow-sm mb-4 bg-white">
    <div class="card-body py-3 px-4">
        <div class="row g-3 align-items-center text-center text-md-start">
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
                        <i class="fas fa-Exclamation-triangle fa-bell"></i>
                    </div>
                    <div>
                        <div class="badge bg-danger mb-1">1. Laporan Masuk</div>
                        <div class="small text-muted lh-sm">Otomatis kirim <strong>WA ke Nomor Teknisi</strong> + Foto Laporan</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div>
                        <div class="badge bg-info text-dark mb-1">2. Diterima Teknisi</div>
                        <div class="small text-muted lh-sm">Otomatis kirim <strong>WA ke Pelanggan</strong> bahwa tiket diterima</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
                        <i class="fas fa-tools"></i>
                    </div>
                    <div>
                        <div class="badge bg-warning text-dark mb-1">3. Sedang Ditangani</div>
                        <div class="small text-muted lh-sm">Kirim <strong>WA Progress Pengerjaan</strong> + Foto ke Pelanggan</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
                        <i class="fas fa-check-double"></i>
                    </div>
                    <div>
                        <div class="badge bg-success mb-1">4. Gangguan Selesai</div>
                        <div class="small text-muted lh-sm">Kirim <strong>WA Selesai & Bukti Foto</strong> ke Pelanggan & Arsip</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Statistik Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card border-primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Total Tiket</div>
                        <div class="stat-value text-primary"><%= stats.total %></div>
                        <small class="text-muted"><i class="fas fa-camera me-1"></i><%= stats.totalPhotos %> Foto Arsip</small>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card border-danger h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Menunggu Teknisi</div>
                        <div class="stat-value text-danger"><%= stats.open %></div>
                        <small class="text-danger">Belum diterima teknisi</small>
                    </div>
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card border-warning h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Diterima & Proses</div>
                        <div class="stat-value text-warning"><%= stats.accepted + stats.in_progress %></div>
                        <small class="text-muted"><%= stats.accepted %> diterima, <%= stats.in_progress %> dikerjakan</small>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="fas fa-tools"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card border-success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Gangguan Selesai</div>
                        <div class="stat-value text-success"><%= stats.resolved %></div>
                        <small class="text-success">Normal kembali</small>
                    </div>
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="fas fa-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Navigation Tabs -->
<% const openRecapTab = (typeof techRecap !== 'undefined' && techRecap && techRecap.filters && techRecap.filters.range === 'custom'); %>
<ul class="nav nav-pills mb-3 gap-2 bg-white p-2 rounded-3 shadow-sm border" id="ticketTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= !openRecapTab ? 'active' : '' %> fw-semibold" id="tab-list-btn" data-bs-toggle="pill" data-bs-target="#tab-list" type="button" role="tab">
            <i class="fas fa-list-ul me-1"></i>Daftar Tiket Gangguan
            <span class="badge bg-white text-primary ms-1"><%= tickets.length %></span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= openRecapTab ? 'active' : '' %> fw-semibold" id="tab-recap-btn" data-bs-toggle="pill" data-bs-target="#tab-recap" type="button" role="tab">
            <i class="fas fa-clipboard-check me-1"></i>Rekap Pengerjaan Teknisi
            <% if (typeof techRecap !== 'undefined' && techRecap && techRecap.summary) { %>
                <span class="badge bg-success ms-1"><%= techRecap.summary.month.total %></span>
            <% } %>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="tab-archive-btn" data-bs-toggle="pill" data-bs-target="#tab-archive" type="button" role="tab">
            <i class="fas fa-images me-1"></i>Arsip Foto Gangguan & Pelaporan
            <span class="badge bg-secondary ms-1"><%= stats.totalPhotos %></span>
        </button>
    </li>
    <% if (!isTechUser) { %>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="tab-technicians-btn" data-bs-toggle="pill" data-bs-target="#tab-technicians" type="button" role="tab">
            <i class="fas fa-user-cog me-1"></i>Data Teknisi & Akun Login
            <span class="badge bg-secondary ms-1"><%= technicians.length %></span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="tab-templates-btn" data-bs-toggle="pill" data-bs-target="#tab-templates" type="button" role="tab">
            <i class="fab fa-whatsapp me-1"></i>Template WA Otomatis
        </button>
    </li>
    <% } %>
</ul>

<div class="tab-content" id="ticketTabsContent">
    <!-- ================================================================== -->
    <!-- TAB 1: DAFTAR TIKET GANGGUAN -->
    <!-- ================================================================== -->
    <div class="tab-pane fade <%= !openRecapTab ? 'show active' : '' %>" id="tab-list" role="tabpanel">
        <!-- Filter Bar -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-3">
                <form method="GET" action="/tickets" class="row g-2 align-items-end">
                    <div class="col-sm-4 col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Status Tiket</label>
                        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Semua Status</option>
                            <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>1. Baru / Menunggu Teknisi</option>
                            <option value="accepted" <%= filters.status === 'accepted' ? 'selected' : '' %>>2. Diterima Teknisi</option>
                            <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>3. Sedang Ditangani</option>
                            <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>>4. Selesai (Resolved)</option>
                        </select>
                    </div>
                    <div class="col-sm-4 col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Prioritas</label>
                        <select name="priority" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="all" <%= filters.priority === 'all' ? 'selected' : '' %>>Semua Prioritas</option>
                            <option value="critical" <%= filters.priority === 'critical' ? 'selected' : '' %>>Darurat (Critical / LOS)</option>
                            <option value="high" <%= filters.priority === 'high' ? 'selected' : '' %>>Tinggi (Urgent)</option>
                            <option value="medium" <%= filters.priority === 'medium' ? 'selected' : '' %>>Sedang (Normal)</option>
                            <option value="low" <%= filters.priority === 'low' ? 'selected' : '' %>>Rendah (Low)</option>
                        </select>
                    </div>
                    <div class="col-sm-4 col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Teknisi</label>
                        <select name="technician" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="all" <%= filters.technician === 'all' ? 'selected' : '' %>>Semua Teknisi</option>
                            <% technicians.forEach(tech => { %>
                                <option value="<%= tech.id %>" <%= String(filters.technician) === String(tech.id) ? 'selected' : '' %>><%= tech.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-sm-12 col-md-3 d-flex gap-2">
                        <a href="/tickets" class="btn btn-sm btn-light border w-100"><i class="fas fa-sync-alt me-1"></i>Reset Filter</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabel Tiket -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle datatable w-100">
                    <thead class="table-light">
                        <tr>
                            <th>No. Tiket</th>
                            <th>Pelanggan</th>
                            <th>Kategori & Keluhan</th>
                            <th>Teknisi & Notifikasi WA</th>
                            <th>Arsip Foto</th>
                            <th>Status</th>
                            <th class="text-end">Aksi Penanganan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% tickets.forEach(t => { 
                            const tPhotos = photosByTicket[t.id] || [];
                        %>
                        <tr>
                            <td>
                                <a href="/tickets/<%= t.id %>" class="fw-bold text-primary text-decoration-none d-block">
                                    <%= t.ticket_number %>
                                </a>
                                <small class="text-muted d-block" style="font-size: 0.74rem;">
                                    <i class="far fa-clock me-1"></i><%= moment(t.created_at).format('DD/MM/YYYY HH:mm') %>
                                </small>
                                <% if (t.priority === 'critical') { %>
                                    <span class="badge bg-danger mt-1" style="font-size: 0.68rem;"><i class="fas fa-bolt me-1"></i>DARURAT / LOS</span>
                                <% } else if (t.priority === 'high') { %>
                                    <span class="badge bg-warning text-dark mt-1" style="font-size: 0.68rem;">TINGGI</span>
                                <% } else if (t.priority === 'medium') { %>
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info mt-1" style="font-size: 0.68rem;">SEDANG</span>
                                <% } else { %>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary mt-1" style="font-size: 0.68rem;">RENDAH</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="fw-bold text-dark"><%= t.customer_name %></div>
                                <% if (t.customer_code) { %>
                                    <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;"><%= t.customer_code %></span>
                                <% } %>
                                <% if (t.customer_phone) { %>
                                    <div class="small text-muted mt-1">
                                        <i class="fab fa-whatsapp text-success me-1"></i><%= t.customer_phone %>
                                    </div>
                                <% } %>
                                <% if (t.customer_address) { %>
                                    <div class="small text-muted text-truncate" style="max-width: 200px;" title="<%= t.customer_address %>">
                                        <i class="fas fa-map-marker-alt text-danger me-1"></i><%= t.customer_address %>
                                    </div>
                                <% } %>
                                <% if (t.latitude && t.longitude) { %>
                                    <a href="https://www.google.com/maps?q=<%= t.latitude %>,<%= t.longitude %>" target="_blank" class="badge bg-primary bg-opacity-10 text-primary text-decoration-none mt-1">
                                        <i class="fas fa-location-arrow me-1"></i>Buka Maps
                                    </a>
                                <% } %>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark"><%= t.category %></div>
                                <div class="small text-secondary" style="max-width: 240px; white-space: normal;">
                                    <%= t.description || t.subject %>
                                </div>
                                <% if (t.resolution_notes && t.status === 'resolved') { %>
                                    <div class="mt-1 p-1 px-2 bg-success bg-opacity-10 border border-success border-opacity-25 rounded small text-success" style="font-size: 0.74rem;">
                                        <strong><i class="fas fa-check me-1"></i>Solusi:</strong> <%= t.resolution_notes %>
                                    </div>
                                <% } %>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark mb-1">
                                    <i class="fas fa-user-cog text-primary me-1"></i><%= t.technician_name || 'Belum Ditentukan' %>
                                </div>
                                <% if (t.technician_phone) { %>
                                    <div class="small text-muted mb-1" style="font-size: 0.73rem;"><%= t.technician_phone %></div>
                                <% } %>
                                <!-- Indikator Status Notifikasi WA -->
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <span class="badge <%= t.wa_tech_sent ? 'bg-success' : 'bg-secondary bg-opacity-25 text-muted' %>" style="font-size: 0.65rem;" title="Notifikasi WA Laporan ke Teknisi">
                                        <i class="fab fa-whatsapp me-1"></i>Teknisi <%= t.wa_tech_sent ? '✓' : '✗' %>
                                    </span>
                                    <span class="badge <%= t.wa_accepted_sent ? 'bg-info text-dark' : 'bg-secondary bg-opacity-25 text-muted' %>" style="font-size: 0.65rem;" title="Notifikasi WA Diterima ke Pelanggan">
                                        Diterima <%= t.wa_accepted_sent ? '✓' : '✗' %>
                                    </span>
                                    <span class="badge <%= t.wa_progress_sent ? 'bg-warning text-dark' : 'bg-secondary bg-opacity-25 text-muted' %>" style="font-size: 0.65rem;" title="Notifikasi WA Progress ke Pelanggan">
                                        Progress <%= t.wa_progress_sent ? `(${t.wa_progress_sent})` : '✗' %>
                                    </span>
                                    <span class="badge <%= t.wa_resolved_sent ? 'bg-success' : 'bg-secondary bg-opacity-25 text-muted' %>" style="font-size: 0.65rem;" title="Notifikasi WA Selesai ke Pelanggan">
                                        Selesai <%= t.wa_resolved_sent ? '✓' : '✗' %>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <% if (tPhotos.length > 0) { %>
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <% tPhotos.slice(0, 2).forEach(ph => { %>
                                            <img src="<%= ph.file_path %>" alt="Foto Tiket"
                                                 class="rounded border shadow-xs cursor-pointer"
                                                 style="width: 42px; height: 42px; object-fit: cover; cursor: pointer;"
                                                 onclick="previewTicketPhoto('<%= ph.file_path %>', '<%= t.ticket_number %> - <%= (ph.caption || '').replace(/'/g, '') %>')">
                                        <% }) %>
                                        <% if (tPhotos.length > 2) { %>
                                            <a href="/tickets/<%= t.id %>" class="badge bg-dark text-decoration-none">+<%= tPhotos.length - 2 %></a>
                                        <% } %>
                                    </div>
                                    <small class="text-muted d-block mt-1" style="font-size: 0.7rem;">
                                        <i class="fas fa-camera me-1"></i><%= tPhotos.length %> Foto Arsip
                                    </small>
                                <% } else { %>
                                    <span class="text-muted small"><i class="far fa-image me-1"></i>Belum ada foto</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (t.status === 'open') { %>
                                    <span class="badge bg-danger px-2 py-1"><i class="fas fa-bell me-1"></i>1. BARU / MENUNGGU</span>
                                <% } else if (t.status === 'accepted') { %>
                                    <span class="badge bg-info text-dark px-2 py-1"><i class="fas fa-user-check me-1"></i>2. DITERIMA TEKNISI</span>
                                <% } else if (t.status === 'in_progress') { %>
                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="fas fa-tools me-1"></i>3. SEDANG DITANGANI</span>
                                <% } else { %>
                                    <span class="badge bg-success px-2 py-1"><i class="fas fa-check-circle me-1"></i>4. SELESAI</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <% if (t.status === 'open') { %>
                                        <button type="button" class="btn btn-sm btn-info text-dark fw-semibold"
                                                onclick="openAcceptModal('<%= t.id %>', '<%= t.ticket_number %>', '<%= t.customer_name.replace(/'/g, '') %>', '<%= t.technician_id || '' %>', '<%= (t.technician_name || '').replace(/'/g, '') %>', '<%= t.technician_phone || '' %>')"
                                                title="Teknisi Terima Tiket & Kirim WA ke Pelanggan">
                                            <i class="fas fa-hand-paper me-1"></i>Terima Tiket
                                        </button>
                                    <% } %>

                                    <% if (t.status === 'open' || t.status === 'accepted' || t.status === 'in_progress') { %>
                                        <button type="button" class="btn btn-sm btn-warning text-dark fw-semibold"
                                                onclick="openProgressModal('<%= t.id %>', '<%= t.ticket_number %>', '<%= t.customer_name.replace(/'/g, '') %>', '<%= (t.technician_name || '').replace(/'/g, '') %>')"
                                                title="Update Progress Pengerjaan & Kirim WA ke Pelanggan">
                                            <i class="fas fa-tools me-1"></i>Update Progress
                                        </button>
                                        <button type="button" class="btn btn-sm btn-success fw-semibold"
                                                onclick="openResolveModal('<%= t.id %>', '<%= t.ticket_number %>', '<%= t.customer_name.replace(/'/g, '') %>', '<%= (t.technician_name || '').replace(/'/g, '') %>')"
                                                title="Tandai Selesai & Kirim WA Selesai ke Pelanggan">
                                            <i class="fas fa-check-double me-1"></i>Selesai
                                        </button>
                                    <% } %>

                                    <a href="/tickets/<%= t.id %>" class="btn btn-sm btn-outline-primary" title="Detail Timeline & Arsip Foto">
                                        <i class="fas fa-eye me-1"></i>Detail
                                    </a>

                                    <% if (!isTechUser) { %>
                                    <form action="/tickets/<%= t.id %>/delete" method="POST" class="d-inline">
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete" title="Hapus Tiket">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================================================================== -->
    <!-- TAB 2: GALERI ARSIP FOTO GANGGUAN & PELAPORAN -->
    <!-- ================================================================== -->
    <div class="tab-pane fade" id="tab-archive" role="tabpanel">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h6 class="fw-bold mb-0"><i class="fas fa-camera-retro text-primary me-2"></i>Arsip Foto Tiket Gangguan & Dokumentasi Teknis</h6>
                    <small class="text-muted">Seluruh foto lampiran dari laporan pelanggan, proses perbaikan, hingga bukti selesai</small>
                </div>
                <div class="d-flex gap-2">
                    <select id="archiveStageFilter" class="form-select form-select-sm" style="width: auto;" onchange="filterArchivePhotos()">
                        <option value="all">Semua Tahapan (<%= allTicketPhotos.length %>)</option>
                        <option value="report">1. Foto Laporan Awal</option>
                        <option value="accepted">2. Foto Penerimaan Tiket</option>
                        <option value="in_progress">3. Foto Progress Pengerjaan</option>
                        <option value="resolved">4. Foto Bukti Selesai</option>
                    </select>
                </div>
            </div>
            <div class="card-body">
                <% if (allTicketPhotos.length === 0) { %>
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-images fa-3x mb-3 opacity-25"></i>
                        <p class="mb-1 fw-semibold">Belum Ada Foto Arsip Dokumentasi</p>
                        <small>Foto yang dilampirkan saat membuat tiket, update progress, atau penyelesaian akan tersimpan otomatis di sini.</small>
                    </div>
                <% } else { %>
                    <div class="row g-3" id="archivePhotosGrid">
                        <% allTicketPhotos.forEach(ph => { 
                            let stageBadge = 'bg-secondary';
                            let stageText = 'Dokumentasi';
                            if (ph.stage === 'report') { stageBadge = 'bg-danger'; stageText = 'Laporan Awal'; }
                            else if (ph.stage === 'accepted') { stageBadge = 'bg-info text-dark'; stageText = 'Diterima Teknisi'; }
                            else if (ph.stage === 'in_progress') { stageBadge = 'bg-warning text-dark'; stageText = 'Progress Pengerjaan'; }
                            else if (ph.stage === 'resolved') { stageBadge = 'bg-success'; stageText = 'Bukti Selesai'; }
                        %>
                        <div class="col-sm-6 col-md-4 col-lg-3 archive-photo-item" data-stage="<%= ph.stage %>">
                            <div class="card h-100 border shadow-xs">
                                <div class="position-relative" style="height: 180px; overflow: hidden; background: #f8fafc;">
                                    <img src="<%= ph.file_path %>" alt="<%= ph.caption %>"
                                         class="w-100 h-100" style="object-fit: cover; cursor: pointer;"
                                         onclick="previewTicketPhoto('<%= ph.file_path %>', '<%= ph.ticket_number %> - <%= (ph.caption || '').replace(/'/g, '') %>')">
                                    <span class="badge <%= stageBadge %> position-absolute top-0 start-0 m-2 shadow-sm">
                                        <%= stageText %>
                                    </span>
                                </div>
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <a href="/tickets/<%= ph.ticket_id %>" class="fw-bold text-primary small text-decoration-none">
                                                <%= ph.ticket_number %>
                                            </a>
                                            <small class="text-muted" style="font-size: 0.7rem;">
                                                <%= moment(ph.created_at).format('DD/MM/YY HH:mm') %>
                                            </small>
                                        </div>
                                        <div class="fw-semibold text-dark small mb-1"><%= ph.customer_name %></div>
                                        <p class="text-secondary small mb-2" style="font-size: 0.78rem;"><%= ph.caption || '-' %></p>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
                                        <small class="text-muted" style="font-size: 0.72rem;">
                                            <i class="fas fa-user me-1"></i><%= ph.uploaded_by || 'Teknisi' %>
                                        </small>
                                        <div class="d-flex gap-1">
                                            <a href="<%= ph.file_path %>" download="<%= ph.file_name || 'arsip-tiket.jpg' %>" class="btn btn-sm btn-light border py-0 px-2" title="Unduh Foto">
                                                <i class="fas fa-download text-primary" style="font-size: 0.75rem;"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-light border py-0 px-2" onclick="previewTicketPhoto('<%= ph.file_path %>', '<%= ph.ticket_number %> - <%= (ph.caption || '').replace(/'/g, '') %>')" title="Perbesar">
                                                <i class="fas fa-search-plus text-dark" style="font-size: 0.75rem;"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- ================================================================== -->
    <!-- TAB 3: DATA TEKNISI, AKUN LOGIN & NOMOR WHATSAPP -->
    <!-- ================================================================== -->
    <div class="tab-pane fade" id="tab-technicians" role="tabpanel">
        <!-- Info Portal Login Teknisi -->
