<%- include('partials/header', { title: title, activePage: 'genieacs' }) %>

<div class="container-fluid px-0">
    <!-- Top Bar: Back & Action Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div class="d-flex align-items-center gap-3">
            <a href="/genieacs" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>Kembali
            </a>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h4 class="fw-bold mb-0 text-dark"><%= device.model %></h4>
                    <% if (device.isOnline) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                            <i class="fas fa-circle text-success me-1" style="font-size: 0.55rem;"></i>ONLINE
                        </span>
                    <% } else { %>
                        <span class="badge badge-offline-blinking px-2 py-1 small">
                            <i class="fas fa-circle indicator-offline-blinking me-1" style="font-size: 0.55rem;"></i>OFFLINE
                        </span>
                    <% } %>
                    <span class="badge bg-primary text-white px-2 py-1 small"><%= device.manufacturer %></span>
                </div>
                <small class="text-muted">
                    SN: <code class="fw-bold text-dark"><%= device.serial %></code> &bull; 
                    ID: <span class="font-monospace text-muted"><%= device.id %></span> &bull;
                    Terakhir Kontak: <strong><%= device.lastInformDate ? device.lastInformDate.toLocaleString('id-ID') : '-' %></strong>
                </small>
            </div>
        </div>

        <!-- Quick Remote Action Buttons -->
        <div class="d-flex flex-wrap gap-2">
            <form action="/genieacs/devices/<%= encodeURIComponent(device.id) %>/refresh" method="POST" class="d-inline">
                <button type="submit" class="btn btn-outline-primary btn-sm px-3 shadow-sm">
                    <i class="fas fa-sync-alt me-1"></i>Sinkronisasi Parameter
                </button>
            </form>

            <form action="/genieacs/devices/<%= encodeURIComponent(device.id) %>/reboot" method="POST" class="d-inline">
                <button type="button" class="btn btn-warning btn-sm px-3 text-dark fw-bold shadow-sm btn-reboot-confirm">
                    <i class="fas fa-redo me-1"></i>Reboot ONT
                </button>
            </form>

            <form action="/genieacs/devices/<%= encodeURIComponent(device.id) %>/factory-reset" method="POST" class="d-inline">
                <button type="button" class="btn btn-outline-danger btn-sm px-3 shadow-sm btn-reset-confirm">
                    <i class="fas fa-exclamation-triangle me-1"></i>Reset Pabrik
                </button>
            </form>
        </div>
    </div>

    <!-- Customer Link Banner -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <% if (linkedCustomer) { %>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-user-check fa-lg"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success">Pelanggan Terhubung</span>
                                <h6 class="fw-bold mb-0 text-dark"><%= linkedCustomer.name %></h6>
                                <span class="badge bg-light text-dark border"><%= linkedCustomer.customer_id %></span>
                            </div>
                            <small class="text-muted d-block mt-1">
                                <i class="fas fa-box text-primary me-1"></i><%= linkedCustomer.package_name || 'Paket Reguler' %> &bull;
                                <i class="fas fa-phone text-secondary me-1"></i><%= linkedCustomer.phone || '-' %> &bull;
                                <i class="fas fa-map-marker-alt text-danger me-1"></i><%= linkedCustomer.address || '-' %>
                            </small>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/customers/<%= linkedCustomer.id %>/edit" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-external-link-alt me-1"></i>Buka Profil Pelanggan
                        </a>
                        <form action="/genieacs/devices/<%= encodeURIComponent(device.id) %>/unlink-customer" method="POST" class="d-inline">
                            <input type="hidden" name="customer_id" value="<%= linkedCustomer.id %>">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Lepas tautan ONT dari pelanggan ini?')">
                                <i class="fas fa-unlink me-1"></i>Lepas Tautan
                            </button>
                        </form>
                    </div>
                </div>
            <% } else { %>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-info-circle text-warning fa-lg me-1"></i>
                        <div>
                            <span class="fw-semibold text-dark">ONT belum ditautkan dengan Pelanggan</span>
                            <small class="text-muted d-block">Tautkan serial number ini ke pelanggan agar terintegrasi langsung di menu Pelanggan.</small>
                        </div>
                    </div>
                    <form action="/genieacs/devices/<%= encodeURIComponent(device.id) %>/link-customer" method="POST" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="serial" value="<%= device.serial %>">
                        <select name="customer_id" class="form-select form-select-sm" style="min-width: 250px;" required>
                            <option value="">-- Pilih Pelanggan --</option>
                            <% (customers || []).forEach(function(c) { %>
                                <option value="<%= c.id %>"><%= c.customer_id %> - <%= c.name %> (<%= c.phone || 'No Telp' %>)</option>
                            <% }); %>
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                            <i class="fas fa-link me-1"></i>Tautkan
                        </button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Quick Stats Cards Row (Optical, WiFi, WAN, Clients) -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Sinyal Optik / RX Power -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Redaman Optik (RX)</span>
                        <% if (device.optical.opticalStatus === 'normal') { %>
                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Bagus</span>
                        <% } else if (device.optical.opticalStatus === 'warning') { %>
                            <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle me-1"></i>Waspada</span>
                        <% } else if (device.optical.opticalStatus === 'critical') { %>
                            <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Kritis</span>
                        <% } else { %>
                            <span class="badge bg-secondary">Unknown</span>
                        <% } %>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="fw-bold mb-0 <%= device.optical.opticalStatus === 'normal' ? 'text-success' : (device.optical.opticalStatus === 'warning' ? 'text-warning' : (device.optical.opticalStatus === 'critical' ? 'text-danger' : 'text-dark')) %>">
                            <%= device.optical.rxPower !== null ? device.optical.rxPower + ' dBm' : (device.optical.rxRaw || '-') %>
                        </h3>
                    </div>
                    <small class="text-muted d-block mt-1">
                        Mode: <strong><%= device.optical.ponMode %></strong> &bull; Suhu: <strong><%= device.optical.temp !== '-' ? device.optical.temp + '°C' : '-' %></strong>
                    </small>
                </div>
            </div>
        </div>

        <!-- Card 2: Status WiFi -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Nama WiFi (SSID)</span>
                        <% if (device.wifi.enabled) { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Aktif</span>
                        <% } else { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Mati</span>
                        <% } %>
                    </div>
                    <h5 class="fw-bold mb-1 text-primary text-truncate" title="<%= device.wifi.ssid %>">
                        <i class="fas fa-wifi me-1"></i><%= device.wifi.ssid !== '-' ? device.wifi.ssid : 'Belum Terbaca' %>
                    </h5>
                    <small class="text-muted d-block">
                        Password: 
                        <% if (device.wifi.password) { %>
                            <code class="fw-bold text-dark"><%= device.wifi.password %></code>
                        <% } else { %>
                            <span class="text-muted fst-italic">Disembunyikan ONT</span>
                        <% } %>
                    </small>
                </div>
            </div>
        </div>

        <!-- Card 3: Status IP & WAN PPPoE -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Koneksi WAN (PPPoE)</span>
                        <span class="badge bg-info text-dark">WAN 1</span>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark text-truncate">
                        <%= device.wan.ip !== '-' ? device.wan.ip : 'IP Belum Ada' %>
                    </h5>
                    <small class="text-muted d-block">
                        User: <strong class="text-primary"><%= device.wan.username !== '-' ? device.wan.username : '-' %></strong>
                    </small>
                </div>
            </div>
        </div>

        <!-- Card 4: Hardware & Clients -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Info Hardware</span>
                        <span class="badge bg-secondary"><%= device.activeDevicesCount %> Perangkat Klien</span>
                    </div>
                    <h6 class="fw-bold mb-1 text-dark"><%= device.model %></h6>
                    <small class="text-muted d-block">
                        FW: <strong><%= device.softwareVersion %></strong> &bull; HW: <strong><%= device.hardwareVersion %></strong>
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Tabs Layout -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs card-header-tabs m-0 px-3 border-0" id="deviceTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active py-3 fw-semibold" id="tab-wifi-btn" data-bs-toggle="tab" data-bs-target="#tab-wifi" type="button" role="tab">
                        <i class="fas fa-wifi text-primary me-2"></i>Pengaturan Remote WiFi
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-3 fw-semibold" id="tab-optical-btn" data-bs-toggle="tab" data-bs-target="#tab-optical" type="button" role="tab">
                        <i class="fas fa-wave-square text-success me-2"></i>Sinyal Optik & PON
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-3 fw-semibold" id="tab-wan-btn" data-bs-toggle="tab" data-bs-target="#tab-wan" type="button" role="tab">
                        <i class="fas fa-network-wired text-info me-2"></i>WAN & PPPoE
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-3 fw-semibold" id="tab-admin-btn" data-bs-toggle="tab" data-bs-target="#tab-admin" type="button" role="tab">
                        <i class="fas fa-key text-warning me-2"></i>Akses Web GUI ONT
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-3 fw-semibold" id="tab-hosts-btn" data-bs-toggle="tab" data-bs-target="#tab-hosts" type="button" role="tab">
                        <i class="fas fa-laptop text-secondary me-2"></i>Perangkat Terhubung (<%= device.hosts ? device.hosts.length : 0 %>)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-3 fw-semibold" id="tab-raw-btn" data-bs-toggle="tab" data-bs-target="#tab-raw" type="button" role="tab">
                        <i class="fas fa-code text-dark me-2"></i>TR-069 Parameters (<%= device.allParametersCount %>)
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="deviceTabsContent">
                
                <!-- ================================================================== -->
                <!-- TAB 1: REMOTE WIFI (GANTI SSID & PASSWORD) -->
                <!-- ================================================================== -->
                <div class="tab-pane fade show active" id="tab-wifi" role="tabpanel">
                    <div class="row g-4">
                        <!-- Form Ganti SSID & Password -->
                        <div class="col-lg-7">
                            <div class="card border border-primary-subtle shadow-none h-100 bg-white">
                                <div class="card-header bg-primary-subtle py-3 d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold mb-0 text-primary">
                                        <i class="fas fa-edit me-2"></i>Form Ganti Nama WiFi (SSID) & Password
                                    </h6>
                                    <span class="badge bg-primary">TR-069 SetParameterValues</span>
                                </div>
                                <div class="card-body p-4">
                                    <form action="/genieacs/devices/<%= encodeURIComponent(device.id) %>/wifi" method="POST" id="wifiForm">
                                        <!-- Nama WiFi (SSID) -->
                                        <div class="mb-3">
                                            <label for="wifi_ssid" class="form-label fw-bold text-dark">
                                                Nama WiFi Baru (SSID) <span class="text-danger">*</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i class="fas fa-wifi text-primary"></i></span>
                                                <input type="text" class="form-control" id="wifi_ssid" name="ssid"
                                                       value="<%= device.wifi.ssid !== '-' ? device.wifi.ssid : '' %>"
                                                       placeholder="Contoh: Hotspot-Rumah" required minlength="2" maxlength="32">
                                            </div>
                                            <div class="form-text small">Nama sinyal WiFi yang akan muncul saat dicari dari perangkat HP/Laptop.</div>
                                        </div>

                                        <!-- Password WiFi -->
                                        <div class="mb-3">
                                            <label for="wifi_password" class="form-label fw-bold text-dark">
                                                Password WiFi Baru (WPA/WPA2 Key) <span class="text-danger">*</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i class="fas fa-lock text-warning"></i></span>
                                                <input type="text" class="form-control font-monospace" id="wifi_password" name="password"
                                                       value="<%= device.wifi.password || '' %>"
                                                       placeholder="Minimal 8 karakter (huruf/angka)" required minlength="8" maxlength="63">
                                                <button class="btn btn-outline-secondary" type="button" id="btnTogglePassVisibility" title="Lihat/Sembunyikan">
                                                    <i class="fas fa-eye" id="passEyeIcon"></i>
                                                </button>
                                                <button class="btn btn-outline-primary" type="button" id="btnGenRandomPass" title="Buat Password Acak">
                                                    <i class="fas fa-random me-1"></i>Acak
                                                </button>
                                            </div>
                                            <div class="form-text small">Panjang password minimal 8 karakter dan maksimal 63 karakter.</div>
                                        </div>

                                        <!-- Saluran / Channel & Status Switch -->
                                        <div class="row g-3 mb-4">
                                            <div class="col-sm-6">
                                                <label for="wifi_channel" class="form-label fw-semibold">Saluran (Channel)</label>
                                                <select class="form-select" id="wifi_channel" name="channel">
                                                    <option value="0" <%= device.wifi.channel == 0 ? 'selected' : '' %>>Auto (Otomatis Rekomendasi)</option>
                                                    <% for (let ch = 1; ch <= 13; ch++) { %>
                                                        <option value="<%= ch %>" <%= device.wifi.channel == ch ? 'selected' : '' %>>Channel <%= ch %></option>
                                                    <% } %>
                                                </select>
                                            </div>
                                            <div class="col-sm-6">
                                                <label class="form-label fw-semibold">Status Radio WiFi</label>
                                                <div class="form-check form-switch p-2 bg-light rounded border">
                                                    <input class="form-check-input ms-0 me-2" type="checkbox" id="wifi_enable" name="enable" value="true"
                                                           <%= device.wifi.enabled ? 'checked' : '' %>>
                                                    <label class="form-check-label fw-semibold" for="wifi_enable">
                                                        Radio WiFi Aktif
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Tombol Simpan -->
                                        <div class="d-grid gap-2">
                                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                                <i class="fas fa-paper-plane me-2"></i>Terapkan Perubahan WiFi ke ONT Sekarang
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Info & Quick Guide -->
                        <div class="col-lg-5">
                            <div class="card border bg-light shadow-none mb-3">
                                <div class="card-body">
                                    <h6 class="fw-bold text-dark mb-3">
                                        <i class="fas fa-info-circle text-primary me-2"></i>Status WiFi Saat Ini
                                    </h6>
                                    <ul class="list-group list-group-flush rounded bg-white border">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">SSID Saat Ini:</span>
                                            <strong class="text-primary font-monospace"><%= device.wifi.ssid %></strong>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Password Tersimpan:</span>
                                            <span class="font-monospace fw-bold text-dark"><%= device.wifi.password || '(Disembunyikan ONT)' %></span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Keamanan:</span>
                                            <span class="badge bg-secondary"><%= device.wifi.beaconType %></span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Channel Aktif:</span>
                                            <span><%= device.wifi.channel == 0 ? 'Auto' : 'Channel ' + device.wifi.channel %></span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Radio WiFi:</span>
                                            <span class="badge <%= device.wifi.enabled ? 'bg-success' : 'bg-danger' %>">
                                                <%= device.wifi.enabled ? 'Aktif' : 'Mati / Nonaktif' %>
                                            </span>
                                        </li>
                                    </ul>

                                    <div class="mt-3 p-3 bg-white rounded border border-warning-subtle">
                                        <h6 class="small fw-bold text-warning mb-1">
                                            <i class="fas fa-lightbulb me-1"></i>Catatan Teknisi:
                                        </h6>
                                        <small class="text-muted d-block" style="line-height: 1.4;">
                                            Perubahan SSID dan Password akan dikirimkan langsung ke ONT via TR-069 Connection Request. 
                                            Klien HP/Laptop yang sedang tersambung ke WiFi pelanggan akan otomatis terputus dan diminta memasukkan password baru.
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================================================================== -->
                <!-- TAB 2: SINYAL OPTIK & PON -->
                <!-- ================================================================== -->
                <div class="tab-pane fade" id="tab-optical" role="tabpanel">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="card border shadow-none bg-white p-4">
                                <h6 class="fw-bold text-dark mb-3">
                                    <i class="fas fa-tachometer-alt text-success me-2"></i>Redaman Sinyal Fiber Optik (RX Power)
                                </h6>
                                <div class="text-center py-4 bg-light rounded border mb-3">
                                    <div class="display-4 fw-bold <%= device.optical.opticalStatus === 'normal' ? 'text-success' : (device.optical.opticalStatus === 'warning' ? 'text-warning' : 'text-danger') %>">
                                        <%= device.optical.rxPower !== null ? device.optical.rxPower + ' dBm' : (device.optical.rxRaw || '-') %>
                                    </div>
                                    <div class="mt-2">
                                        <% if (device.optical.opticalStatus === 'normal') { %>
                                            <span class="badge bg-success fs-6 px-3 py-2">Sinyal Baik & Stabil (-15 s/d -24.5 dBm)</span>
                                        <% } else if (device.optical.opticalStatus === 'warning') { %>
                                            <span class="badge bg-warning text-dark fs-6 px-3 py-2">Sinyal Waspada (-25 s/d -27 dBm)</span>
                                        <% } else if (device.optical.opticalStatus === 'critical') { %>
                                            <span class="badge bg-danger fs-6 px-3 py-2">Sinyal Kritis (< -27 dBm - Redaman Tinggi!)</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary fs-6 px-3 py-2">Data Belum Terbaca</span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <tbody>
                                            <tr>
                                                <th class="table-light" width="40%">Standar Redaman Baik</th>
                                                <td class="text-success fw-bold">-15.00 dBm s/d -24.00 dBm</td>
                                            </tr>
                                            <tr>
                                                <th class="table-light">Batas Toleransi</th>
                                                <td class="text-warning fw-bold">-25.00 dBm s/d -27.00 dBm</td>
                                            </tr>
                                            <tr>
                                                <th class="table-light">Batas Loss / Putus</th>
                                                <td class="text-danger fw-bold">< -28.00 dBm (Perlu perbaikan kabel/patchcord)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card border shadow-none bg-white p-4">
                                <h6 class="fw-bold text-dark mb-3">
                                    <i class="fas fa-microchip text-primary me-2"></i>Informasi Fisik & Suhu ONT
                                </h6>
                                <ul class="list-group list-group-flush border rounded">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Teknologi PON:</span>
                                        <span class="badge bg-dark"><%= device.optical.ponMode %></span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Temperatur Suhu:</span>
                                        <strong><%= device.optical.temp !== '-' ? device.optical.temp + ' °C' : '-' %></strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Model & Tipe:</span>
                                        <strong><%= device.model %> (<%= device.manufacturer %>)</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Serial Number (GPON/EPON SN):</span>
                                        <code><%= device.serial %></code>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Firmware / Software:</span>
                                        <span><%= device.softwareVersion %></span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Hardware Version:</span>
                                        <span><%= device.hardwareVersion %></span>
                                    </li>
                                </ul>

                                <!-- Action Ping Test -->
                                <div class="mt-4 p-3 bg-light rounded border">
                                    <h6 class="fw-bold small text-dark mb-2"><i class="fas fa-satellite-dish me-1 text-primary"></i>Uji Konektivitas (Ping dari ONT)</h6>
                                    <form action="/genieacs/devices/<%= encodeURIComponent(device.id) %>/ping" method="POST" class="d-flex gap-2">
                                        <input type="text" name="host" class="form-control form-control-sm" value="8.8.8.8" placeholder="IP atau domain (contoh: 8.8.8.8)">
                                        <button type="submit" class="btn btn-primary btn-sm text-nowrap"><i class="fas fa-play me-1"></i>Ping</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================================================================== -->
                <!-- TAB 3: WAN & PPPOE -->
                <!-- ================================================================== -->
                <div class="tab-pane fade" id="tab-wan" role="tabpanel">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="card border shadow-none bg-white p-4 h-100">
                                <h6 class="fw-bold text-dark mb-3">
                                    <i class="fas fa-network-wired text-info me-2"></i>Status Koneksi WAN ONT
                                </h6>
                                <ul class="list-group list-group-flush border rounded mb-3">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">IP Address WAN:</span>
                                        <strong class="text-primary font-monospace"><%= device.wan.ip %></strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Username PPPoE Saat Ini:</span>
                                        <strong class="text-dark"><%= device.wan.username %></strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">MAC Address WAN:</span>
                                        <code><%= device.wan.mac %></code>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Connection Request URL:</span>
                                        <span class="small font-monospace text-truncate" style="max-width: 250px;"><%= device.wan.connectionRequestUrl || '-' %></span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card border shadow-none bg-white p-4 h-100">
                                <h6 class="fw-bold text-dark mb-3">
                                    <i class="fas fa-user-edit text-primary me-2"></i>Ubah Akun PPPoE pada ONT
                                </h6>
                                <form action="/genieacs/devices/<%= encodeURIComponent(device.id) %>/wan" method="POST">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Username PPPoE Baru</label>
                                        <input type="text" name="username" class="form-control" value="<%= device.wan.username !== '-' ? device.wan.username : '' %>" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Password PPPoE Baru</label>
                                        <input type="password" name="password" class="form-control" placeholder="Isi password PPPoE baru">
                                    </div>
                                    <button type="submit" class="btn btn-info text-white fw-bold">
                                        <i class="fas fa-save me-1"></i>Simpan PPPoE ke ONT
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================================================================== -->
                <!-- TAB 4: WEB GUI CREDENTIALS -->
                <!-- ================================================================== -->
                <div class="tab-pane fade" id="tab-admin" role="tabpanel">
                    <div class="row g-4 justify-content-center">
                        <div class="col-lg-8">
                            <div class="card border shadow-none bg-white p-4">
                                <h6 class="fw-bold text-dark mb-3">
                                    <i class="fas fa-shield-alt text-warning me-2"></i>Kredensial Login Web Admin ONT
                                </h6>
                                <p class="text-muted small mb-4">
                                    Gunakan kredensial berikut jika Anda ingin membuka antarmuka web konfigurasi (Web GUI) langsung pada ONT pelanggan:
                                </p>

                                <div class="row g-3 mb-4">
                                    <div class="col-sm-6">
                                        <div class="p-3 bg-light rounded border h-100">
                                            <span class="badge bg-warning text-dark mb-2">SuperAdmin (Telkom/ISP Mode)</span>
                                            <div class="mb-2">
                                                <small class="text-muted d-block">Username:</small>
                                                <code class="fw-bold text-dark fs-6"><%= device.credentials.superAdmin || 'admin' %></code>
                                            </div>
                                            <div>
                                                <small class="text-muted d-block">Password:</small>
                                                <code class="fw-bold text-danger fs-6"><%= device.credentials.superPassword || '(Tidak tersedia)' %></code>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-sm-6">
                                        <div class="p-3 bg-light rounded border h-100">
                                            <span class="badge bg-secondary mb-2">User Biasa (Pelanggan)</span>
                                            <div class="mb-2">
                                                <small class="text-muted d-block">Username:</small>
                                                <code class="fw-bold text-dark fs-6"><%= device.credentials.userAdmin || 'user' %></code>
                                            </div>
                                            <div>
                                                <small class="text-muted d-block">Password:</small>
                                                <code class="fw-bold text-dark fs-6"><%= device.credentials.userPassword || 'user1234' %></code>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <% if (device.wan.ip && device.wan.ip !== '-') { %>
                                    <div class="text-center">
                                        <a href="http://<%= device.wan.ip %>" target="_blank" class="btn btn-outline-primary px-4">
                                            <i class="fas fa-external-link-alt me-2"></i>Buka Web GUI ONT di Tab Baru (http://<%= device.wan.ip %>)
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================================================================== -->
                <!-- TAB 5: PERANGKAT TERHUBUNG (HOSTS) -->
                <!-- ================================================================== -->
                <div class="tab-pane fade" id="tab-hosts" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="fas fa-laptop text-primary me-2"></i>Daftar HP / Laptop yang Sedang Terhubung ke ONT
                        </h6>
                        <span class="badge bg-primary"><%= device.hosts ? device.hosts.length : 0 %> Perangkat</span>
                    </div>

                    <% if (device.hosts && device.hosts.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nama Perangkat (Host)</th>
                                        <th>IP Address</th>
                                        <th>MAC Address</th>
                                        <th>Tipe Koneksi</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% device.hosts.forEach(function(h) { %>
                                        <tr>
                                            <td class="fw-bold"><i class="fas fa-mobile-alt text-muted me-2"></i><%= h.hostName %></td>
                                            <td><code><%= h.ipAddress %></code></td>
                                            <td><code><%= h.macAddress %></code></td>
                                            <td><%= h.interfaceType %></td>
                                            <td>
                                                <% if (h.active) { %>
                                                    <span class="badge bg-success">Aktif</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Idle</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5 bg-light rounded border">
                            <i class="fas fa-network-wired fa-3x text-muted mb-3"></i>
                            <h6 class="fw-bold">Belum Ada Data Host Terbaca</h6>
                            <p class="text-muted small mb-3">Klik tombol "Sinkronisasi Parameter" di atas untuk menarik daftar klien LAN/WiFi terbaru dari ONT.</p>
                            <form action="/genieacs/devices/<%= encodeURIComponent(device.id) %>/refresh" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="fas fa-sync-alt me-1"></i>Tarik Data Klien Sekarang
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>

                <!-- ================================================================== -->
                <!-- TAB 6: TR-069 PARAMETERS EXPLORER -->
                <!-- ================================================================== -->
                <div class="tab-pane fade" id="tab-raw" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="fas fa-database text-primary me-2"></i>Pohon Parameter TR-069 Lengkap
                        </h6>
                        <span class="badge bg-dark"><%= device.allParametersCount %> Total Parameter</span>
                    </div>

                    <div class="mb-3">
                        <input type="text" id="paramSearchInput" class="form-control" placeholder="Cari parameter... (contoh: SSID, WANDevice, RXPower, Password)">
                    </div>

                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-sm table-striped table-hover table-bordered font-monospace small" id="rawParamsTable">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th width="45%">Path Parameter</th>
                                    <th width="35%">Nilai Saat Ini</th>
                                    <th width="10%">Tipe Data</th>
                                    <th width="10%">Writable</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% (device.allParameters || []).forEach(function(p) { %>
                                    <tr>
                                        <td class="text-break fw-semibold text-primary"><%= p.path %></td>
                                        <td class="text-break"><%= p.value !== null && p.value !== undefined ? p.value : '' %></td>
                                        <td><span class="badge bg-light text-dark border"><%= p.type %></span></td>
                                        <td>
                                            <% if (p.writable) { %>
                                                <span class="badge bg-success-subtle text-success">Ya</span>
                                            <% } else { %>
                                                <span class="badge bg-light text-muted">Read-Only</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Toggle visibility password
    const passInput = document.getElementById('wifi_password');
    const toggleBtn = document.getElementById('btnTogglePassVisibility');
    const eyeIcon = document.getElementById('passEyeIcon');
    if (toggleBtn && passInput) {
        toggleBtn.addEventListener('click', function() {
            if (passInput.type === 'password') {
                passInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                passInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        });
    }

    // 2. Buat Password Acak
    const btnGenPass = document.getElementById('btnGenRandomPass');
    if (btnGenPass && passInput) {
        btnGenPass.addEventListener('click', function() {
            const chars = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';
            let res = '';
            for (let i = 0; i < 10; i++) {
                res += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            passInput.value = res;
            passInput.type = 'text';
            if (eyeIcon) {
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            }
        });
    }

    // 3. Konfirmasi Reboot
    document.querySelectorAll('.btn-reboot-confirm').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            Swal.fire({
                title: 'Reboot ONT Sekarang?',
                text: 'Perangkat akan di-reboot dan koneksi internet pelanggan akan terputus selama beberapa saat hingga perangkat menyala kembali.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Ya, Reboot Sekarang!',
                cancelButtonText: 'Batal'
            }).then(function(result) {
                if (result.isConfirmed) form.submit();
            });
        });
    });

    // 4. Konfirmasi Factory Reset
    document.querySelectorAll('.btn-reset-confirm').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            Swal.fire({
                title: 'PERINGATAN: Reset Pabrik ONT?',
                text: 'Seluruh settingan WiFi, PPPoE, dan konfigurasi jaringan ONT ini akan DIHAPUS dan dikembalikan ke bawaan pabrik! Apakah Anda yakin?',
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Ya, Reset Pabrik!',
                cancelButtonText: 'Batal'
            }).then(function(result) {
                if (result.isConfirmed) form.submit();
            });
        });
    });

    // 5. Filter Search Realtime TR-069 Parameters
    const searchInput = document.getElementById('paramSearchInput');
    const table = document.getElementById('rawParamsTable');
    if (searchInput && table) {
        searchInput.addEventListener('input', function() {
            const filter = this.value.toLowerCase();
            const rows = table.querySelectorAll('tbody tr');
            rows.forEach(function(row) {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    }
});
</script>

<%- include('partials/footer') %>
