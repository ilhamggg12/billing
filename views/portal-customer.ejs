<%- include('partials/header', { title: 'Dashboard Portal Pelanggan', activePage: 'portal' }) %>
<%
    const formatRupiah = (num) => 'Rp ' + Number(num || 0).toLocaleString('id-ID');
    const score = typeof customerScore !== 'undefined' && customerScore ? customerScore : {
        tierKey: 'tepat_waktu',
        tier: {
            label: 'Pelanggan Tepat Waktu',
            ruleText: 'Bayar Tanggal 6 s/d 8',
            description: 'Terima kasih telah membayar tagihan tepat waktu sebelum jatuh tempo Tanggal 8.',
            icon: 'fa-check-circle',
            stars: 3
        },
        scorePoints: 75,
        rank: 1,
        habitSummary: 'Belum ada riwayat jatuh tempo',
        paidCount: 0,
        unpaidCount: 0,
        overdueUnpaidCount: 0
    };
%>

<style>
    /* ==========================================================================
       EFEK EMAS BERSINAR-SINAR KHUSUS "PELANGGAN LOYAL" & TEMA SCORING
       ========================================================================== */
    @keyframes goldShimmerMove {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
    }
    @keyframes goldGlowPulse {
        0%, 100% {
            box-shadow: 0 0 18px rgba(245, 158, 11, 0.55),
                        0 0 36px rgba(251, 191, 36, 0.35),
                        inset 0 0 15px rgba(255, 255, 255, 0.35);
        }
        50% {
            box-shadow: 0 0 28px rgba(245, 158, 11, 0.85),
                        0 0 55px rgba(253, 224, 71, 0.55),
                        inset 0 0 25px rgba(255, 255, 255, 0.55);
        }
    }
    @keyframes crownFloat {
        0%, 100% { transform: translateY(0) scale(1); }
        50% { transform: translateY(-4px) scale(1.06); }
    }
    @keyframes sparkleBlink {
        0%, 100% { opacity: 0.35; transform: scale(0.85) rotate(0deg); }
        50% { opacity: 1; transform: scale(1.2) rotate(15deg); }
    }

    /* Card Tier 1: PELANGGAN LOYAL (Emas Bersinar-sinar) */
    .score-banner-loyal {
        background: linear-gradient(125deg, #78350f 0%, #b45309 22%, #f59e0b 48%, #fde047 55%, #d97706 78%, #92400e 100%);
        background-size: 220% 220%;
        animation: goldShimmerMove 6s linear infinite, goldGlowPulse 3s ease-in-out infinite;
        border: 2px solid #fde047 !important;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .score-banner-loyal::before {
        content: '';
        position: absolute;
        top: 0; left: -100%; width: 60%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.42), transparent);
        transform: skewX(-25deg);
        animation: goldShimmerMove 3.5s ease-in-out infinite;
        pointer-events: none;
    }
    .badge-loyal-gold {
        background: linear-gradient(90deg, #fef08a, #f59e0b, #fef08a, #eab308);
        background-size: 200% auto;
        color: #451a03 !important;
        font-weight: 800;
        border: 1.5px solid #fffbeb;
        box-shadow: 0 0 14px rgba(253, 224, 71, 0.85);
        animation: goldShimmerMove 3s linear infinite;
    }
    .icon-loyal-crown {
        animation: crownFloat 2.4s ease-in-out infinite;
        filter: drop-shadow(0 0 10px rgba(254, 240, 138, 0.9));
    }
    .sparkle-star {
        animation: sparkleBlink 1.8s ease-in-out infinite;
        color: #fef08a;
    }

    /* Card Tier 2: PELANGGAN DISIPLIN (Biru Sapphire / Cyan Elegan) */
    .score-banner-disiplin {
        background: linear-gradient(135deg, #0f172a 0%, #0369a1 45%, #0284c7 80%, #38bdf8 100%);
        border: 1.5px solid #7dd3fc !important;
        color: #fff;
        box-shadow: 0 10px 26px rgba(2, 132, 199, 0.28);
    }
    .badge-disiplin {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #fff !important;
        font-weight: 700;
        border: 1px solid #bae6fd;
    }

    /* Card Tier 3: PELANGGAN TEPAT WAKTU (Hijau Emerald) */
    .score-banner-tepat_waktu {
        background: linear-gradient(135deg, #064e3b 0%, #047857 55%, #10b981 100%);
        border: 1.5px solid #6ee7b7 !important;
        color: #fff;
        box-shadow: 0 10px 24px rgba(16, 185, 129, 0.24);
    }
    .badge-tepat_waktu {
        background: linear-gradient(135deg, #059669, #10b981);
        color: #fff !important;
        font-weight: 700;
    }

    /* Card Tier 4: PELANGGAN MACET (Merah Peringatan) */
    .score-banner-macet {
        background: linear-gradient(135deg, #7f1d1d 0%, #b91c1c 55%, #ef4444 100%);
        border: 1.5px solid #fca5a5 !important;
        color: #fff;
        box-shadow: 0 10px 24px rgba(239, 68, 68, 0.28);
    }
    .badge-macet {
        background: linear-gradient(135deg, #dc2626, #991b1b);
        color: #fff !important;
        font-weight: 700;
    }

    .tier-guide-item {
        border-radius: 12px;
        padding: 10px 12px;
        transition: all 0.2s ease;
        border: 1px solid #e2e8f0;
        background: #fff;
    }
    .tier-guide-item.active-tier {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    }
    .portal-nav-pills .nav-link {
        border-radius: 10px;
        font-weight: 700;
        padding: 10px 18px;
        color: #475569;
        background: #fff;
        border: 1px solid #e2e8f0;
    }
    .portal-nav-pills .nav-link.active {
        background: #0f766e;
        color: #fff;
        border-color: #0f766e;
        box-shadow: 0 4px 12px rgba(15, 118, 110, 0.25);
    }
</style>

<!-- ========================================================================== -->
<!-- 1. BANNER PROFIL & SCORING / RANKING PELANGGAN -->
<!-- ========================================================================== -->
<div class="card border-0 rounded-4 mb-3 score-banner-<%= score.tierKey %>" id="section-scoring">
    <div class="card-body p-4 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-3">
            <!-- Info Pelanggan -->
            <div class="col-lg-7">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-white text-dark fw-bold px-3 py-1 rounded-pill shadow-xs">
                        <i class="fas fa-id-card text-primary me-1"></i>ID: <%= customer.customer_id || '-' %>
                    </span>
                    <% if (customer.status === 'active') { %>
                        <span class="badge bg-success border border-light px-3 py-1 rounded-pill">
                            <i class="fas fa-check-circle me-1"></i>Layanan Aktif
                        </span>
                    <% } else { %>
                        <span class="badge bg-danger border border-light px-3 py-1 rounded-pill">
                            <i class="fas fa-exclamation-circle me-1"></i>Status: Terisolir / Suspend
                        </span>
                    <% } %>
                </div>

                <h3 class="fw-extrabold mb-1 d-flex align-items-center flex-wrap gap-2">
                    <span>Halo, <%= customer.name %>!</span>
                    <% if (score.tierKey === 'loyal') { %>
                        <span class="sparkle-star"><i class="fas fa-sparkles"></i>✨</span>
                    <% } %>
                </h3>

                <p class="mb-2 opacity-90 small">
                    <i class="fas fa-wifi me-1"></i>Paket Internet: <strong><%= customer.package_name || 'Internet Fiber' %></strong>
                    <% if (customer.package_price) { %>
                        (<%= formatRupiah(customer.package_price) %> / bulan)
                    <% } %>
                    <% if (customer.address) { %>
                        • <i class="fas fa-map-marker-alt ms-1 me-1"></i><%= customer.address %>
                    <% } %>
                </p>

                <p class="mb-0 small opacity-90">
                    <%= score.tier.description %>
                </p>
            </div>

            <!-- Kartu Badge Predikat Scoring Pelanggan -->
            <div class="col-lg-5">
                <div class="p-3 rounded-4" style="background: rgba(0, 0, 0, 0.24); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.28);">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 <%= score.tierKey === 'loyal' ? 'icon-loyal-crown' : '' %>"
                                 style="width: 60px; height: 60px; background: <%= score.tierKey === 'loyal' ? 'linear-gradient(135deg, #fef08a, #f59e0b)' : 'rgba(255,255,255,0.18)' %>; color: <%= score.tierKey === 'loyal' ? '#78350f' : '#fff' %>; border: 2px solid rgba(255,255,255,0.6);">
                                <i class="fas <%= score.tier.icon %> fa-2x"></i>
                            </div>
                            <div>
                                <div class="text-uppercase fw-bold opacity-80" style="font-size: 0.68rem; letter-spacing: 0.8px;">
                                    Predikat Pembayaran Anda
                                </div>
                                <div class="fs-5 fw-extrabold d-flex align-items-center gap-1">
                                    <% if (score.tierKey === 'loyal') { %>
                                        <span class="badge badge-loyal-gold px-3 py-1 rounded-pill fs-6">
                                            <i class="fas fa-crown me-1"></i>✨ <%= score.tier.label.toUpperCase() %> ✨
                                        </span>
                                    <% } else { %>
                                        <span><%= score.tier.label %></span>
                                    <% } %>
                                </div>
                                <div class="mt-1" style="font-size: 0.8rem;">
                                    <% for (let s = 1; s <= 5; s++) { %>
                                        <i class="<%= s <= score.tier.stars ? 'fas text-warning' : 'far opacity-50' %> fa-star"></i>
                                    <% } %>
                                    <span class="ms-1 small opacity-90">(<%= score.habitSummary %>)</span>
                                </div>
                            </div>
                        </div>
                        <div class="text-end border-start border-light border-opacity-25 ps-3">
                            <div class="small opacity-75" style="font-size: 0.7rem;">Skor</div>
                            <div class="fs-3 fw-extrabold lh-1"><%= score.scorePoints %></div>
                            <div class="small opacity-75" style="font-size: 0.68rem;">/ 100</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Panduan 4 Level Scoring Pembayaran Pelanggan -->
<div class="row g-2 mb-4">
    <div class="col-6 col-lg-3">
        <div class="tier-guide-item h-100 <%= score.tierKey === 'loyal' ? 'active-tier border-warning border-2 bg-warning bg-opacity-10' : '' %>">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-loyal-gold rounded-pill px-2 py-1"><i class="fas fa-crown me-1"></i>Loyal</span>
                <% if (score.tierKey === 'loyal') { %><span class="badge bg-warning text-dark ms-auto" style="font-size:0.65rem;">Level Anda</span><% } %>
            </div>
            <div class="fw-bold text-dark small">Pelanggan Loyal ✨</div>
            <div class="text-muted" style="font-size: 0.73rem;">Bayar <strong>sebelum / tepat Tanggal 1</strong> setiap bulan</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="tier-guide-item h-100 <%= score.tierKey === 'disiplin' ? 'active-tier border-info border-2 bg-info bg-opacity-10' : '' %>">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-disiplin rounded-pill px-2 py-1"><i class="fas fa-medal me-1"></i>Disiplin</span>
                <% if (score.tierKey === 'disiplin') { %><span class="badge bg-info text-dark ms-auto" style="font-size:0.65rem;">Level Anda</span><% } %>
            </div>
            <div class="fw-bold text-dark small">Pelanggan Disiplin 💎</div>
            <div class="text-muted" style="font-size: 0.73rem;">Bayar tagihan pada <strong>Tanggal 2 s/d Tanggal 5</strong></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="tier-guide-item h-100 <%= score.tierKey === 'tepat_waktu' ? 'active-tier border-success border-2 bg-success bg-opacity-10' : '' %>">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-tepat_waktu rounded-pill px-2 py-1"><i class="fas fa-check-circle me-1"></i>Tepat Waktu</span>
                <% if (score.tierKey === 'tepat_waktu') { %><span class="badge bg-success ms-auto" style="font-size:0.65rem;">Level Anda</span><% } %>
            </div>
            <div class="fw-bold text-dark small">Pelanggan Tepat Waktu ✅</div>
            <div class="text-muted" style="font-size: 0.73rem;">Bayar tagihan pada <strong>Tanggal 6 s/d Tanggal 8</strong></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="tier-guide-item h-100 <%= score.tierKey === 'macet' ? 'active-tier border-danger border-2 bg-danger bg-opacity-10' : '' %>">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-macet rounded-pill px-2 py-1"><i class="fas fa-exclamation-triangle me-1"></i>Macet</span>
                <% if (score.tierKey === 'macet') { %><span class="badge bg-danger ms-auto" style="font-size:0.65rem;">Status Anda</span><% } %>
            </div>
            <div class="fw-bold text-dark small">Pelanggan Macet ⚠️</div>
            <div class="text-muted" style="font-size: 0.73rem;">Lewat masa jatuh tempo <strong>Tanggal 8 dst</strong></div>
        </div>
    </div>
</div>

<!-- ========================================================================== -->
<!-- 2. RINGKASAN STATISTIK CEPAT (TAGIHAN, PEMBAYARAN & TIKET) -->
<!-- ========================================================================== -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Tagihan Belum Dibayar</div>
                    <div class="fs-4 fw-bold <%= stats.unpaidInvoicesCount > 0 ? 'text-danger' : 'text-success' %>">
                        <%= stats.unpaidInvoicesCount > 0 ? formatRupiah(stats.totalUnpaidAmount) : 'LUNAS' %>
                    </div>
                    <small class="text-muted" style="font-size: 0.72rem;">
                        <%= stats.unpaidInvoicesCount > 0 ? `${stats.unpaidInvoicesCount} tagihan menunggu pembayaran` : 'Tidak ada tunggakan' %>
                    </small>
                </div>
                <div class="rounded-3 p-3 <%= stats.unpaidInvoicesCount > 0 ? 'bg-danger bg-opacity-10 text-danger' : 'bg-success bg-opacity-10 text-success' %>">
                    <i class="fas fa-file-invoice-dollar fa-lg"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Riwayat Pembayaran</div>
                    <div class="fs-4 fw-bold text-primary"><%= stats.paidInvoicesCount %> Kali</div>
                    <small class="text-muted" style="font-size: 0.72rem;">Total: <%= formatRupiah(stats.totalPaidAmount) %></small>
                </div>
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-receipt fa-lg"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Jatuh Tempo Bulanan</div>
                    <div class="fs-4 fw-bold text-dark">Tanggal <%= customer.due_date || 8 %></div>
                    <small class="text-muted" style="font-size: 0.72rem;">Bayar ≤ Tgl 1 untuk Skor Loyal ✨</small>
                </div>
                <div class="rounded-3 p-3 bg-warning bg-opacity-15 text-warning">
                    <i class="fas fa-calendar-check fa-lg"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Tiket Gangguan</div>
                    <div class="fs-4 fw-bold <%= stats.active > 0 ? 'text-warning' : 'text-success' %>">
                        <%= stats.active %> Aktif
                    </div>
                    <small class="text-muted" style="font-size: 0.72rem;">Total <%= stats.total %> laporan (<%= stats.resolved %> selesai)</small>
                </div>
                <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info">
                    <i class="fas fa-headset fa-lg"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================== -->
<!-- 3. TOMBOL NAVIGASI BAGIAN PORTAL (TAGIHAN & PEMBAYARAN / TIKET GANGGUAN) -->
<!-- ========================================================================== -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <ul class="nav portal-nav-pills gap-2">
        <li class="nav-item">
            <button type="button" class="nav-link active" id="btnShowAll" onclick="showPortalSection('all')">
                <i class="fas fa-th-large me-1"></i>Semua Menu
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link" id="btnShowBilling" onclick="showPortalSection('billing')">
                <i class="fas fa-file-invoice-dollar me-1"></i>Informasi Tagihan & Riwayat Pembayaran
                <% if (stats.unpaidInvoicesCount > 0) { %>
                    <span class="badge bg-danger ms-1"><%= stats.unpaidInvoicesCount %></span>
                <% } %>
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link" id="btnShowTickets" onclick="showPortalSection('tickets')">
                <i class="fas fa-headset me-1"></i>Tiket Gangguan Saya
                <% if (stats.active > 0) { %>
                    <span class="badge bg-warning text-dark ms-1"><%= stats.active %></span>
                <% } %>
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link" id="btnShowWifi" onclick="showPortalSection('wifi')">
                <i class="fas <%= isStaticConnection ? 'fa-server' : 'fa-wifi' %> me-1"></i><%= isStaticConnection ? 'Router Saya' : 'Pengaturan WiFi' %>
            </button>
        </li>
    </ul>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#modalPaymentMethods">
            <i class="fas fa-university me-1"></i>Info Rekening & QRIS
        </button>
        <button type="button" class="btn btn-success fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#modalCustomerCreateTicket">
            <i class="fas fa-plus-circle me-1"></i>Buat Tiket Gangguan
        </button>
    </div>
</div>

<!-- ========================================================================== -->
<!-- 4. BAGIAN INFORMASI TAGIHAN INTERNET & RIWAYAT PEMBAYARAN -->
<!-- ========================================================================== -->
<div id="section-billing" class="mb-4">
    <!-- Highlight Tagihan Aktif yang Belum Dibayar (Jika Ada) -->
    <% if (typeof unpaidInvoicesList !== 'undefined' && unpaidInvoicesList.length > 0) { %>
        <% unpaidInvoicesList.forEach(unpaid => { %>
        <div class="card border-danger border-2 shadow-sm mb-3" style="background: linear-gradient(90deg, #fff5f5 0%, #ffffff 100%);">
            <div class="card-body p-3 p-md-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-8">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="badge bg-danger px-3 py-1 rounded-pill">
                                <i class="fas fa-exclamation-circle me-1"></i>TAGIHAN BELUM DIBAYAR
                            </span>
                            <span class="fw-bold text-dark"><%= unpaid.invoice_number %></span>
                            <span class="text-muted small">• Periode: <strong><%= unpaid.period %></strong></span>
                        </div>
                        <h4 class="fw-extrabold text-danger mb-1"><%= formatRupiah(unpaid.amount) %></h4>
                        <div class="small text-secondary">
                            <i class="far fa-calendar-alt me-1"></i>Batas Jatuh Tempo:
                            <strong class="text-dark"><%= moment(unpaid.due_date).format('DD MMMM YYYY') %></strong>
                            <% if (unpaid.scoring && unpaid.scoring.isOverdueUnpaid) { %>
                                <span class="badge badge-macet ms-1">
                                    <i class="fas fa-exclamation-triangle me-1"></i>Lewat <%= unpaid.scoring.overdueDays %> Hari (Pelanggan Macet)
                                </span>
                            <% } else { %>
                                <span class="badge bg-warning text-dark ms-1">Segera lunasi sebelum Tanggal 8</span>
                            <% } %>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end d-flex flex-wrap justify-content-md-end gap-2">
                        <button type="button" class="btn btn-danger fw-bold btn-sm px-3" data-bs-toggle="modal" data-bs-target="#modalPaymentMethods">
                            <i class="fas fa-wallet me-1"></i>Cara Bayar Tagihan
                        </button>
                        <a href="/portal/invoices/<%= unpaid.id %>/print" target="_blank" class="btn btn-outline-dark fw-semibold btn-sm px-3">
                            <i class="fas fa-print me-1"></i>Lihat / Cetak Invoice
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <% }) %>
    <% } %>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fas fa-file-invoice-dollar text-primary me-2"></i>Informasi Tagihan Internet & Riwayat Pembayaran
                </h5>
                <small class="text-muted">Daftar tagihan bulanan, status pembayaran, serta predikat ketepatan waktu bayar Anda</small>
            </div>
            <ul class="nav nav-pills nav-sm gap-1" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active btn-sm fw-bold py-1 px-3" data-bs-toggle="pill" data-bs-target="#tabPaneInvoices" type="button" role="tab">
                        <i class="fas fa-file-invoice me-1"></i>Daftar Tagihan (<%= invoices ? invoices.length : 0 %>)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link btn-sm fw-bold py-1 px-3" data-bs-toggle="pill" data-bs-target="#tabPanePayments" type="button" role="tab">
                        <i class="fas fa-history me-1"></i>Riwayat Pembayaran (<%= payments ? payments.length : 0 %>)
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-0">
            <div class="tab-content">
                <!-- TAB 1: DAFTAR TAGIHAN INTERNET -->
                <div class="tab-pane fade show active" id="tabPaneInvoices" role="tabpanel">
                    <% if (!invoices || invoices.length === 0) { %>
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-file-invoice fa-3x mb-2 opacity-25 d-block"></i>
                            <div class="fw-semibold">Belum ada data tagihan untuk akun Anda.</div>
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">No. Invoice</th>
                                        <th>Periode</th>
                                        <th>Nominal Tagihan</th>
                                        <th>Jatuh Tempo</th>
                                        <th>Tanggal Dibayar</th>
                                        <th>Predikat / Scoring</th>
                                        <th>Status</th>
                                        <th class="text-end pe-3">Invoice</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% invoices.forEach(inv => {
                                        const sc = inv.scoring || {};
                                    %>
                                    <tr>
                                        <td class="ps-3 fw-bold text-primary"><%= inv.invoice_number %></td>
                                        <td><span class="badge bg-light text-dark border fw-semibold"><%= inv.period %></span></td>
                                        <td class="fw-bold text-dark"><%= formatRupiah(inv.amount) %></td>
                                        <td class="small text-muted">
                                            <i class="far fa-calendar me-1"></i><%= inv.due_date ? moment(inv.due_date).format('DD MMM YYYY') : '-' %>
                                        </td>
                                        <td class="small">
                                            <% if (inv.status === 'paid') { %>
                                                <span class="text-success fw-semibold">
                                                    <i class="fas fa-check-circle me-1"></i><%= sc.paidDateFormatted || moment(inv.paid_date || inv.payment_date).format('DD MMM YYYY') %>
                                                </span>
                                                <div class="text-muted" style="font-size: 0.72rem;"><%= sc.timingText %></div>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                                <div class="text-danger" style="font-size: 0.72rem;"><%= sc.timingText %></div>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (sc.tierKey === 'loyal') { %>
                                                <span class="badge badge-loyal-gold rounded-pill px-3 py-1">
                                                    <i class="fas fa-crown me-1"></i>✨ Pelanggan Loyal
                                                </span>
                                            <% } else if (sc.tierKey === 'disiplin') { %>
                                                <span class="badge badge-disiplin rounded-pill px-3 py-1">
                                                    <i class="fas fa-medal me-1"></i>Pelanggan Disiplin
                                                </span>
                                            <% } else if (sc.tierKey === 'tepat_waktu') { %>
                                                <span class="badge badge-tepat_waktu rounded-pill px-3 py-1">
                                                    <i class="fas fa-check-circle me-1"></i>Pelanggan Tepat Waktu
                                                </span>
                                            <% } else if (sc.tierKey === 'macet') { %>
                                                <span class="badge badge-macet rounded-pill px-3 py-1">
                                                    <i class="fas fa-exclamation-triangle me-1"></i>Pelanggan Macet
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2 py-1">
                                                    Menunggu Pembayaran
                                                </span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (inv.status === 'paid') { %>
                                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>LUNAS</span>
                                            <% } else { %>
                                                <span class="badge bg-danger"><i class="fas fa-clock me-1"></i>BELUM BAYAR</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end pe-3">
                                            <a href="/portal/invoices/<%= inv.id %>/print" target="_blank" class="btn btn-sm btn-outline-primary fw-semibold">
                                                <i class="fas fa-print me-1"></i>Cetak / PDF
                                            </a>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>

                <!-- TAB 2: RIWAYAT PEMBAYARAN -->
                <div class="tab-pane fade" id="tabPanePayments" role="tabpanel">
                    <% if (!payments || payments.length === 0) { %>
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-receipt fa-3x mb-2 opacity-25 d-block"></i>
                            <div class="fw-semibold">Belum ada riwayat transaksi pembayaran yang tercatat.</div>
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Tanggal Bayar</th>
                                        <th>No. Invoice</th>
                                        <th>Periode</th>
                                        <th>Metode Pembayaran</th>
                                        <th>Jumlah Dibayar</th>
                                        <th>Predikat Ketepatan</th>
                                        <th>Penerima</th>
                                        <th class="text-end pe-3">Bukti</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% payments.forEach(pm => {
                                        const sc = pm.scoring || {};
                                    %>
                                    <tr>
                                        <td class="ps-3 fw-semibold text-dark">
                                            <i class="far fa-calendar-check text-success me-1"></i>
                                            <%= moment(pm.payment_date).format('DD MMMM YYYY') %>
                                        </td>
                                        <td class="fw-bold text-primary"><%= pm.invoice_number %></td>
                                        <td><span class="badge bg-light text-dark border"><%= pm.period %></span></td>
                                        <td class="text-uppercase small fw-semibold"><%= pm.payment_method || 'Transfer' %></td>
                                        <td class="fw-bold text-success"><%= formatRupiah(pm.amount) %></td>
                                        <td>
                                            <% if (sc.tierKey === 'loyal') { %>
                                                <span class="badge badge-loyal-gold rounded-pill px-2 py-1">
                                                    <i class="fas fa-crown me-1"></i>✨ Loyal (≤ Tgl 1)
                                                </span>
                                            <% } else if (sc.tierKey === 'disiplin') { %>
                                                <span class="badge badge-disiplin rounded-pill px-2 py-1">
                                                    <i class="fas fa-medal me-1"></i>Disiplin (Tgl 2-5)
                                                </span>
                                            <% } else if (sc.tierKey === 'tepat_waktu') { %>
                                                <span class="badge badge-tepat_waktu rounded-pill px-2 py-1">
                                                    <i class="fas fa-check-circle me-1"></i>Tepat Waktu (Tgl 6-8)
                                                </span>
                                            <% } else { %>
                                                <span class="badge badge-macet rounded-pill px-2 py-1">
                                                    <i class="fas fa-exclamation-triangle me-1"></i>Terlambat (> Tgl 8)
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="small text-muted"><%= pm.received_by || 'Admin' %></td>
                                        <td class="text-end pe-3">
                                            <a href="/portal/invoices/<%= pm.invoice_id %>/print" target="_blank" class="btn btn-sm btn-outline-success fw-semibold">
                                                <i class="fas fa-file-invoice me-1"></i>Kwitansi
                                            </a>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================== -->
<!-- 5. BAGIAN DAFTAR & LIVE TRACKING TIKET GANGGUAN PELANGGAN -->
<!-- ========================================================================== -->
<div id="section-tickets">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="fas fa-tasks text-success me-2"></i>Daftar & Status Tiket Gangguan Anda</h5>
        <button type="button" class="btn btn-success btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#modalCustomerCreateTicket">
            <i class="fas fa-plus-circle me-1"></i>Buat Tiket Baru
        </button>
    </div>

    <% if (tickets.length === 0) { %>
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center mb-3" style="width: 68px; height: 68px;">
                    <i class="fas fa-check-circle fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">Belum Ada Laporan Tiket Gangguan</h5>
                <p class="text-muted small mb-3">Koneksi internet Anda terkendala? Klik tombol di bawah untuk mengirim laporan langsung ke tim teknisi kami.</p>
                <button type="button" class="btn btn-success fw-bold px-4" data-bs-toggle="modal" data-bs-target="#modalCustomerCreateTicket">
                    <i class="fas fa-plus-circle me-1"></i>Buat Laporan Gangguan Sekarang
                </button>
            </div>
        </div>
    <% } else { %>
        <div class="row g-3">
            <% tickets.forEach(t => { 
                const stepMap = { 'open': 1, 'accepted': 2, 'in_progress': 3, 'resolved': 4 };
                const step = stepMap[t.status] || 1;
                const progressPercent = step === 1 ? 25 : (step === 2 ? 50 : (step === 3 ? 75 : 100));
                const barColor = step === 4 ? 'bg-success' : (step === 3 ? 'bg-warning' : (step === 2 ? 'bg-info' : 'bg-danger'));
            %>
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <a href="/portal/tickets/<%= t.id %>" class="fw-bold fs-5 text-primary text-decoration-none">
                                        <%= t.ticket_number %>
                                    </a>
                                    <% if (t.status === 'open') { %>
                                        <span class="badge bg-danger">1. Menunggu Konfirmasi Teknisi</span>
                                    <% } else if (t.status === 'accepted') { %>
                                        <span class="badge bg-info text-dark">2. Diterima Teknisi</span>
                                    <% } else if (t.status === 'in_progress') { %>
                                        <span class="badge bg-warning text-dark">3. Sedang Ditangani Teknisi</span>
                                    <% } else { %>
                                        <span class="badge bg-success">4. Gangguan Selesai</span>
                                    <% } %>
                                </div>
                                <div class="fw-semibold text-dark"><%= t.category %></div>
                                <small class="text-muted">
                                    <i class="far fa-clock me-1"></i>Dilaporkan: <%= moment(t.created_at).format('DD MMMM YYYY HH:mm') %> WIB
                                </small>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <a href="/portal/tickets/<%= t.id %>#chat-section" class="btn btn-outline-success btn-sm fw-semibold">
                                    <i class="fas fa-comments me-1"></i>Chat Teknisi
                                    <span class="badge bg-success ms-1"><%= t.chat_count || 0 %></span>
                                </a>
                                <a href="/portal/tickets/<%= t.id %>" class="btn btn-primary btn-sm fw-semibold">
                                    <i class="fas fa-search-location me-1"></i>Lihat Track Progress
                                </a>
                            </div>
                        </div>

                        <p class="text-secondary small bg-light p-2 px-3 rounded border mb-3">
                            <strong>Keluhan:</strong> <%= t.description %>
                        </p>

                        <!-- Visual Stepper Progress Bar -->
                        <div class="mb-2">
                            <div class="progress" style="height: 8px; border-radius: 99px;">
                                <div class="progress-bar <%= barColor %> progress-bar-striped <%= step < 4 ? 'progress-bar-animated' : '' %>"
                                     role="progressbar" style="width: <%= progressPercent %>%;"></div>
                            </div>
                            <div class="row text-center mt-2 g-1" style="font-size: 0.75rem;">
                                <div class="col-3 <%= step >= 1 ? 'fw-bold text-danger' : 'text-muted' %>">
                                    <i class="fas fa-bell me-1"></i>1. Dilaporkan
                                </div>
                                <div class="col-3 <%= step >= 2 ? 'fw-bold text-info' : 'text-muted' %>">
                                    <i class="fas fa-user-check me-1"></i>2. Diterima
                                </div>
                                <div class="col-3 <%= step >= 3 ? 'fw-bold text-warning' : 'text-muted' %>">
                                    <i class="fas fa-tools me-1"></i>3. Dikerjakan
                                </div>
                                <div class="col-3 <%= step >= 4 ? 'fw-bold text-success' : 'text-muted' %>">
                                    <i class="fas fa-check-circle me-1"></i>4. Selesai
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center pt-2 border-top mt-3 small text-muted">
                            <div>
                                <i class="fas fa-user-cog text-primary me-1"></i>Teknisi Bertugas:
                                <strong class="text-dark"><%= t.technician_name || 'Tim Teknisi' %></strong>
                            </div>
                            <div class="d-flex gap-3">
                                <span><i class="fas fa-history me-1"></i><%= t.log_count || 1 %> Riwayat Progress</span>
                                <span><i class="fas fa-camera me-1"></i><%= t.photo_count || 0 %> Foto Dokumentasi</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    <% } %>
</div>

<!-- ====================================================================== -->
<!-- MODAL INFO REKENING PEMBAYARAN & QRIS -->
<!-- ====================================================================== -->
<div class="modal fade" id="modalPaymentMethods" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-wallet me-2"></i>Metode Pembayaran Tagihan Internet
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <%
                    const ps = typeof paymentSettings !== 'undefined' && paymentSettings ? paymentSettings : {};
                %>
                <div class="alert alert-warning py-2 small mb-3">
                    <i class="fas fa-crown text-warning me-1"></i>
                    <strong>Tips Pelanggan Loyal:</strong> Bayar tagihan sebelum atau tepat <strong>Tanggal 1</strong> untuk mendapatkan predikat <strong>Pelanggan Loyal (Emas)</strong>!
                </div>

                <% if (ps.payment_bank_name || ps.payment_bank_account) { %>
                <div class="p-3 rounded-3 border bg-light mb-3">
                    <div class="small text-muted fw-bold text-uppercase mb-1"><i class="fas fa-university text-primary me-1"></i>Transfer Bank</div>
                    <div class="fw-bold text-dark"><%= ps.payment_bank_name || 'Bank Transfer' %></div>
                    <div class="fs-5 fw-extrabold text-primary my-1"><%= ps.payment_bank_account || '-' %></div>
                    <div class="small text-secondary">a.n. <strong><%= ps.payment_bank_holder || '-' %></strong></div>
                </div>
                <% } %>

                <% if (ps.payment_ewallet_number) { %>
                <div class="p-3 rounded-3 border bg-light mb-3">
                    <div class="small text-muted fw-bold text-uppercase mb-1"><i class="fas fa-mobile-alt text-success me-1"></i>E-Wallet (<%= ps.payment_ewallet_type || 'DANA / OVO / GoPay' %>)</div>
                    <div class="fs-5 fw-extrabold text-success my-1"><%= ps.payment_ewallet_number %></div>
                    <div class="small text-secondary">a.n. <strong><%= ps.payment_ewallet_holder || '-' %></strong></div>
                </div>
                <% } %>

                <% if (ps.payment_qris_image) { %>
                <div class="p-3 rounded-3 border text-center bg-white">
                    <div class="small text-muted fw-bold text-uppercase mb-2"><i class="fas fa-qrcode text-dark me-1"></i>Scan QRIS</div>
                    <img src="<%= ps.payment_qris_image %>" alt="QRIS" class="img-fluid rounded border p-2" style="max-height: 240px;">
                </div>
                <% } %>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

<!-- ====================================================================== -->
<!-- MODAL BUAT TIKET GANGGUAN OLEH PELANGGAN -->
<!-- ====================================================================== -->
<div class="modal fade" id="modalCustomerCreateTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form action="/portal/tickets" method="POST" enctype="multipart/form-data">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-headset me-2"></i>Buat Laporan Tiket Gangguan
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-success py-2 small mb-3">
                        <i class="fab fa-whatsapp me-1"></i>Laporan Anda akan langsung diteruskan secara otomatis ke WhatsApp Teknisi yang bertugas.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Jenis / Kategori Gangguan <span class="text-danger">*</span></label>
                        <select name="category" class="form-select" required>
                            <option value="Koneksi Terputus (LOS Merah)">Lampu Modem Berkedip Merah (LOS / Mati Total)</option>
                            <option value="Internet Lambat / Putus-Nyambung">Koneksi Internet Lambat / Putus-Nyambung</option>
                            <option value="Kabel Dropcore Putus">Kabel Internet Putus / Tertarik</option>
                            <option value="Modem / ONT Bermasalah / Restart">Perangkat Modem / WiFi Error / Tidak Muncul</option>
                            <option value="Ganti Password / Setting WiFi">Minta Bantuan Ganti Nama / Password WiFi</option>
                            <option value="Lainnya">Kendala Lainnya</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Detail Keluhan / Kondisi Saat Ini <span class="text-danger">*</span></label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Contoh: Lampu LOS warna merah berkedip sejak jam 10 pagi, sudah dicoba restart modem namun masih belum konek..." required></textarea>
                    </div>

                    <div class="mb-2 p-3 bg-light rounded border">
                        <label class="form-label fw-bold small mb-1">
                            <i class="fas fa-camera text-success me-1"></i>Lampirkan Foto Kondisi Modem / Gangguan (Opsional)
                        </label>
                        <input type="file" name="photos" class="form-control form-control-sm mb-2" accept="image/*" multiple onchange="previewCustPhotos(this)">
                        <input type="text" name="photo_caption" class="form-control form-control-sm" placeholder="Keterangan foto (misal: Foto lampu indikator modem)">
                        <div id="custPhotoPreview" class="d-flex flex-wrap gap-2 mt-2"></div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-success fw-bold px-4">
                        <i class="fas fa-paper-plane me-1"></i>Kirim Laporan Gangguan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================== -->
<!-- 6. BAGIAN WIFI (PPPoE: ganti SSID & sandi via GenieACS) / ROUTER (IP STATIK: tautan login router) -->
<!-- ========================================================================== -->
<div id="section-wifi" class="mb-4 d-none">
    <% if (isStaticConnection) { %>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 text-center">
            <div class="rounded-circle bg-info bg-opacity-10 text-info d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                <i class="fas fa-server fa-2x"></i>
            </div>
            <h5 class="fw-bold mb-1">Pengaturan Router Anda</h5>
            <p class="text-muted small mb-3">
                Layanan Anda menggunakan <strong>IP Statis</strong>. Pengaturan perangkat (termasuk WiFi) dilakukan langsung melalui halaman login router Anda.
            </p>
            <% if (routerUrl) { %>
                <a href="<%= routerUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-info text-white fw-bold px-4 py-2 shadow-sm">
                    <i class="fas fa-external-link-alt me-2"></i>Buka Halaman Login Router
                </a>
                <div class="mt-3">
                    <span class="badge bg-light text-dark border px-3 py-2 font-monospace"><%= routerUrl.replace('http://', '') %></span>
                </div>
                <div class="small text-muted mt-3">
                    <i class="fas fa-info-circle me-1"></i>Pastikan perangkat Anda sedang terhubung ke jaringan internet/WiFi Anda agar halaman router dapat dibuka.
                </div>
            <% } else { %>
                <div class="alert alert-warning d-inline-block mb-0">
                    <i class="fas fa-exclamation-triangle me-1"></i>Alamat IP gateway router Anda belum diatur. Silakan hubungi admin.
                </div>
            <% } %>
        </div>
    </div>
    <% } else { %>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold mb-1"><i class="fas fa-wifi text-primary me-2"></i>Pengaturan WiFi</h5>
            <p class="text-muted small mb-0">Ganti nama WiFi (SSID) dan sandi WiFi Anda sendiri kapan saja.</p>
        </div>
        <div class="card-body px-4 pb-4">
            <div id="wifiLoading" class="text-center py-4 text-muted">
                <div class="spinner-border spinner-border-sm me-2"></div>Memuat informasi perangkat WiFi Anda...
            </div>
            <div id="wifiError" class="alert alert-warning d-none mb-0"></div>

            <div id="wifiPanel" class="d-none">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge px-3 py-2" id="wifiOnlineBadge"></span>
                    <span class="badge bg-light text-dark border px-3 py-2" id="wifiDevicesBadge"></span>
                    <span class="badge bg-light text-muted border px-3 py-2" id="wifiLastInform"></span>
                </div>

                <div class="row g-2 mb-3" id="wifiBandList"></div>

                <form id="wifiForm" autocomplete="off">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Band WiFi</label>
                            <select class="form-select" id="wifiBand"></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Nama WiFi Baru (SSID)</label>
                            <input type="text" class="form-control" id="wifiSsid" maxlength="32" placeholder="Kosongkan jika tidak diganti">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Sandi WiFi Baru</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="wifiPassword" minlength="8" maxlength="63" placeholder="Min. 8 karakter, kosongkan jika tidak diganti" autocomplete="new-password">
                                <button type="button" class="btn btn-outline-secondary" id="wifiTogglePass" tabindex="-1"><i class="fas fa-eye"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info small mt-3 mb-3">
                        <i class="fas fa-info-circle me-1"></i>Setelah disimpan, WiFi akan terputus sesaat. Hubungkan ulang perangkat Anda menggunakan nama/sandi yang baru.
                    </div>
                    <button type="submit" class="btn btn-primary fw-bold px-4" id="wifiSubmit">
                        <i class="fas fa-save me-2"></i><span>Simpan Pengaturan WiFi</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
    <% } %>
</div>

<script>
    function showPortalSection(section) {
        const billingEl = document.getElementById('section-billing');
        const ticketsEl = document.getElementById('section-tickets');
        const wifiEl = document.getElementById('section-wifi');
        const btnAll = document.getElementById('btnShowAll');
        const btnBilling = document.getElementById('btnShowBilling');
        const btnTickets = document.getElementById('btnShowTickets');
        const btnWifi = document.getElementById('btnShowWifi');

        [btnAll, btnBilling, btnTickets, btnWifi].forEach(b => b && b.classList.remove('active'));
        if (wifiEl) wifiEl.classList.add('d-none');

        if (section === 'billing') {
            if (billingEl) billingEl.classList.remove('d-none');
            if (ticketsEl) ticketsEl.classList.add('d-none');
            if (btnBilling) btnBilling.classList.add('active');
        } else if (section === 'tickets') {
            if (billingEl) billingEl.classList.add('d-none');
            if (ticketsEl) ticketsEl.classList.remove('d-none');
            if (btnTickets) btnTickets.classList.add('active');
        } else if (section === 'wifi') {
            if (billingEl) billingEl.classList.add('d-none');
            if (ticketsEl) ticketsEl.classList.add('d-none');
            if (wifiEl) wifiEl.classList.remove('d-none');
            if (btnWifi) btnWifi.classList.add('active');
            if (typeof loadWifiStatus === 'function') loadWifiStatus();
        } else {
            if (billingEl) billingEl.classList.remove('d-none');
            if (ticketsEl) ticketsEl.classList.remove('d-none');
            if (btnAll) btnAll.classList.add('active');
        }
    }

    // Buka bagian sesuai hash URL (mis. /portal#section-wifi dari sidebar)
    document.addEventListener('DOMContentLoaded', function () {
        const h = (location.hash || '').replace('#section-', '');
        if (['billing', 'tickets', 'wifi'].includes(h)) showPortalSection(h);
    });

    <% if (!isStaticConnection) { %>
    // ===== WiFi Self-Service (PPPoE + GenieACS) =====
    let wifiLoaded = false;
    async function loadWifiStatus(force) {
        if (wifiLoaded && !force) return;
        const loading = document.getElementById('wifiLoading');
        const errBox = document.getElementById('wifiError');
        const panel = document.getElementById('wifiPanel');
        loading.classList.remove('d-none'); errBox.classList.add('d-none'); panel.classList.add('d-none');
        try {
            const res = await fetch('/portal/wifi/status', { headers: { 'Accept': 'application/json' } });
            const data = await res.json();
            loading.classList.add('d-none');
            if (!data.success) { errBox.textContent = data.message || 'Gagal memuat data WiFi.'; errBox.classList.remove('d-none'); return; }
            if (!data.found) { errBox.textContent = data.message || 'Perangkat WiFi belum terdeteksi.'; errBox.classList.remove('d-none'); wifiLoaded = true; return; }

            const ob = document.getElementById('wifiOnlineBadge');
            ob.className = 'badge px-3 py-2 ' + (data.online ? 'bg-success' : 'bg-danger');
            ob.innerHTML = '<i class="fas fa-circle me-1" style="font-size:.5rem"></i>' + (data.online ? 'Perangkat Online' : 'Perangkat Offline');
            document.getElementById('wifiDevicesBadge').innerHTML = '<i class="fas fa-mobile-alt me-1"></i>' + (data.activeDevices || 0) + ' perangkat terhubung';
            document.getElementById('wifiLastInform').textContent = data.lastInform ? 'Terakhir terlihat: ' + data.lastInform : '';

            const list = document.getElementById('wifiBandList');
            const sel = document.getElementById('wifiBand');
            list.innerHTML = ''; sel.innerHTML = '';
            (data.bands || []).forEach(function (b) {
                const col = document.createElement('div'); col.className = 'col-sm-6';
                const box = document.createElement('div'); box.className = 'border rounded-3 p-3 bg-light';
                const t = document.createElement('div'); t.className = 'small text-muted'; t.textContent = 'WiFi ' + b.band;
                const n = document.createElement('div'); n.className = 'fw-bold'; n.textContent = b.ssid;
                box.appendChild(t); box.appendChild(n); col.appendChild(box); list.appendChild(col);
                const o = document.createElement('option'); o.value = b.index; o.textContent = b.band + ' - ' + b.ssid; sel.appendChild(o);
            });
            if ((data.bands || []).length > 1) {
                const all = document.createElement('option'); all.value = 'all'; all.textContent = 'Semua band'; sel.insertBefore(all, sel.firstChild); sel.value = 'all';
            }
            panel.classList.remove('d-none');
            wifiLoaded = true;
        } catch (e) {
            loading.classList.add('d-none');
            errBox.textContent = 'Gagal memuat data WiFi. Periksa koneksi lalu coba lagi.';
            errBox.classList.remove('d-none');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('wifiForm');
        if (!form) return;
        document.getElementById('wifiTogglePass').addEventListener('click', function () {
            const inp = document.getElementById('wifiPassword');
            inp.type = inp.type === 'password' ? 'text' : 'password';
        });
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const ssid = document.getElementById('wifiSsid').value.trim();
            const password = document.getElementById('wifiPassword').value;
            if (!ssid && !password) { Swal.fire({ icon: 'warning', title: 'Perhatian', text: 'Isi nama WiFi baru dan/atau sandi WiFi baru.' }); return; }
            if (password && password.length < 8) { Swal.fire({ icon: 'warning', title: 'Perhatian', text: 'Sandi WiFi minimal 8 karakter.' }); return; }

            const confirm = await Swal.fire({
                icon: 'question', title: 'Simpan pengaturan WiFi?',
                text: 'WiFi akan terputus sesaat dan Anda perlu menghubungkan ulang perangkat.',
                showCancelButton: true, confirmButtonText: 'Ya, Simpan', cancelButtonText: 'Batal'
            });
            if (!confirm.isConfirmed) return;

            const btn = document.getElementById('wifiSubmit');
            btn.disabled = true;
            try {
                const res = await fetch('/portal/wifi/update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ band: document.getElementById('wifiBand').value, ssid: ssid, password: password })
                });
                const data = await res.json();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Berhasil', text: data.message });
                    document.getElementById('wifiPassword').value = '';
                    document.getElementById('wifiSsid').value = '';
                    setTimeout(function () { loadWifiStatus(true); }, 8000);
                } else {
                    Swal.fire({ icon: 'error', title: 'Gagal', text: data.message || 'Gagal menyimpan pengaturan WiFi.' });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Gagal', text: 'Terjadi kesalahan jaringan. Coba lagi.' });
            } finally {
                btn.disabled = false;
            }
        });
    });
    <% } %>

    function previewCustPhotos(input) {
        const box = document.getElementById('custPhotoPreview');
        if (!box) return;
        box.innerHTML = '';
        if (!input.files) return;
        Array.from(input.files).forEach(file => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.className = 'rounded border shadow-xs';
                img.style.width = '64px';
                img.style.height = '64px';
                img.style.objectFit = 'cover';
                box.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    }
</script>

