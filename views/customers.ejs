<%- include('partials/header', { title: 'Pelanggan', activePage: 'customers' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Pelanggan</h4>
        <p class="text-muted mb-0">Kelola data pelanggan ISP</p>
    </div>
    <a href="/customers/create" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus me-2"></i>Tambah Pelanggan
    </a>
</div>

<!-- Filter Row -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        <form method="GET" action="/customers" id="customerFilterForm">
            <div class="row g-2 align-items-end">
                <!-- Filter Nama Paket -->
                <div class="col-xl-3 col-md-6 col-sm-6">
                    <label class="form-label small fw-semibold text-muted mb-1">
                        <i class="fas fa-box text-warning me-1"></i>Nama Paket
                    </label>
                    <select class="form-select form-select-sm" name="package_id" id="filterPackage">
                        <option value="">Semua Paket</option>
                        <% if (typeof packages !== 'undefined' && packages.length > 0) { %>
                            <% packages.forEach(pkg => { %>
                                <option value="<%= pkg.id %>" <%= (typeof filters !== 'undefined' && filters.package_id == pkg.id) ? 'selected' : '' %>>
                                    <%= pkg.name %>
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>

                <!-- Filter Server MikroTik -->
                <div class="col-xl-2 col-md-6 col-sm-6">
                    <label class="form-label small fw-semibold text-muted mb-1">
                        <i class="fas fa-server text-secondary me-1"></i>Server MikroTik
                    </label>
                    <select class="form-select form-select-sm" name="router_id" id="filterRouter">
                        <option value="">Semua Router</option>
                        <% if (typeof routers !== 'undefined' && routers.length > 0) { %>
                            <% routers.forEach(router => { %>
                                <option value="<%= router.id %>" <%= (typeof filters !== 'undefined' && filters.router_id == router.id) ? 'selected' : '' %>>
                                    <%= router.name %>
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>

                <!-- Filter Alamat -->
                <div class="col-xl-3 col-md-6 col-sm-6">
                    <label class="form-label small fw-semibold text-muted mb-1">
                        <i class="fas fa-map-marker-alt text-danger me-1"></i>Alamat
                    </label>
                    <input type="text" class="form-control form-control-sm" name="address" id="filterAddress" 
                           placeholder="Cari jalan / desa / RT / Kp..." value="<%= (typeof filters !== 'undefined' && filters.address) ? filters.address : '' %>">
                </div>

                <!-- Filter By IP Address -->
                <div class="col-xl-2 col-md-6 col-sm-6">
                    <label class="form-label small fw-semibold text-muted mb-1">
                        <i class="fas fa-network-wired text-success me-1"></i>By IP Address
                    </label>
                    <input type="text" class="form-control form-control-sm font-monospace" name="ip" id="filterIp" 
                           placeholder="Contoh: 172.16... / 10..." value="<%= (typeof filters !== 'undefined' && filters.ip) ? filters.ip : '' %>">
                </div>

                <!-- Tombol Aksi -->
                <div class="col-xl-2 col-md-12 col-sm-12 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1 fw-semibold">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                    <a href="/customers" class="btn btn-sm btn-outline-secondary" title="Reset Semua Filter">
                        <i class="fas fa-undo me-1"></i>Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<% 
const hasCustFilter = (typeof filters !== 'undefined') && (filters.package_id || filters.router_id || filters.address || filters.ip);
%>
<% if (hasCustFilter) { %>
    <div class="d-flex align-items-center justify-content-between p-2 mb-3 bg-light rounded border">
        <div class="small text-muted">
            <i class="fas fa-filter text-primary me-1"></i>
            Menampilkan hasil filter: <strong><%= customers ? customers.length : 0 %></strong> pelanggan ditemukan.
        </div>
        <a href="/customers" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-semibold" style="font-size: 0.8rem;">
            <i class="fas fa-times me-1"></i>Bersihkan Filter
        </a>
    </div>
<% } %>

<div class="card shadow-sm border-0">
    <div class="card-body p-3 p-md-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle datatable w-100 mb-0" id="customersTable" style="width: 100%;">
                <thead class="table-light">
                    <tr>
                        <th class="text-center text-nowrap" style="width: 45px;">No</th>
                        <th class="text-nowrap" style="width: 120px;">ID Pelanggan</th>
                        <th class="text-nowrap" style="min-width: 200px;">Nama & Alamat</th>
                        <th class="text-nowrap" style="width: 130px;">Telepon</th>
                        <th class="text-nowrap" style="min-width: 220px;">Paket & Layanan</th>
                        <th class="text-nowrap" style="min-width: 160px;">Tagihan Lainnya</th>
                        <th class="text-center text-nowrap" style="width: 100px;">Status</th>
                        <th class="text-center text-nowrap" style="width: 170px; min-width: 170px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (customers && customers.length > 0) { %>
                        <% customers.forEach(function(customer, index) { %>
                        <tr>
                            <td class="text-center text-muted fw-bold"><%= index + 1 %></td>
                            <td class="text-nowrap">
                                <span class="fw-bold font-monospace text-primary"><%= customer.customer_id %></span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle me-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="fw-bold text-dark text-truncate lh-sm mb-1" style="max-width: 220px;" title="<%= customer.name %>"><%= customer.name %></div>
                                        <div class="small text-muted text-truncate" style="max-width: 220px; font-size: 0.75rem;" title="<%= customer.address || '-' %>">
                                            <i class="fas fa-map-marker-alt text-danger me-1"></i><%= customer.address || '-' %>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-nowrap">
                                <% if (customer.phone) { %>
                                    <a href="https://wa.me/<%= customer.phone.replace(/^0/, '62') %>" target="_blank" class="text-decoration-none text-dark fw-semibold small d-inline-flex align-items-center" title="Kirim Pesan WhatsApp" data-bs-toggle="tooltip">
                                        <i class="fab fa-whatsapp text-success me-1"></i><span><%= customer.phone %></span>
                                    </a>
                                <% } else { %>
                                    <span class="text-muted small">-</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <% if (customer.package_name) { %>
                                            <span class="badge bg-light text-dark border px-2 py-1"><i class="fas fa-box me-1 text-primary"></i><%= customer.package_name %></span>
                                            <% if (customer.is_bypass === 1) { %>
                                                <span class="badge bg-dark text-warning border border-warning px-2 py-1" style="font-size: 0.70rem;" title="Bypass Isolir Aktif" data-bs-toggle="tooltip"><i class="fas fa-shield-halved me-1"></i>Bypass</span>
                                            <% } %>
                                            <% if (customer.no_wa_billing === 1 || /exiting|existing|pararel|paralel/i.test(customer.package_name || '')) { %>
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info px-2 py-1" style="font-size: 0.70rem;" title="Bisa Terisolir, Tanpa Informasi Tagihan WhatsApp" data-bs-toggle="tooltip">
                                                    <i class="fas fa-bell-slash me-1"></i>Paralel
                                                </span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-muted small">-</span>
                                        <% } %>
                                    </div>
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <% if (customer.connection_type === 'static') { %>
                                            <span class="badge bg-info bg-opacity-10 text-dark border border-info px-2 py-1" style="font-size: 0.72rem;"><i class="fas fa-network-wired me-1 text-info"></i>Static: <%= customer.ip_address || 'No IP' %></span>
                                        <% } else { %>
                                            <span class="badge bg-secondary bg-opacity-10 text-dark border px-2 py-1" style="font-size: 0.72rem;"><i class="fas fa-lock me-1 text-secondary"></i>PPPoE: <%= customer.pppoe_username || '-' %></span>
                                            <% if (customer.ip_address) { %>
                                                <span class="badge bg-light text-dark border font-monospace px-2 py-1" style="font-size: 0.70rem;" title="IP Pelanggan" data-bs-toggle="tooltip"><i class="fas fa-network-wired me-1 text-info"></i><%= customer.ip_address %></span>
                                            <% } %>
                                        <% } %>
                                        <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.70rem;" title="Router MikroTik" data-bs-toggle="tooltip">
                                            <i class="fas fa-server me-1 text-primary"></i><%= customer.router_name || 'MikroTik Utama' %>
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <% const addBill = parseFloat(customer.additional_bill) || 0; %>
                                <% if (addBill !== 0) { %>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                            <% if (addBill > 0) { %>
                                                <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning fw-bold px-2 py-1" style="font-size: 0.78rem;">
                                                    <i class="fas fa-plus-circle text-warning me-1"></i>+Rp <%= Number(addBill).toLocaleString('id-ID') %>
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger fw-bold px-2 py-1" style="font-size: 0.78rem;">
                                                    <i class="fas fa-minus-circle me-1"></i>-Rp <%= Number(Math.abs(addBill)).toLocaleString('id-ID') %>
                                                </span>
                                            <% } %>
                                            <% if (customer.auto_reset_additional_bill === 0) { %>
                                                <span class="badge bg-secondary bg-opacity-10 text-dark border px-2 py-1" style="font-size: 0.68rem;" title="Tagihan Berulang (Tidak otomatis kosong saat lunas)" data-bs-toggle="tooltip">
                                                    <i class="fas fa-repeat me-1 text-primary"></i>Tetap
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-light text-muted border px-2 py-1" style="font-size: 0.68rem;" title="Sekali Bayar: Otomatis kosong (Rp 0) saat tagihan dilunasi" data-bs-toggle="tooltip">
                                                    <i class="fas fa-magic me-1 text-warning"></i>1x
                                                </span>
                                            <% } %>
                                            <button type="button" class="btn btn-sm btn-light border px-2 py-1 text-primary btn-edit-add-bill" 
                                                    data-id="<%= customer.id %>"
                                                    data-name="<%= customer.name %>"
                                                    data-bill="<%= addBill %>"
                                                    data-desc="<%= customer.additional_bill_desc || '' %>"
                                                    data-autoreset="<%= customer.auto_reset_additional_bill !== 0 ? 1 : 0 %>"
                                                    title="Ubah Tagihan Lainnya"
                                                    data-bs-toggle="tooltip">
                                                <i class="fas fa-pen fa-xs"></i>
                                            </button>
                                        </div>
                                        <% if (customer.additional_bill_desc) { %>
                                            <div class="small text-muted text-truncate" style="max-width: 170px; font-size: 0.72rem;" title="<%= customer.additional_bill_desc %>" data-bs-toggle="tooltip">
                                                <i class="fas fa-info-circle me-1 text-info"></i><%= customer.additional_bill_desc %>
                                            </div>
                                        <% } else { %>
                                            <div class="small text-muted" style="font-size: 0.72rem;">Tagihan Lainnya</div>
                                        <% } %>
                                    </div>
                                <% } else { %>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 btn-edit-add-bill" style="font-size: 0.75rem;"
                                            data-id="<%= customer.id %>"
                                            data-name="<%= customer.name %>"
                                            data-bill="0"
                                            data-desc=""
                                            data-autoreset="<%= customer.auto_reset_additional_bill !== 0 ? 1 : 0 %>"
                                            title="Atur penambahan atau pengurangan tagihan"
                                            data-bs-toggle="tooltip">
                                        <i class="fas fa-plus me-1"></i>Atur
                                    </button>
                                <% } %>
                            </td>
                            <td class="text-center text-nowrap">
                                <% if (customer.status === 'active') { %>
                                    <span class="badge bg-success px-2 py-1"><i class="fas fa-check-circle me-1"></i>Aktif</span>
                                <% } else if (customer.status === 'suspended') { %>
                                    <span class="badge badge-blinking-danger px-2 py-1" title="Status diisolir" data-bs-toggle="tooltip"><i class="fas fa-ban me-1"></i>Suspend</span>
                                <% } else { %>
                                    <span class="badge bg-secondary px-2 py-1"><i class="fas fa-times-circle me-1"></i>Terminasi</span>
                                <% } %>
                            </td>
                            <td class="text-center text-nowrap" style="width: 170px; min-width: 170px;">
                                <div class="d-inline-flex justify-content-center align-items-center gap-1 flex-nowrap">
                                    <a href="/customers/<%= customer.id %>/edit" class="btn btn-sm btn-outline-primary px-2 py-1" title="Edit Data Pelanggan" data-bs-toggle="tooltip">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <% if (customer.phone) { %>
                                        <form action="/customers/<%= customer.id %>/send-welcome" method="POST" class="d-inline-flex m-0 align-items-center form-send-welcome">
                                            <button type="button" class="btn btn-sm btn-outline-success px-2 py-1 btn-send-welcome"
                                                    title="Kirim WhatsApp Selamat Bergabung"
                                                    data-name="<%= customer.name %>"
                                                    data-phone="<%= customer.phone %>"
                                                    data-bs-toggle="tooltip">
                                                <i class="fab fa-whatsapp"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                    <% if (customer.status === 'suspended') { %>
                                        <form action="/customers/<%= customer.id %>/activate" method="POST" class="d-inline-flex m-0 align-items-center form-activate">
                                            <button type="button" class="btn btn-sm btn-outline-success px-2 py-1 btn-activate" title="Buka Isolir (Aktifkan Akses)" data-name="<%= customer.name %>" data-bs-toggle="tooltip">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                    <% } else if (customer.status === 'active') { %>
                                        <form action="/customers/<%= customer.id %>/suspend" method="POST" class="d-inline-flex m-0 align-items-center form-suspend">
                                            <button type="button" class="btn btn-sm btn-outline-warning px-2 py-1 btn-suspend" title="Isolir Pelanggan" data-name="<%= customer.name %>" data-bs-toggle="tooltip">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                    <form action="/customers/<%= customer.id %>/delete" method="POST" class="d-inline-flex m-0 align-items-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1 btn-delete" title="Hapus Pelanggan" data-bs-toggle="tooltip">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Atur Tagihan Tambahan / Tagihan Lainnya -->
<div class="modal fade" id="modalAdditionalBill" tabindex="-1" aria-labelledby="modalAdditionalBillLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form id="formAdditionalBill" method="POST" action="">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold" id="modalAdditionalBillLabel">
                        <i class="fas fa-file-invoice-dollar text-warning me-2"></i>Tagihan Tambahan / Lainnya
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 px-3 small mb-3">
                        <i class="fas fa-info-circle me-1"></i>
                        Pelanggan: <strong id="modalAddBillCustomerName">-</strong>
                    </div>

                    <div class="mb-3">
                        <label for="inputAdditionalBill" class="form-label fw-semibold">Nominal Tambahan (+) / Potongan (-)</label>
                        <div class="input-group">
                            <span class="input-group-text">Rp</span>
                            <input type="number" step="1000" class="form-control" id="inputAdditionalBill" name="additional_bill" required placeholder="0 (misal: 50000 atau -20000)">
                        </div>
                        <div class="form-text small">
                            Isi angka positif (misal: <code>50000</code>) untuk biaya tambahan, atau negatif (misal: <code>-20000</code>) untuk diskon/potongan tagihan. Isi <code>0</code> untuk mengosongkan.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="inputAdditionalBillDesc" class="form-label fw-semibold">Keterangan / Alasan</label>
                        <input type="text" class="form-control" id="inputAdditionalBillDesc" name="additional_bill_desc" placeholder="Contoh: Kabel LAN 15 meter, Ganti adaptor, Kompensasi gangguan, dll">
                        <div class="form-text small">Keterangan akan otomatis tercatat pada rincian tagihan invoice pelanggan.</div>
                    </div>

                    <!-- Fitur Enable / Disable Kosongkan Otomatis Saat Lunas -->
                    <div class="mb-3 p-3 bg-light rounded border">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" role="switch" id="inputAutoResetAdditionalBill" name="auto_reset_additional_bill" value="1" checked>
                            <label class="form-check-label fw-bold text-dark" for="inputAutoResetAdditionalBill">
                                <i class="fas fa-undo-alt text-primary me-1"></i>Kosongkan otomatis saat tagihan dilunasi
                            </label>
                        </div>
                        <div id="autoResetHelpText" class="small text-muted" style="font-size: 0.75rem;">
                            <span class="text-success" id="autoResetActiveDesc">
                                <i class="fas fa-check-circle me-1"></i><strong>Aktif (Sekali Bayar):</strong> Kolom ini otomatis akan kembali <strong>kosong (Rp 0)</strong> disaat tagihan dilunasi berbarengan dengan tagihan internet.
                            </span>
                            <span class="text-warning-emphasis d-none" id="autoResetInactiveDesc">
                                <i class="fas fa-clock-rotate-left me-1"></i><strong>Nonaktif (Berulang Tiap Bulan):</strong> Tagihan/potongan ini akan <strong>tetap tersimpan</strong> dan tidak dikosongkan saat tagihan dilunasi.
                            </span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light py-2">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="fas fa-save me-1"></i>Simpan Perubahan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    $(document).on('click', '.btn-suspend', function(e) {
        e.preventDefault();
        const form = $(this).closest('form')[0];
        const name = $(this).data('name') || 'pelanggan ini';
        Swal.fire({
            title: 'Isolir Pelanggan?',
            text: `Apakah Anda yakin ingin mengisolir ${name}? Akses internet akan diblokir dan IP dimasukkan ke address-list MikroTik (Expired).`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e0a800',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fas fa-ban me-1"></i> Ya, Isolir Sekarang!',
            cancelButtonText: 'Batal'
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
    });

    $(document).on('click', '.btn-activate', function(e) {
        e.preventDefault();
        const form = $(this).closest('form')[0];
        const name = $(this).data('name') || 'pelanggan ini';
        Swal.fire({
            title: 'Buka Isolir Pelanggan?',
            text: `Aktifkan kembali akses internet untuk ${name}? IP akan dihapus dari address-list MikroTik (Expired).`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fas fa-check me-1"></i> Ya, Buka Isolir!',
            cancelButtonText: 'Batal'
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
    });

    // Delegated click handler untuk tombol Atur Tagihan Lainnya di tabel DataTables
    const modalAddBillEl = document.getElementById('modalAdditionalBill');
    const formAddBill = document.getElementById('formAdditionalBill');
    const custNameEl = document.getElementById('modalAddBillCustomerName');
    const billInput = document.getElementById('inputAdditionalBill');
    const descInput = document.getElementById('inputAdditionalBillDesc');
    const autoResetInput = document.getElementById('inputAutoResetAdditionalBill');
    const autoResetActiveDesc = document.getElementById('autoResetActiveDesc');
    const autoResetInactiveDesc = document.getElementById('autoResetInactiveDesc');

    function updateAutoResetUi(isChecked) {
        if (autoResetActiveDesc && autoResetInactiveDesc) {
            if (isChecked) {
                autoResetActiveDesc.classList.remove('d-none');
                autoResetInactiveDesc.classList.add('d-none');
            } else {
                autoResetActiveDesc.classList.add('d-none');
                autoResetInactiveDesc.classList.remove('d-none');
            }
        }
    }

    if (autoResetInput) {
        autoResetInput.addEventListener('change', function() {
            updateAutoResetUi(this.checked);
        });
    }

    $(document).on('click', '.btn-edit-add-bill', function(e) {
        e.preventDefault();
        const id = $(this).data('id');
        const name = $(this).data('name') || '-';
        const bill = $(this).data('bill') !== undefined ? $(this).data('bill') : '0';
        const desc = $(this).data('desc') || '';
        const autoreset = $(this).data('autoreset') !== undefined ? $(this).data('autoreset') : 1;

        formAddBill.action = '/customers/' + id + '/additional-bill';
        custNameEl.textContent = name;
        billInput.value = bill;
        descInput.value = desc;

        if (autoResetInput) {
            autoResetInput.checked = (autoreset == 1);
            updateAutoResetUi(autoreset == 1);
        }

        if (modalAddBillEl && typeof bootstrap !== 'undefined') {
            const modal = bootstrap.Modal.getOrCreateInstance(modalAddBillEl);
            modal.show();
        }
    });

    // Konfirmasi Kirim WhatsApp Selamat Bergabung
    $(document).on('click', '.btn-send-welcome', function(e) {
        e.preventDefault();
        const form = $(this).closest('form');
        const name = $(this).data('name') || 'Pelanggan';
        const phone = $(this).data('phone') || '';

        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Kirim WhatsApp Sambutan?',
                html: `Kirim pesan selamat bergabung ke nomor WhatsApp <strong>${phone}</strong> milik <strong>${name}</strong>?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fab fa-whatsapp me-1"></i>Ya, Kirim Sekarang',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) form.submit();
            });
        } else if (confirm(`Kirim WhatsApp Selamat Bergabung ke ${name} (${phone})?`)) {
            form.submit();
        }
    });

    // Inisialisasi Tooltip Bootstrap pada tabel Pelanggan
    function initCustomerTooltips() {
        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
            const list = document.querySelectorAll('#customersTable [data-bs-toggle="tooltip"]');
            list.forEach(function(el) {
                if (!bootstrap.Tooltip.getInstance(el)) {
                    new bootstrap.Tooltip(el);
                }
            });
        }
    }
    initCustomerTooltips();
    if (window.jQuery) {
        $(document).on('draw.dt', '#customersTable', function() {
            initCustomerTooltips();
        });
    }
});
</script>

